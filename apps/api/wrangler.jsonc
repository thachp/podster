{
  // Private API: reached only by service binding, with no public route or workers.dev URL.
  "name": "podster-api",
  "main": "build/index.js",
  // Rebuild on deploy, so a test build with failpoints can never ship.
  "build": { "command": "worker-build --release" },
  "compatibility_date": "2026-08-01",
  // Wake URLs come from agents, so outbound fetches must never reach this account's own zones.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [
    { "name": "WORKSPACE", "class_name": "Workspace" },
    { "name": "PRINCIPAL", "class_name": "Principal" },
    // Reports and operator actions (M4 step 10), in one object so the daily report limit is exact.
    { "name": "MODERATION", "class_name": "Moderation" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace", "Principal"] }, { "tag": "v2", "new_sqlite_classes": ["Moderation"] }],
  // The real database ID is set when staging is created. Only the listing read model lives here.
  "d1_databases": [{ "binding": "DB", "database_name": "podster-api", "database_id": "local-only", "migrations_dir": "migrations" }]
  // ASSERTION_KEYS is a secret: a JSON object of kid to base64url Ed25519 public key. SCANNER_SECRET is the same value as the scanner
  // Worker's, and without it no verdict is accepted. A2A_TOKEN_KEY is 64 hex characters that seal agents' A2A endpoint tokens; the
  // owner sets it (decision 122, docs/staging.md), and without it endpoints can be set but tokens can't.
  // Private, with no public access or S3 keys. Every byte goes through the API.
  ,"r2_buckets": [{ "binding": "ASSETS", "bucket_name": "podster-assets" }]
  // The application's address, for the link in an A2A offer, and the gateway's, for its input files. Only links: opening
  // either needs the agent's own sign-in or credential.
  // OPERATORS, the person IDs of Podster operators separated by commas (decision 158), is set nowhere here: naming
  // operators is the owner's call (M4 plan). Without it nobody is an operator.
  ,"vars": { "APP_URL": "http://app.localhost:3000", "GATEWAY_URL": "http://localhost:8787" }
  // A2A offers (M3 step 12, decision 129) have their own queue, apart from wake's. It holds IDs only. A job whose retries run
  // out goes to the dead-letter queue, whose consumer logs its IDs and acknowledges it.
  ,"queues": {
    "producers": [{ "binding": "WAKE", "queue": "podster-wake" }, { "binding": "SCAN", "queue": "podster-scan" }, { "binding": "A2A", "queue": "podster-a2a" }],
    "consumers": [
      { "queue": "podster-wake", "max_batch_size": 6, "max_batch_timeout": 5, "max_retries": 5 },
      { "queue": "podster-a2a", "max_batch_size": 6, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "podster-a2a-dlq" },
      { "queue": "podster-a2a-dlq", "max_batch_size": 6, "max_batch_timeout": 5 }
    ]
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "podster-assets-staging" }],
      "vars": { "APP_URL": "https://app-staging.podster.dev", "GATEWAY_URL": "https://gateway-staging.podster.dev" },
      "queues": {
        "producers": [{ "binding": "WAKE", "queue": "podster-wake-staging" }, { "binding": "SCAN", "queue": "podster-scan-staging" }, { "binding": "A2A", "queue": "podster-a2a-staging" }],
        "consumers": [
          { "queue": "podster-wake-staging", "max_batch_size": 6, "max_batch_timeout": 5, "max_retries": 5 },
          { "queue": "podster-a2a-staging", "max_batch_size": 6, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "podster-a2a-dlq-staging" },
          { "queue": "podster-a2a-dlq-staging", "max_batch_size": 6, "max_batch_timeout": 5 }
        ]
      },
      "durable_objects": { "bindings": [
        { "name": "WORKSPACE", "class_name": "Workspace" },
        { "name": "PRINCIPAL", "class_name": "Principal" },
        { "name": "MODERATION", "class_name": "Moderation" }
      ] },
      "d1_databases": [{ "binding": "DB", "database_name": "podster-api-staging", "database_id": "31b8cc7a-1e7a-424d-8689-f95f96f0a487", "migrations_dir": "migrations" }]
    }
  }
}
