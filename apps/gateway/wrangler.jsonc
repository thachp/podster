{
  // The only public entry. It authenticates and translates; the Rust API decides.
  "name": "podster-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "services": [{ "binding": "API", "service": "podster-api" }],
  // Real IDs are set when staging is created. Secrets: AUTH_SECRET, ASSERTION_SIGNING_JWK, and GITHUB_* or GOOGLE_* for sign-in.
  // GITHUB_WEBHOOK_SECRET is optional and unset everywhere: without it POST /webhooks/github refuses everything (M5 step 5).
  "d1_databases": [{ "binding": "DB", "database_name": "podster-gateway", "database_id": "local-only", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-only" }],
  "vars": { "BASE_URL": "https://gateway.podster.dev" },
  "durable_objects": { "bindings": [{ "name": "STRICT_COUNTER", "class_name": "StrictCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StrictCounter"] }],
  // Clears abandoned registrations and expired sign-in state.
  "triggers": { "crons": ["17 * * * *"] },
  // Per minute: anything per client, per credential or person, and sensitive actions. Bindings aren't inherited by environments.
  "ratelimits": [
    { "name": "RL_GENERAL", "namespace_id": "73101", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_ACCOUNT", "namespace_id": "73102", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SENSITIVE", "namespace_id": "73103", "simple": { "limit": 20, "period": 60 } }
  ],
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "gateway-staging.podster.dev", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "podster-api-staging" }],
      // Secrets: AUTH_SECRET, ASSERTION_SIGNING_JWK, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, E2E_SIGNUP_SECRET.
      "d1_databases": [{ "binding": "DB", "database_name": "podster-gateway-staging", "database_id": "055c6e16-853c-4dae-8a32-693b2d1f50c2", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "57637530b0404f209d89b9ab00b5ef0c" }],
      "vars": { "BASE_URL": "https://gateway-staging.podster.dev", "APP_URL": "https://app-staging.podster.dev", "ENABLE_E2E_SIGNUP": "true", "ENABLE_EMAIL_SIGNIN": "true", "EMAIL_FROM": "sign-in@podster.dev" },
      // Sign-in links. This binding can only send from that one address.
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["sign-in@podster.dev"] }],
      "durable_objects": { "bindings": [{ "name": "STRICT_COUNTER", "class_name": "StrictCounter" }] },
      "triggers": { "crons": ["17 * * * *"] },
      "ratelimits": [
        { "name": "RL_GENERAL", "namespace_id": "73201", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_ACCOUNT", "namespace_id": "73202", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SENSITIVE", "namespace_id": "73203", "simple": { "limit": 20, "period": 60 } }
      ]
    }
  }
}
