#!/bin/sh
# Runner's Git credential helper (M7 step 10). Host Git starts it, through its own credential protocol, only for a
# command Runner runs against GitHub. It answers `get` once, for https://github.com only, with the token it reads from
# file descriptor 3, which Runner opened for that one Git command and closes when it ends. It never reads the token from
# an argument, the environment or a file, never writes it anywhere but Git's own pipe, and answers nothing for anything
# else. Every other action (store, erase) does nothing.
[ "$1" = "get" ] || exit 0
protocol=""
host=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
[ "$protocol" = "https" ] || exit 0
[ "$host" = "github.com" ] || exit 0
IFS= read -r token <&3 2>/dev/null || exit 0
# An installation token's characters only (`isAccessToken` in core/repository.ts): letters, digits, `_`, `.` and `-`, so a
# token can't add a line or a field to Git's credential protocol. At most 4096 of them.
case "$token" in
  *[!A-Za-z0-9._-]* | "") exit 0 ;;
esac
[ "${#token}" -le 4096 ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
