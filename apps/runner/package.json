{
  "name": "podster",
  "version": "0.0.1-test.18",
  "description": "Podster Runner, test pre-release for Podster staging only. Not supported. Not security-reviewed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thachp/podster.git",
    "directory": "apps/runner"
  },
  "type": "module",
  "bin": {
    "podster": "build/node/cli.js"
  },
  "files": [
    "build/",
    "git/credential-helper",
    "sandbox/Dockerfile",
    "claude-image/Dockerfile",
    "proxy-image/Dockerfile",
    "toolchains/dotnet/Dockerfile",
    "toolchains/java/Dockerfile",
    "toolchains/python/Dockerfile",
    "toolchains/rust/Dockerfile",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "test",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node scripts/publish-guard.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.327",
    "@anthropic-ai/sdk": "1.10.0",
    "@auth/agent": "0.6.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/agents-core": "0.22.0",
    "@openai/agents-openai": "0.22.0",
    "openai": "7.62.0",
    "zod": "4.6.7"
  },
  "bundleDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "@anthropic-ai/sdk",
    "@auth/agent",
    "@modelcontextprotocol/sdk",
    "@openai/agents-core",
    "@openai/agents-openai",
    "openai",
    "zod"
  ],
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
