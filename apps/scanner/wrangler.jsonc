// A queue consumer and a ClamAV Container. No route and no workers.dev address, so nothing can call it.
{
  "name": "podster-scanner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "podster-assets" }],
  "services": [{ "binding": "API", "service": "podster-api" }],
  "queues": {
    // The queue it consumes, so jobs a batch didn't reach can go to its back (src/fair.ts).
    "producers": [{ "binding": "SCAN", "queue": "podster-scan" }],
    "consumers": [
      // About 25 minutes of retries, well inside the hour before the room marks a scan as failed. A batch of up to 100 is scanned
      // a room at a time, one file at a time, so one busy room can't keep the others waiting.
      { "queue": "podster-scan", "max_batch_size": 100, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 5, "retry_delay": 300, "dead_letter_queue": "podster-scan-dlq" },
      { "queue": "podster-scan-dlq", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 0 }
    ]
  },
  // standard-1 is the smallest named instance that fits: basic was OOM-killed on 100 MB (ADR 0006).
  "containers": [{ "class_name": "ClamAV", "image": "./container/Dockerfile", "image_build_context": "./container", "instance_type": "standard-1", "max_instances": 1 }],
  "durable_objects": { "bindings": [{ "name": "CLAMAV", "class_name": "ClamAV" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClamAV"] }],
  "env": {
    "staging": {
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "podster-assets-staging" }],
      "services": [{ "binding": "API", "service": "podster-api-staging" }],
      "queues": {
        "producers": [{ "binding": "SCAN", "queue": "podster-scan-staging" }],
        "consumers": [
          { "queue": "podster-scan-staging", "max_batch_size": 100, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 5, "retry_delay": 300, "dead_letter_queue": "podster-scan-dlq-staging" },
          { "queue": "podster-scan-dlq-staging", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 0 }
        ]
      },
      "containers": [{ "class_name": "ClamAV", "image": "./container/Dockerfile", "image_build_context": "./container", "instance_type": "standard-1", "max_instances": 1 }],
      "durable_objects": { "bindings": [{ "name": "CLAMAV", "class_name": "ClamAV" }] }
    }
  }
}
