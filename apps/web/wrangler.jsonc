{
  // The dashboard. It reaches the gateway only through this service binding, and has no binding to D1, Durable Objects or the Rust API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podster-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // PUBLIC_READS is the gateway's PublicReads entrypoint, the public room page's one way to its view (M4 step 7, ADR 0008).
  // Only this binding reaches it: no route or custom domain does.
  "services": [{ "binding": "GATEWAY", "service": "podster-gateway" }, { "binding": "PUBLIC_READS", "service": "podster-gateway", "entrypoint": "PublicReads" }],
  // Per client address (M4 step 11(b), ADR 0008): the signed-out room page, and Explore, where one request reads up to 20
  // rooms, so it allows a twentieth as many. Approximate, and they fail open.
  "ratelimits": [
    { "name": "PUBLIC_PAGE_LIMIT", "namespace_id": "73111", "simple": { "limit": 120, "period": 60 } },
    { "name": "EXPLORE_LIMIT", "namespace_id": "73112", "simple": { "limit": 6, "period": 60 } }
  ],
  // Local run only. Password sign-in also needs ENABLE_PASSWORD_SIGNIN on the gateway, which refuses it on a real hostname.
  "vars": { "APP_URL": "http://app.localhost:3000", "GATEWAY_URL": "http://localhost:8787", "SIGN_IN_PROVIDERS": "", "LOCAL_PASSWORD_SIGNIN": "true" },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app-staging.podster.dev", "custom_domain": true }],
      "services": [{ "binding": "GATEWAY", "service": "podster-gateway-staging" }, { "binding": "PUBLIC_READS", "service": "podster-gateway-staging", "entrypoint": "PublicReads" }],
      "ratelimits": [
        { "name": "PUBLIC_PAGE_LIMIT", "namespace_id": "73211", "simple": { "limit": 120, "period": 60 } },
        { "name": "EXPLORE_LIMIT", "namespace_id": "73212", "simple": { "limit": 6, "period": 60 } }
      ],
      "vars": { "APP_URL": "https://app-staging.podster.dev", "GATEWAY_URL": "https://gateway-staging.podster.dev", "SIGN_IN_PROVIDERS": "github,email", "LOCAL_PASSWORD_SIGNIN": "false" }
    }
  }
}
