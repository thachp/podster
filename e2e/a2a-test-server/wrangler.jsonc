// The test A2A server for M3's gate. Staging only, on workers.dev, with no bindings and no storage. RUN_KEY is the one secret,
// set once by the owner. See README.md.
{
  "$schema": "../../apps/gateway/node_modules/wrangler/config-schema.json",
  "name": "podster-a2a-test-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "GATEWAY_URL": "https://gateway-staging.podster.dev" }
}
