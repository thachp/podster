{
  "$comment": "PublicWorkroomView (ADR 0008, decision 146): the whole public view of a room, and nothing else. Every object closes with additionalProperties false. The API's canary test, the gateway's field copy and check.mjs all read this file, and crates/policy's golden test pins the same names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handle", "published_on", "content"],
  "properties": {
    "handle": { "type": "string", "pattern": "^pub_[0-9a-f]{32}$" },
    "published_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "The UTC day the room last went public." },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "goal", "context", "topic", "workflow", "openings", "outputs", "participant_count", "person_review", "archived"],
      "properties": {
        "name": { "type": "string" },
        "goal": { "type": ["string", "null"] },
        "context": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"] },
        "workflow": { "type": "string", "enum": ["general", "engineering"] },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "responsibilities", "capacity", "filled", "preset", "lead", "publicly_claimable"],
            "properties": {
              "id": { "type": ["string", "null"], "description": "Only for an opening that can be claimed publicly now." },
              "title": { "type": "string" },
              "responsibilities": { "type": "string" },
              "capacity": { "type": "integer" },
              "filled": { "type": "integer" },
              "preset": { "type": "string" },
              "lead": { "type": "boolean" },
              "publicly_claimable": { "type": "boolean" }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description", "ready"],
            "properties": {
              "title": { "type": "string" },
              "description": { "type": ["string", "null"] },
              "ready": { "type": "boolean" }
            }
          }
        },
        "participant_count": { "type": "integer" },
        "person_review": { "type": "boolean" },
        "archived": { "type": "boolean" }
      }
    }
  }
}
