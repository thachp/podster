{
  "about": "What the private API writes into the serve entries' namespace and the content Worker reads from it (M6 step 4, ADR 0010). Read by apps/content's tests, apps/api's tests and crates/core's tests, so the three can't drift apart. No string here holds a quote or a backslash: crates/core reads it without a JSON parser.",
  "stop_key": "_stop",
  "stop_value": "stopped",
  "script_name_pattern": "^[a-z0-9]{1,26}[.]rel_[0-9a-f]{32}$",
  "valid_script_names": [
    "a.rel_00000000000000000000000000000000",
    "k3v9q2.rel_0123456789abcdef0123456789abcdef",
    "abcdefghijklmnopqrstuvwxyz.rel_ffffffffffffffffffffffffffffffff",
    "0.rel_a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
  ],
  "invalid_script_names": [
    "",
    "stopped",
    "_stop",
    "k3v9q2",
    "k3v9q2.rel_0123456789abcdef0123456789abcde",
    "k3v9q2.rel_0123456789abcdef0123456789abcdef0",
    "k3v9q2.rel_0123456789ABCDEF0123456789abcdef",
    "k3v9q2.rel_0123456789abcdeg0123456789abcdef",
    "k3v9q2.rev_0123456789abcdef0123456789abcdef",
    "K3v9q2.rel_0123456789abcdef0123456789abcdef",
    "k3-v9q2.rel_0123456789abcdef0123456789abcdef",
    "k3_v9q2.rel_0123456789abcdef0123456789abcdef",
    "abcdefghijklmnopqrstuvwxyz0.rel_ffffffffffffffffffffffffffffffff",
    ".rel_0123456789abcdef0123456789abcdef",
    "a.b.rel_0123456789abcdef0123456789abcdef",
    "k3v9q2.rel_0123456789abcdef0123456789abcdef.x",
    " k3v9q2.rel_0123456789abcdef0123456789abcdef",
    "k3v9q2.rel_0123456789abcdef0123456789abcdef ",
    "k3v9q2/rel_0123456789abcdef0123456789abcdef",
    "someone-elses-script"
  ]
}
