#!/usr/bin/env bash
# The one way to deploy the content Worker, apps/content, to the second Cloudflare account (M6 step 4(b), ADR 0010,
# decision 217). It never uses apps/content/wrangler.jsonc's account or a wrangler login: the account, the content
# domain and the two namespaces come from the owner's configuration file, and the token from the owner's token file.
# docs/content-deploy.md is the guide.
#
# WHAT IT DEFENDS AGAINST: accidents in the owner's shell. A stray exported function or alias from dotfiles, tracing
# left on, a proxy or a .curlrc, a leftover token variable, the wrong account in the environment. It does NOT defend
# against someone who already controls the owner's account, files or PATH: such a person can replace the programs this
# runs, and no script can stop that.
#
# No shell variable ever holds the token. It is read from its file only where it is handed to a child: into curl's
# stdin, and into the stdin of the small shell that starts wrangler. Finding or redacting it in an output reads it from
# the file too (`grep -f`, awk), so it is in no command's arguments either.

# ---- First, a clean process. ----
# Until the `exec` below, only what a function or an alias can't replace runs. An assignment of POSIXLY_CORRECT puts
# bash in POSIX mode, where special builtins (unset, exec, exit) are found before functions. A backslash keeps a word
# from being read as an alias. Then echo, the one ordinary command used before the exec, loses any function of its name, and
# the script runs again as `/bin/bash` under `/usr/bin/env -i`: no inherited function, alias, BASH_ENV, SHELLOPTS,
# CLOUDFLARE_* or proxy variable. It keeps HOME, TERM, PATH and SSH_AUTH_SOCK, so git, gh and npm work as the owner's.
# What it needs of the caller's environment it carries as results and IDs, never a secret.
# These lines are POSIX, so sh and dash read them too and are refused.
case "${DEPLOY_CONTENT_CLEAN:-}" in
  1) ;;
  *)
    # The whole block is one `case`, read before any of it runs. Nothing in it is `[` or `test`, which a function may
    # replace and which POSIX mode won't let `unset -f` remove. Each command word has a backslash, so no alias applies.
    dc_flags=$-
    dc_shellopts=${SHELLOPTS:-}
    POSIXLY_CORRECT=1
    \unset -f unalias
    \unalias -a 2> /dev/null
    \unset -f echo
    dc_traced=0 dc_posix=0 dc_token=0 dc_key=0 dc_bash_env=0 dc_wrangler_debug=0
    case "${BASH_VERSION:-}" in
      "")
        \echo "deploy-content: refused: run it with bash (scripts/deploy-content, or bash scripts/deploy-content), not sh. Nothing was run." >&2
        \exit 2
        ;;
    esac
    # A process the exec below started always has DC_CALLER_TRACED. Seeing it here means the marker was lost on the way,
    # and running the exec again would loop for ever, so it stops instead. It never execs a second time.
    case "${DC_CALLER_TRACED+x}" in
      x)
        \echo "deploy-content: refused: it started again without its clean-process marker, so it stops rather than start over. Nothing was read or changed." >&2
        \exit 1
        ;;
    esac
    case "$dc_flags" in *x* | *v*) dc_traced=1 ;; esac
    case ":$dc_shellopts:" in *:xtrace:* | *:verbose:*) dc_traced=1 ;; esac
    case ":$dc_shellopts:" in *:posix:*) dc_posix=1 ;; esac
    case "${CLOUDFLARE_API_TOKEN+x}" in x) dc_token=1 ;; esac
    case "${CLOUDFLARE_API_KEY+x}" in x) dc_key=1 ;; esac
    case "${BASH_ENV:-}" in ?*) dc_bash_env=1 ;; esac
    case "${WRANGLER_LOG:-}" in debug) dc_wrangler_debug=1 ;; esac
    # If /usr/bin/env or /bin/bash is missing, this exec fails and, in POSIX mode, the shell exits non-zero with its own
    # message: nothing else runs.
    \exec /usr/bin/env -i HOME="${HOME:-}" TERM="${TERM:-dumb}" PATH="${PATH:-/usr/bin:/bin}" SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" DEPLOY_CONTENT_CLEAN=1 \
      DC_CALLER_TRACED="$dc_traced" DC_CALLER_POSIX="$dc_posix" DC_CALLER_BASH_VERSION="${BASH_VERSION:-}" \
      DC_CALLER_TOKEN="$dc_token" DC_CALLER_KEY="$dc_key" DC_CALLER_BASH_ENV="$dc_bash_env" DC_CALLER_WRANGLER_DEBUG="$dc_wrangler_debug" \
      DC_CALLER_ACCOUNT="${CLOUDFLARE_ACCOUNT_ID:-}" DC_CALLER_CACHE_DIR="${WRANGLER_CACHE_DIR:-}" \
      /bin/bash --noprofile --norc "$0" "$@"
    ;;
esac

# ---- From here, a clean /bin/bash. ----
# It must hold exactly the variables the exec gave it, and no function: a caller who set DEPLOY_CONTENT_CLEAN to skip
# the exec is refused here.
set +o posix 2> /dev/null || true
unset POSIXLY_CORRECT
started_clean=true
for name in $(compgen -e); do
  case "$name" in
    HOME | TERM | PATH | SSH_AUTH_SOCK | PWD | SHLVL | OLDPWD | _ | DEPLOY_CONTENT_CLEAN | DC_CALLER_*) ;;
    *) started_clean=false ;;
  esac
done
if [ "$started_clean" != true ] || [ -n "$(declare -F)" ]; then
  echo "deploy-content: refused: it didn't start in the clean process it makes for itself. Run scripts/deploy-content as it is. Nothing was read or changed." >&2
  exit 1
fi
# Every result the exec carries must be there, in its form: each flag 0 or 1, a bash version, and the two values (which
# may be empty) present. A process that has the marker without them didn't come from the exec above.
dc_malformed=
for name in DC_CALLER_TRACED DC_CALLER_POSIX DC_CALLER_TOKEN DC_CALLER_KEY DC_CALLER_BASH_ENV DC_CALLER_WRANGLER_DEBUG; do
  case "${!name-unset}" in 0 | 1) ;; *) dc_malformed="$dc_malformed $name" ;; esac
done
case "${DC_CALLER_BASH_VERSION-}" in [0-9]*.[0-9]*) ;; *) dc_malformed="$dc_malformed DC_CALLER_BASH_VERSION" ;; esac
for name in DC_CALLER_ACCOUNT DC_CALLER_CACHE_DIR; do
  [ -n "${!name+x}" ] || dc_malformed="$dc_malformed $name"
done
if [ -n "$dc_malformed" ]; then
  echo "deploy-content: refused: it has the clean-process marker but not the results its own exec passes (missing or malformed:$dc_malformed). Run scripts/deploy-content as it is. Nothing was read or changed." >&2
  exit 1
fi
if [ "$DC_CALLER_POSIX" = 1 ]; then echo "deploy-content: refused: bash was in POSIX mode, as when it runs as sh. Run it with bash. Nothing was run." >&2; exit 2; fi
case "$DC_CALLER_BASH_VERSION" in [012].* | 3.[01].*) echo "deploy-content: refused: it needs bash 3.2 or later, and the caller's is $DC_CALLER_BASH_VERSION. Nothing was run." >&2; exit 2 ;; esac
case "$BASH_VERSION" in [012].* | 3.[01].*) echo "deploy-content: refused: /bin/bash is $BASH_VERSION, and it needs 3.2 or later. Nothing was run." >&2; exit 2 ;; esac
if [ "$DC_CALLER_BASH_ENV" = 1 ]; then echo "deploy-content: refused: BASH_ENV is set, so a file ran in the shell that started this. Unset it. Nothing was read or changed." >&2; exit 1; fi
if [ "$DC_CALLER_TRACED" = 1 ]; then echo "deploy-content: refused: it doesn't run under bash -x or -v, or with SHELLOPTS turning on xtrace or verbose, which would print what it does. Nothing was read or changed." >&2; exit 1; fi
set +xv
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/deploy-content --token-file <absolute path> --config-file <absolute path> [--deploy]

Deploys the content Worker, apps/content, to the account that holds the content domain, and nowhere
else. Without --deploy it only reports: it runs every check below, reads Cloudflare's API, and prints
what it would deploy, changing nothing. With --deploy it also deploys, and then probes the content
domain signed out.

AGENTS run it only without --deploy, and only when the owner asks. --deploy needs a person at a
terminal: stdin and stdout must be terminals, and the owner types the content domain to confirm.
No flag or environment variable skips that.

--token-file   a file holding the deploy token, one line, mode 0600, owned by you, not a link, in a
               directory of mode 0700 that is in no git checkout. Only its path is ever an argument.
--config-file  the deploy-time configuration, the same rules, as JSON with exactly these keys:
               {"account_id": "<32 hex>", "content_domain": "<the content domain>",
                "kv_namespace_id": "<32 hex>", "dispatch_namespace": "<name>"}
Both paths must be absolute.

The token is never an argument, never printed, never written to a file by this script, and held in
no shell variable. curl reads it on stdin, with -q (no .curlrc) and an empty environment; wrangler
gets it in an environment that holds nothing of the caller's, run from a folder of the script's own
with --env-file pointing at an empty file, so no .env is read. If any child's output or log contains
the token, the output is redacted and the script fails. Before anything else it starts itself again
as /bin/bash under /usr/bin/env -i, keeping only HOME, TERM, PATH and SSH_AUTH_SOCK, so no function,
alias, BASH_ENV or variable exported by the caller's shell reaches what it runs. It refuses to run
under bash -x or -v, with SHELLOPTS turning either on, or with BASH_ENV set. It needs bash 3.2 or
later (macOS's /bin/bash is 3.2), and refuses sh, dash and bash in POSIX mode with exit 2.

It defends against accidents in the owner's shell: a stray exported function or alias, tracing left
on, a proxy or .curlrc, a leftover token variable, the wrong account. It does not defend against
someone who already controls the owner's account, files or PATH.

It refuses, before changing anything, unless:

  - CLOUDFLARE_API_TOKEN and CLOUDFLARE_API_KEY are unset, so the file's token is the only one
  - WRANGLER_LOG isn't debug
  - both files pass the rules above, and the configuration is well formed. The content domain
    isn't podster.dev or under it, and isn't the committed placeholder
  - the configuration's account isn't CLOUDFLARE_ACCOUNT_ID, nor the account any wrangler login
    has cached in this checkout's other apps (the cache holds an account's ID, not a token),
    compared without regard to case
  - the checkout is detached at origin/main's tip after a fetch, with nothing changed or untracked,
    and ci.yml's run on main for that commit finished as success
  - apps/content has no .wrangler/deploy/config.json and no .env file of any name, and its pinned
    wrangler is 4.157.0
  - Cloudflare's API says, read with the token, each answer in exactly the shape expected:
      the token is active
      the token can't read API tokens, its own included (a token that can is more than a deploy needs)
      the token sees exactly one account, the configuration's
      the token sees no zone named podster.dev
      the content domain is one active zone, on that account
      the dispatch namespace and the KV namespace exist on that account
    Any error, or an answer of any other shape, refuses.

After a deploy it probes the content domain signed out: on a random host, an unknown host gets the
Worker's own not-found with its fixed headers, plain HTTP gets a 301 to HTTPS, a POST gets 405, and
a request with a Service-Worker header gets 403; and the content domain itself serves nothing. A
host two labels deep is not shown: the zone's certificate covers one level.

Exit codes: 0 reported (no --deploy), or deployed and every probe passed; 1 refused, nothing changed;
2 wrong usage; 3 the deploy failed part-way (the output says what wrangler said, redacted); 4
deployed, but a probe failed: the Worker is deployed and not verified; 129, 130 or 143 stopped by
SIGHUP, SIGINT or SIGTERM, and the output says whether anything had been deployed.
EOF
}

token_file=""
config_file=""
deploy=false
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --deploy) deploy=true ;;
    --token-file | --config-file)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == -* ]]; then echo "deploy-content: $1 needs a path" >&2; usage >&2; exit 2; fi
      if [[ "$2" != /* ]]; then echo "deploy-content: $1 needs an absolute path, such as ~/.config/podster/..." >&2; exit 2; fi
      if [ "$1" = --token-file ]; then token_file=$2; else config_file=$2; fi
      shift
      ;;
    *) echo "deploy-content: unexpected argument $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if [ -z "$token_file" ] || [ -z "$config_file" ]; then
  echo "deploy-content: --token-file and --config-file are both needed" >&2
  usage >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
work=$(mktemp -d)
chmod 700 "$work"
mkdir -m 700 "$work/curl-home"
# Every exit the script means sets dc_meant first. Any other exit is an error the script didn't handle, such as set -u's
# unbound variable, and it must never look like success: bash 3.2 runs the EXIT trap with $? at 0 after a set -u error.
dc_meant=0
on_exit() {
  local code=$?
  rm -rf "$work"
  if [ "$dc_meant" != 1 ]; then
    echo "deploy-content: STOPPED on an error it didn't expect, while ${phase:-checking} (status $code). See the line above." >&2
    [ "$code" -ne 0 ] || code=1
  fi
  exit "$code"
}
trap on_exit EXIT

# Where the run is, for what a stop by a signal says.
phase=checking
on_signal() { # on_signal NAME CODE
  trap - INT TERM HUP
  echo
  case "$phase" in
    checking) echo "STOPPED by $1 before anything was deployed. Nothing changed." ;;
    deploying) echo "STOPPED by $1 during wrangler deploy. The Worker may or may not be deployed: check the account before running this again." ;;
    probing) echo "STOPPED by $1 during the probes. The Worker is deployed and NOT verified." ;;
  esac
  dc_meant=1
  exit "$2"
}
trap 'on_signal SIGINT 130' INT
trap 'on_signal SIGTERM 143' TERM
trap 'on_signal SIGHUP 129' HUP

refuse() { echo "REFUSE  $*"; echo "deploy-content: refused, nothing was deployed"; dc_meant=1; exit 1; }
step() { echo; echo "== $*"; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# --- the caller's environment ---
if [ "$DC_CALLER_TOKEN" = 1 ]; then refuse "CLOUDFLARE_API_TOKEN is set in this shell. Unset it: the token file's is the only token this uses."; fi
if [ "$DC_CALLER_KEY" = 1 ]; then refuse "CLOUDFLARE_API_KEY is set in this shell. Unset it: the token file's is the only credential this uses."; fi
if [ "$DC_CALLER_WRANGLER_DEBUG" = 1 ]; then refuse "WRANGLER_LOG is debug. Unset it: a debug log could hold a request's headers."; fi

# --- the owner's two files ---
uid=$(id -u)
# private_file LABEL PATH: a regular file, not a link, mode 0600, the caller's, in a 0700 directory that is the
# caller's, is no link and is in no git checkout.
private_file() {
  local label=$1 path=$2 dir
  [ -e "$path" ] || [ -L "$path" ] || refuse "the $label doesn't exist"
  [ ! -L "$path" ] || refuse "the $label is a link. Give the file itself."
  [ -f "$path" ] || refuse "the $label isn't a regular file"
  [ -n "$(find "$path" -maxdepth 0 -user "$uid" -perm 0600 2> /dev/null)" ] || refuse "the $label must be yours and mode 0600, readable by you alone"
  dir=$(dirname "$path")
  [ ! -L "$dir" ] || refuse "the $label's directory is a link"
  [ -n "$(find "$dir" -maxdepth 0 -type d -user "$uid" -perm 0700 2> /dev/null)" ] || refuse "the $label's directory must be yours and mode 0700"
  if git -C "$dir" rev-parse --is-inside-work-tree > /dev/null 2>&1; then refuse "the $label is inside a git checkout. Keep it outside every repository."; fi
}
private_file "token file" "$token_file"
private_file "configuration file" "$config_file"

# The token: one line of token characters, checked by grep reading the file, never by expanding it.
# Exactly one line: awk counts an unterminated last line as a line, which `wc -l` doesn't.
[ "$(awk 'END { print NR }' "$token_file")" = 1 ] || refuse "the token file must hold one line, the token alone, and nothing after it"
# Every byte must be one of the token's: letters, digits, - and _, and one final newline at most. A NUL or a carriage
# return after the token on the same line is refused, which a line-by-line match might not see.
[ "$(LC_ALL=C tr -d 'A-Za-z0-9_\n-' < "$token_file" | wc -c | tr -d ' ')" = 0 ] \
  || refuse "the token file holds a character that is no token's: only letters, digits, - and _"
LC_ALL=C grep -q -E '^[A-Za-z0-9_-]{30,200}$' "$token_file" || refuse "the token file doesn't hold a token: one line of letters, digits, - and _"

# leaked FILE...: true when any of them holds the token. grep reads the token from its file.
leaked() {
  local file
  for file in "$@"; do
    [ -f "$file" ] || continue
    if grep -q -F -f "$token_file" "$file" 2> /dev/null; then return 0; fi
  done
  return 1
}
# redact FILE: replaces the token in it, in place. awk reads the token from its file.
redact() {
  awk 'NR == FNR { t = $0; next } { while (t != "" && (i = index($0, t)) > 0) $0 = substr($0, 1, i - 1) "[redacted token]" substr($0, i + length(t)); print }' \
    "$token_file" "$1" > "$1.redacted" && mv "$1.redacted" "$1"
}

config=$(cat "$config_file")
jq -e 'type == "object" and (keys == ["account_id", "content_domain", "dispatch_namespace", "kv_namespace_id"]) and all(.[]; type == "string")' <<< "$config" > /dev/null 2>&1 \
  || refuse "the configuration must be a JSON object with exactly account_id, content_domain, dispatch_namespace and kv_namespace_id, each a string"
account=$(jq -r .account_id <<< "$config")
domain=$(jq -r .content_domain <<< "$config")
kv=$(jq -r .kv_namespace_id <<< "$config")
namespace=$(jq -r .dispatch_namespace <<< "$config")
[[ "$account" =~ ^[0-9a-f]{32}$ ]] || refuse "account_id isn't an account's ID, 32 hexadecimal characters in lower case"
[[ "$kv" =~ ^[0-9a-f]{32}$ ]] || refuse "kv_namespace_id isn't a KV namespace's ID, 32 hexadecimal characters in lower case"
[[ "$namespace" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || refuse "dispatch_namespace isn't a namespace's name"
[[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] && [ "${#domain}" -le 253 ] || refuse "content_domain isn't a domain name in lower case"
case "$domain" in
  podster.dev | *.podster.dev) refuse "content_domain is podster.dev's. The content domain is never Podster's own." ;;
  content-domain.invalid) refuse "content_domain is the committed placeholder" ;;
esac

# --- the account isn't the one that holds podster.dev ---
if [ "$(lower "$DC_CALLER_ACCOUNT")" = "$account" ]; then
  refuse "the configuration's account is CLOUDFLARE_ACCOUNT_ID, the account this shell deploys staging to. The content Worker goes on the other account."
fi
# Wrangler caches the account a login chose, as {"account": {"id", "name"}}, beside each app's packages or in the
# app's .wrangler/cache. That file holds no token. apps/content's own cache is skipped: it may rightly hold this account.
cached_account() { lower "$(jq -r '.account.id // empty' "$1" 2> /dev/null || true)"; }
while IFS= read -r cached; do
  if [ "$(cached_account "$cached")" = "$account" ]; then
    refuse "the configuration's account is the one a wrangler login used in ${cached#"$root"/}. The content Worker goes on an account no login here uses."
  fi
done < <(find "$root/apps" -mindepth 1 -maxdepth 5 -path "$root/apps/content" -prune -o \( -path '*/node_modules/.cache/wrangler/*' -o -path '*/.wrangler/cache/*' \) -name 'wrangler-account*.json' -type f -print 2> /dev/null)
if [ -n "$DC_CALLER_CACHE_DIR" ]; then
  for cached in "$DC_CALLER_CACHE_DIR"/wrangler-account*.json; do
    [ -f "$cached" ] || continue
    if [ "$(cached_account "$cached")" = "$account" ]; then refuse "the configuration's account is the one cached in WRANGLER_CACHE_DIR by a wrangler login"; fi
  done
fi

# --- the checkout ---
git fetch --quiet origin || refuse "could not fetch origin"
if git symbolic-ref -q HEAD > /dev/null; then
  refuse "the checkout is on branch $(git symbolic-ref --short HEAD). Detach at main's tip: git checkout --detach origin/main"
fi
here=$(git rev-parse HEAD)
tip=$(git rev-parse --verify --quiet origin/main) || refuse "origin/main doesn't exist"
if [ "$here" != "$tip" ]; then refuse "the checkout is at $here, and origin/main is at $tip"; fi
if [ -n "$(git status --porcelain)" ]; then refuse "the checkout has changed or untracked files"; fi
ci=$(gh run list --workflow ci.yml --branch main --event push --commit "$here" --limit 1 --json status,conclusion \
  --jq '.[] | [.status, (if (.conclusion // "") == "" then "none" else .conclusion end)] | @tsv') \
  || refuse "could not read ci.yml's run on main for $here"
if [ -z "$ci" ]; then refuse "ci.yml has no run on main for $here"; fi
IFS=$'\t' read -r ci_status ci_conclusion <<< "$ci"
if [ "$ci_status" != completed ]; then refuse "ci.yml's run on main for $here is still $ci_status"; fi
if [ "$ci_conclusion" != success ]; then refuse "ci.yml's run on main for $here ended as $ci_conclusion, not success"; fi
if [ -e apps/content/.wrangler/deploy/config.json ] || [ -L apps/content/.wrangler/deploy/config.json ]; then
  refuse "apps/content/.wrangler/deploy/config.json exists: it would point wrangler at another configuration. Remove it."
fi
# Wrangler 4.157.0 loads .env and .env.local from its working directory into its own environment, whatever git
# ignores. It runs from a folder of this script's own with --env-file at an empty file, so none is read; a file here
# is refused all the same, so nothing in the package can be mistaken for the deploy's configuration.
for envfile in apps/content/.env apps/content/.env.*; do
  if [ -e "$envfile" ] || [ -L "$envfile" ]; then refuse "${envfile} exists. Remove it: no .env file belongs in apps/content."; fi
done

step "npm ci in apps/content"
(cd apps/content && npm ci --ignore-scripts) || refuse "npm ci failed in apps/content"
wrangler_version=$(cd apps/content && node_modules/.bin/wrangler --version 2> /dev/null | grep -o -E '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)
[ "$wrangler_version" = 4.157.0 ] || refuse "apps/content's wrangler is '${wrangler_version:-missing}', not 4.157.0"

# --- Cloudflare's API, read with the token ---
# curl_clean ARG...: curl with -q first, so no .curlrc is read, and an environment of PATH and an empty home alone, so
# no proxy, no CURL_HOME and nothing else of the caller's reaches it.
curl_clean() { /usr/bin/env -i PATH="$PATH" HOME="$work/curl-home" curl -q "$@"; }
# cf PATH: GETs Cloudflare's API, and sets $status. The Authorization header goes to curl on stdin, built from the
# token file inside the pipe. The body is left in $work/body. Called directly, never in a subshell, so a refusal here
# ends the script.
cf() {
  : > "$work/body"
  { printf 'header = "Authorization: Bearer '; tr -d '\n' < "$token_file"; printf '"\n'; } \
    | curl_clean --config - --silent --show-error --proto =https --max-time 30 -X GET -o "$work/body" -w '%{http_code}' \
      "https://api.cloudflare.com/client/v4$1" > "$work/status" 2> "$work/curl.err" || echo 000 > "$work/status"
  status=$(cat "$work/status")
  [[ "$status" =~ ^[0-9]{3}$ ]] || status=000
  if leaked "$work/body" "$work/curl.err" "$work/status"; then
    redact "$work/body"
    refuse "Cloudflare's answer to GET $1 held the token. It wasn't printed."
  fi
}
# shaped FILTER [ARG...]: the body is a success in exactly the shape FILTER describes. jq's arguments follow the filter.
# one_document FILTER [ARG...]: the body is exactly one JSON document, and FILTER holds of it. jq's -e alone judges
# only the last document of a stream, so `{"success":false}{...}` would pass; slurped, there must be one.
one_document() {
  local filter=$1
  shift
  jq -e -s "$@" "length == 1 and (.[0] | ($filter))" "$work/body" > /dev/null 2>&1
}
# shaped FILTER [ARG...]: one document, a success, in exactly the shape FILTER describes.
shaped() {
  local filter=$1
  shift
  one_document ".success == true and ($filter)" "$@"
}
ARRAY='(.result | type) == "array"'
TOKEN_SHAPE='(.result | type) == "object" and (.result.id | type) == "string" and (.result.status | type) == "string"'
ACCOUNTS_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.id | type) == "string")'
ZONES_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.name | type) == "string" and (.status | type) == "string" and (.account | type) == "object" and (.account.id | type) == "string")'

step "reading Cloudflare's API with the token"
cf /user/tokens/verify
token_scope=user
if [ "$status" != 200 ] || ! shaped "$TOKEN_SHAPE"; then
  cf "/accounts/$account/tokens/verify"
  token_scope=account
  [ "$status" = 200 ] || refuse "Cloudflare doesn't verify the token (HTTP $status)"
  shaped "$TOKEN_SHAPE" || refuse "Cloudflare's verification of the token isn't in the shape expected"
fi
[ "$(jq -r .result.status "$work/body")" = active ] || refuse "the token isn't active"
token_id=$(jq -r .result.id "$work/body")
[[ "$token_id" =~ ^[0-9a-f]{32}$ ]] || refuse "Cloudflare's verification didn't name the token"
echo "ok   the token is active ($token_scope token)"

if [ "$token_scope" = user ]; then cf "/user/tokens/$token_id"; else cf "/accounts/$account/tokens/$token_id"; fi
# Judged on the answer's shape as well as its status: a token Cloudflare let read itself, or a refusal in Cloudflare's
# own form. Anything else says neither, and refuses.
case "$status" in
  200)
    if shaped '(.result | type) == "object"'; then
      refuse "the token can read API tokens, its own included. That is more than a deploy needs: make one with only the permissions docs/content-deploy.md lists."
    fi
    refuse "asking whether the token can read API tokens answered HTTP 200 with an answer of another shape, which says neither"
    ;;
  401 | 403)
    one_document '.success == false and (.errors | type) == "array"' \
      || refuse "asking whether the token can read API tokens answered HTTP $status with an answer of another shape, which says neither"
    echo "ok   the token can't read API tokens (HTTP $status). Its other permissions can't be read by the token itself: docs/content-deploy.md lists what to grant"
    ;;
  *) refuse "asking whether the token can read API tokens answered HTTP $status, which says neither" ;;
esac

cf "/accounts?per_page=50"
[ "$status" = 200 ] || refuse "listing the accounts the token sees failed (HTTP $status)"
shaped "$ACCOUNTS_SHAPE" || refuse "the list of accounts the token sees isn't in the shape expected"
seen=$(jq -r '[.result[].id | ascii_downcase] | join(" ")' "$work/body")
seen_count=$(jq -r '.result | length' "$work/body")
[ "$seen" = "$account" ] || refuse "the token must see exactly one account, the configuration's. It sees $seen_count account(s), and they aren't exactly that one."
echo "ok   the token sees exactly one account, the configuration's"

cf "/zones?name=podster.dev&per_page=50"
[ "$status" = 200 ] || refuse "asking whether the token sees podster.dev failed (HTTP $status)"
shaped "$ARRAY" || refuse "the answer about podster.dev isn't a list of zones, so it says nothing"
[ "$(jq -r '.result | length' "$work/body")" = 0 ] || refuse "the token can see the zone podster.dev. A content Worker's token must see nothing of Podster's own."
echo "ok   the token sees no zone named podster.dev"

cf "/zones?name=$domain&per_page=50"
[ "$status" = 200 ] || refuse "reading the content domain's zone failed (HTTP $status)"
shaped "$ZONES_SHAPE" || refuse "the answer about the content domain isn't a list of zones in the shape expected"
[ "$(jq -r '.result | length' "$work/body")" = 1 ] || refuse "the token doesn't see the content domain as one zone"
[ "$(jq -r '.result[0].name | ascii_downcase' "$work/body")" = "$domain" ] || refuse "the zone Cloudflare answered with isn't the content domain"
[ "$(jq -r '.result[0].account.id | ascii_downcase' "$work/body")" = "$account" ] || refuse "the content domain's zone isn't on the configuration's account"
[ "$(jq -r '.result[0].status' "$work/body")" = active ] || refuse "the content domain's zone isn't active yet ($(jq -r '.result[0].status' "$work/body"))"
echo "ok   the content domain is an active zone on that account"

cf "/accounts/$account/workers/dispatch/namespaces/$namespace"
[ "$status" = 200 ] || refuse "the dispatch namespace wasn't found on that account (HTTP $status)"
shaped '(.result | type) == "object" and .result.namespace_name == $n' --arg n "$namespace" || refuse "the answer about the dispatch namespace isn't that namespace"
echo "ok   the dispatch namespace exists"
cf "/accounts/$account/storage/kv/namespaces/$kv"
[ "$status" = 200 ] || refuse "the KV namespace wasn't found on that account (HTTP $status)"
shaped '(.result | type) == "object" and (.result.id | ascii_downcase) == $k' --arg k "$kv" || refuse "the answer about the KV namespace isn't that namespace"
echo "ok   the KV namespace exists"

# --- what would be deployed ---
# The committed file gives the Worker's name, entry point and compatibility date, and nothing else.
committed=$(node --input-type=module -e '
import { readFileSync } from "node:fs";
import { parseJsonc } from "./e2e/jsonc.mjs";
const c = parseJsonc(readFileSync("apps/content/wrangler.jsonc", "utf8"));
process.stdout.write(JSON.stringify({ name: c.name, main: c.main, compatibility_date: c.compatibility_date }));
') || refuse "couldn't read apps/content/wrangler.jsonc"
[ "$(jq -r .name <<< "$committed")" = podster-content ] || refuse "apps/content/wrangler.jsonc doesn't name the Worker podster-content"
route="*.$domain/*"
jq -n --argjson c "$committed" --arg main "$root/apps/content/$(jq -r .main <<< "$committed")" --arg account "$account" \
  --arg domain "$domain" --arg route "$route" --arg kv "$kv" --arg namespace "$namespace" '{
    name: $c.name, main: $main, compatibility_date: $c.compatibility_date, account_id: $account,
    workers_dev: false, preview_urls: false,
    routes: [{ pattern: $route, zone_name: $domain }],
    vars: { CONTENT_DOMAIN: $domain },
    kv_namespaces: [{ binding: "SERVE", id: $kv }],
    dispatch_namespaces: [{ binding: "APPS", namespace: $namespace }]
  }' > "$work/wrangler.json"

echo
echo "would deploy podster-content at $here, origin/main's tip with ci.yml green, to the configuration's account,"
echo "on the route $route, with the content domain $domain, its KV namespace and its dispatch namespace."
echo "No other route, no workers.dev address and no preview address."

if [ "$deploy" != true ]; then
  echo
  echo "deploy-content: every check passed. Nothing was deployed: this run had no --deploy."
  dc_meant=1
  exit 0
fi

# --- a person confirms ---
if [ ! -t 0 ] || [ ! -t 1 ]; then
  refuse "--deploy needs a person at a terminal: stdin and stdout must both be terminals. Agents run this without --deploy."
fi
printf '\nTo deploy, type the content domain (%s): ' "$domain"
IFS= read -r typed || typed=""
[ "$typed" = "$domain" ] || refuse "what was typed isn't the content domain"

# --- the deploy ---
step "wrangler deploy"
mkdir -m 700 "$work/home" "$work/logs" "$work/cache" "$work/xdg" "$work/run"
: > "$work/empty.env"
phase=deploying
deploy_status=0
# env -i with an allow-list: nothing of the caller's environment, exported functions included, reaches wrangler. The
# small shell reads the token on its stdin, from the file, so it is in no command's arguments, and exports it to
# wrangler alone. It runs from $work/run, a folder of the script's own, with --env-file at an empty file, so wrangler
# reads no .env.
/usr/bin/env -i PATH="$PATH" HOME="$work/home" XDG_CONFIG_HOME="$work/xdg" WRANGLER_CACHE_DIR="$work/cache" \
  WRANGLER_LOG_PATH="$work/logs" WRANGLER_SEND_METRICS=false CI=true \
  /bin/bash --noprofile --norc -c 'set -eu; IFS= read -r CLOUDFLARE_API_TOKEN; export CLOUDFLARE_API_TOKEN; cd "$1"; exec "$2" deploy --config "$3" --env-file "$4" < /dev/null' \
  deploy-content "$work/run" "$root/apps/content/node_modules/.bin/wrangler" "$work/wrangler.json" "$work/empty.env" \
  < "$token_file" > "$work/deploy.out" 2>&1 || deploy_status=$?
logs=$(find "$work/logs" -type f 2> /dev/null || true)
# shellcheck disable=SC2086
if leaked "$work/deploy.out" $logs; then
  redact "$work/deploy.out"
  sed 's/^/        | /' "$work/deploy.out"
  echo
  echo "STOPPED wrangler's output or its log held the token. It was redacted above and not printed."
  echo "deploy-content: the Worker may or may not be deployed. Read wrangler's output above, and make a new token."
  dc_meant=1
  exit 3
fi
sed 's/^/        | /' "$work/deploy.out"
if [ "$deploy_status" -ne 0 ]; then
  echo
  echo "STOPPED wrangler deploy exited with status $deploy_status"
  echo "deploy-content: the deploy failed part-way. Read wrangler's output above for what changed."
  dc_meant=1
  exit 3
fi
version=$(grep -o -E 'Current Version ID: [0-9a-f-]{36}' "$work/deploy.out" | head -n 1 | sed 's/.*: //' || true)
echo "version podster-content ${version:-not printed by wrangler}"

# --- signed-out probes of the content domain ---
phase=probing
step "probing $domain signed out"
label=$(od -An -N13 -tx1 /dev/urandom | tr -d ' \n')
host="$label.$domain"
probe_failures=0
pass() { echo "PASS    $*"; }
fail() { echo "FAIL    $*"; probe_failures=$((probe_failures + 1)); }
# fetch METHOD URL [HEADER]: leaves the headers in $work/h and the body in $work/b, and prints the status.
fetch() {
  local extra=()
  : > "$work/h"
  : > "$work/b"
  [ -n "${3:-}" ] && extra=(-H "$3")
  local got
  got=$(curl_clean --silent --proto =https,http --max-time 30 -X "$1" ${extra[@]+"${extra[@]}"} -D "$work/h" -o "$work/b" -w '%{http_code}' "$2" 2> /dev/null) || true
  [[ "$got" =~ ^[0-9]{3}$ ]] || got=000
  printf '%s' "$got"
}
header() { grep -i -E "^$1:" "$work/h" | head -n 1 | sed -E "s/^[^:]*:[[:space:]]*//" | tr -d '\r'; }
fixed_headers() { # fixed_headers WHAT: the headers the Worker sets on every own answer
  local missing=()
  [ "$(header x-content-type-options)" = nosniff ] || missing+=(x-content-type-options)
  [ "$(header referrer-policy)" = no-referrer ] || missing+=(referrer-policy)
  [ "$(header strict-transport-security)" = "max-age=31536000; includeSubDomains" ] || missing+=(strict-transport-security)
  [ "$(header cache-control)" = no-store ] || missing+=(cache-control)
  [[ "$(header content-security-policy)" == "sandbox allow-scripts; "* ]] || missing+=(content-security-policy)
  if [ "${#missing[@]}" -eq 0 ]; then return 0; fi
  echo "        $1: missing or wrong: ${missing[*]}"
  return 1
}

status=$(fetch GET "https://$host/")
if [ "$status" = 404 ] && [ "$(cat "$work/b")" = not_found ] && fixed_headers "an unknown host"; then pass "an unknown host gets the Worker's own not-found, with its fixed headers"; else fail "an unknown host: HTTP $status"; fi
status=$(fetch GET "http://$host/probe?x=1")
if [ "$status" = 301 ] && [ "$(header location)" = "https://$host/probe?x=1" ]; then pass "plain HTTP gets a 301 to the same host and path over HTTPS"; else fail "plain HTTP: HTTP $status, Location '$(header location)'"; fi
status=$(fetch POST "https://$host/")
if [ "$status" = 405 ] && [ "$(header allow)" = "GET, HEAD" ]; then pass "a POST gets 405, allowing GET and HEAD"; else fail "a POST: HTTP $status"; fi
status=$(fetch GET "https://$host/sw.js" "Service-Worker: script")
if [ "$status" = 403 ] && [ "$(cat "$work/b")" = no_service_workers ]; then pass "a service worker's script gets 403"; else fail "a service worker's script: HTTP $status"; fi
# The content domain itself is no app's host, and the route doesn't cover it: nothing may be served there. No
# answer at all, as when it has no address, passes; so does any answer that isn't a success.
status=$(fetch GET "https://$domain/")
case "$status" in
  000) pass "the content domain itself serves nothing: no answer" ;;
  2??) fail "the content domain itself answered HTTP $status: something is served there" ;;
  *) pass "the content domain itself serves nothing: HTTP $status" ;;
esac
echo "NOT SHOWN a host two labels deep, such as a.$host: the zone's certificate covers one level, so HTTPS there can't be probed"

echo
if [ "$probe_failures" -ne 0 ]; then
  echo "deploy-content: deployed podster-content at $here (version ${version:-unknown}), but $probe_failures probe(s) failed: the Worker is deployed and NOT verified."
  dc_meant=1
  exit 4
fi
echo "deploy-content: deployed podster-content at $here (version ${version:-unknown}) to $domain, and every probe passed."
dc_meant=1
