#!/usr/bin/env bash
# The one way to deploy the content Worker, apps/content, and the outbound Worker, apps/outbound, to the second
# Cloudflare account (M6 step 4(b), ADR 0010 and its revision's question 8, decision 217). The outbound Worker always
# deploys first, with no route, no address and no binding, and the content Worker's dispatch binding names it as the
# namespace's outbound Worker. It never uses either package's wrangler.jsonc account or a wrangler login: the account,
# the content domain and the two namespaces come from the owner's configuration file, and the token from the owner's
# token file. docs/content-deploy.md is the guide.
#
# WHAT IT DEFENDS AGAINST: accidents in the owner's shell. A stray exported function or alias from dotfiles, tracing
# left on, a proxy or a .curlrc, a leftover token variable, the wrong account in the environment. It does NOT defend
# against someone who already controls the owner's account, files or PATH: such a person can replace the programs this
# runs, and no script can stop that.
#
# No shell variable ever holds the token. It is read from its file only where it is handed to a child: into curl's
# stdin, and into the stdin of the small shell that starts wrangler. Finding or redacting it in an output reads it from
# the file too (`grep -f`, awk), so it is in no command's arguments either.

# ---- First, a clean process. ----
# Until the `exec` below, only what a function or an alias can't replace runs. An assignment of POSIXLY_CORRECT puts
# bash in POSIX mode, where special builtins (unset, exec, exit) are found before functions. A backslash keeps a word
# from being read as an alias. Then echo, the one ordinary command used before the exec, loses any function of its name, and
# the script runs again as `/bin/bash` under `/usr/bin/env -i`: no inherited function, alias, BASH_ENV, SHELLOPTS,
# CLOUDFLARE_* or proxy variable. It keeps HOME, TERM, PATH and SSH_AUTH_SOCK, so git, gh and npm work as the owner's.
# What it needs of the caller's environment it carries as results and IDs, never a secret.
# These lines are POSIX, so sh and dash read them too and are refused.
case "${DEPLOY_CONTENT_CLEAN:-}" in
  1) ;;
  *)
    # The whole block is one `case`, read before any of it runs. Nothing in it is `[` or `test`, which a function may
    # replace and which POSIX mode won't let `unset -f` remove. Each command word has a backslash, so no alias applies.
    dc_flags=$-
    dc_shellopts=${SHELLOPTS:-}
    POSIXLY_CORRECT=1
    \unset -f unalias
    \unalias -a 2> /dev/null
    \unset -f echo
    dc_traced=0 dc_posix=0 dc_token=0 dc_key=0 dc_bash_env=0 dc_wrangler_debug=0
    case "${BASH_VERSION:-}" in
      "")
        \echo "deploy-content: refused: run it with bash (scripts/deploy-content, or bash scripts/deploy-content), not sh. Nothing was run." >&2
        \exit 2
        ;;
    esac
    # A process the exec below started always has DC_CALLER_TRACED. Seeing it here means the marker was lost on the way,
    # and running the exec again would loop for ever, so it stops instead. It never execs a second time.
    case "${DC_CALLER_TRACED+x}" in
      x)
        \echo "deploy-content: refused: it started again without its clean-process marker, so it stops rather than start over. Nothing was read or changed." >&2
        \exit 1
        ;;
    esac
    case "$dc_flags" in *x* | *v*) dc_traced=1 ;; esac
    case ":$dc_shellopts:" in *:xtrace:* | *:verbose:*) dc_traced=1 ;; esac
    case ":$dc_shellopts:" in *:posix:*) dc_posix=1 ;; esac
    case "${CLOUDFLARE_API_TOKEN+x}" in x) dc_token=1 ;; esac
    case "${CLOUDFLARE_API_KEY+x}" in x) dc_key=1 ;; esac
    case "${BASH_ENV:-}" in ?*) dc_bash_env=1 ;; esac
    case "${WRANGLER_LOG:-}" in debug) dc_wrangler_debug=1 ;; esac
    # If /usr/bin/env or /bin/bash is missing, this exec fails and, in POSIX mode, the shell exits non-zero with its own
    # message: nothing else runs.
    \exec /usr/bin/env -i HOME="${HOME:-}" TERM="${TERM:-dumb}" PATH="${PATH:-/usr/bin:/bin}" SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" DEPLOY_CONTENT_CLEAN=1 \
      DC_CALLER_TRACED="$dc_traced" DC_CALLER_POSIX="$dc_posix" DC_CALLER_BASH_VERSION="${BASH_VERSION:-}" \
      DC_CALLER_TOKEN="$dc_token" DC_CALLER_KEY="$dc_key" DC_CALLER_BASH_ENV="$dc_bash_env" DC_CALLER_WRANGLER_DEBUG="$dc_wrangler_debug" \
      DC_CALLER_ACCOUNT="${CLOUDFLARE_ACCOUNT_ID:-}" DC_CALLER_CACHE_DIR="${WRANGLER_CACHE_DIR:-}" \
      /bin/bash --noprofile --norc "$0" "$@"
    ;;
esac

# ---- From here, a clean /bin/bash. ----
# It must hold exactly the variables the exec gave it, and no function: a caller who set DEPLOY_CONTENT_CLEAN to skip
# the exec is refused here.
set +o posix 2> /dev/null || true
unset POSIXLY_CORRECT
started_clean=true
for name in $(compgen -e); do
  case "$name" in
    HOME | TERM | PATH | SSH_AUTH_SOCK | PWD | SHLVL | OLDPWD | _ | DEPLOY_CONTENT_CLEAN | DC_CALLER_*) ;;
    *) started_clean=false ;;
  esac
done
if [ "$started_clean" != true ] || [ -n "$(declare -F)" ]; then
  echo "deploy-content: refused: it didn't start in the clean process it makes for itself. Run scripts/deploy-content as it is. Nothing was read or changed." >&2
  exit 1
fi
# Every result the exec carries must be there, in its form: each flag 0 or 1, a bash version, and the two values (which
# may be empty) present. A process that has the marker without them didn't come from the exec above.
dc_malformed=
for name in DC_CALLER_TRACED DC_CALLER_POSIX DC_CALLER_TOKEN DC_CALLER_KEY DC_CALLER_BASH_ENV DC_CALLER_WRANGLER_DEBUG; do
  case "${!name-unset}" in 0 | 1) ;; *) dc_malformed="$dc_malformed $name" ;; esac
done
case "${DC_CALLER_BASH_VERSION-}" in [0-9]*.[0-9]*) ;; *) dc_malformed="$dc_malformed DC_CALLER_BASH_VERSION" ;; esac
for name in DC_CALLER_ACCOUNT DC_CALLER_CACHE_DIR; do
  [ -n "${!name+x}" ] || dc_malformed="$dc_malformed $name"
done
if [ -n "$dc_malformed" ]; then
  echo "deploy-content: refused: it has the clean-process marker but not the results its own exec passes (missing or malformed:$dc_malformed). Run scripts/deploy-content as it is. Nothing was read or changed." >&2
  exit 1
fi
if [ "$DC_CALLER_POSIX" = 1 ]; then echo "deploy-content: refused: bash was in POSIX mode, as when it runs as sh. Run it with bash. Nothing was run." >&2; exit 2; fi
case "$DC_CALLER_BASH_VERSION" in [012].* | 3.[01].*) echo "deploy-content: refused: it needs bash 3.2 or later, and the caller's is $DC_CALLER_BASH_VERSION. Nothing was run." >&2; exit 2 ;; esac
case "$BASH_VERSION" in [012].* | 3.[01].*) echo "deploy-content: refused: /bin/bash is $BASH_VERSION, and it needs 3.2 or later. Nothing was run." >&2; exit 2 ;; esac
if [ "$DC_CALLER_BASH_ENV" = 1 ]; then echo "deploy-content: refused: BASH_ENV is set, so a file ran in the shell that started this. Unset it. Nothing was read or changed." >&2; exit 1; fi
if [ "$DC_CALLER_TRACED" = 1 ]; then echo "deploy-content: refused: it doesn't run under bash -x or -v, or with SHELLOPTS turning on xtrace or verbose, which would print what it does. Nothing was read or changed." >&2; exit 1; fi
set +xv
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/deploy-content --token-file <absolute path> --config-file <absolute path> [--deploy]

Deploys two Workers to the account that holds the content domain, and nowhere else: first the
outbound Worker, apps/outbound, as podster-outbound, with no route, no workers.dev address, no preview
address and no binding; then the content Worker, apps/content, whose dispatch binding APPS names
podster-outbound as the namespace's outbound Worker, on two routes on the content domain's zone:
*.<domain>/* for the apps' default hosts, and */* for every host that enters the zone, which is how
a custom hostname of Cloudflare for SaaS reaches it. That one is security-sensitive: it hands the
content Worker every host on the zone, and it answers its own not-found for any host with no live
serve entry, the content domain itself and the fallback origin's name included. Before either Worker,
it makes sure the zone holds */.well-known/acme-challenge/* and */.well-known/pki-validation/*, each
running no Worker, with the zone's routes API (POST, one of its two writes outside wrangler), so a
certificate authority's validation of a custom hostname never reaches an app. Also before either
Worker, it makes sure the zone's one WAF rate limiting rule, ref podster_content_rate_limit, is 300
requests per 10 s per IP (cf.colo.id and ip.src), action block for 10 s, on every path but those
two validation folders: the request-rate abuse control for every app and custom hostname. It reads
the zone's http_ratelimit entry point and says whether that rule is missing, matching or different,
and a deploy creates or updates that rule alone, never another's. The outbound Worker
always deploys: no flag or key leaves it out. Without --deploy it only reports: it runs every check below, reads Cloudflare's
API, and prints what it would deploy, both Workers, changing nothing. With --deploy it also deploys
both, checks the outbound Worker by Cloudflare's API, and probes the content domain signed out.

AGENTS run it only without --deploy, and only when the owner asks. --deploy needs a person at a
terminal: stdin and stdout must be terminals, and the owner types the content domain to confirm.
No flag or environment variable skips that.

--token-file   a file holding the deploy token, one line, mode 0600, owned by you, not a link, in a
               directory of mode 0700 that is in no git checkout. Only its path is ever an argument.
--config-file  the deploy-time configuration, the same rules, as JSON with exactly these keys:
               {"account_id": "<32 hex>", "content_domain": "<the content domain>",
                "kv_namespace_id": "<32 hex>", "dispatch_namespace": "<name>"}
               and, for previews (M8 step 8, decision 258), these three as well, all or none:
               {"preview_namespace": "<name>", "preview_public_keys": "<kid>:<64 hex>[,<kid>:<64 hex>]",
                "preview_access_origin": "https://<the application host>"}
               With none of them the content Worker has no preview binding and previews are off. With
               them, the preview namespace must differ from the dispatch namespace and exist on the
               account, the keys are the public halves of PREVIEW_TICKET_KEY (one, or two while a
               rotation's old key lasts its hour), and the origin is off the content domain.
Both paths must be absolute.

The token is never an argument, never printed, never written to a file by this script, and held in
no shell variable. curl reads it on stdin, with -q (no .curlrc) and an empty environment; wrangler
gets it in an environment that holds nothing of the caller's, run from a folder of the script's own
with --env-file pointing at an empty file, so no .env is read. If any child's output or log contains
the token, the output is redacted and the script fails. Before anything else it starts itself again
as /bin/bash under /usr/bin/env -i, keeping only HOME, TERM, PATH and SSH_AUTH_SOCK, so no function,
alias, BASH_ENV or variable exported by the caller's shell reaches what it runs. It refuses to run
under bash -x or -v, with SHELLOPTS turning either on, or with BASH_ENV set. It needs bash 3.2 or
later (macOS's /bin/bash is 3.2), and refuses sh, dash and bash in POSIX mode with exit 2.

It defends against accidents in the owner's shell: a stray exported function or alias, tracing left
on, a proxy or .curlrc, a leftover token variable, the wrong account. It does not defend against
someone who already controls the owner's account, files or PATH.

It refuses, before changing anything, unless:

  - CLOUDFLARE_API_TOKEN and CLOUDFLARE_API_KEY are unset, so the file's token is the only one
  - WRANGLER_LOG isn't debug
  - both files pass the rules above, and the configuration is well formed. The content domain
    isn't podster.dev or under it, and isn't the committed placeholder
  - the configuration's account isn't CLOUDFLARE_ACCOUNT_ID, nor the account any wrangler login
    has cached in this checkout's other apps (the cache holds an account's ID, not a token),
    compared without regard to case
  - the checkout is detached at origin/main's tip after a fetch, with nothing changed or untracked,
    and ci.yml's run on main for that commit finished as success
  - apps/content and apps/outbound each have no .wrangler/deploy/config.json and no .env file of
    any name, and each one's pinned wrangler is 4.157.0
  - apps/outbound/wrangler.jsonc names the Worker podster-outbound, switches both public addresses
    off, and holds nothing but its name, entry point, compatibility date, placeholder account and
    those two switches. The deploy carries the name, entry point and compatibility date alone.
  - apps/content/wrangler.jsonc names the Worker podster-content and holds the write counter in
    exactly the committed shape: the binding WRITE_COUNTER to this Worker's own class WriteCounter,
    the one migration v1 making it a SQLite-backed class, and WRITE_BUDGET_WRITES and
    WRITE_BUDGET_WINDOW_MS as decimal strings the content Worker takes as a cap (writes 0 to
    4294967295, the window 1 to 9223372036854775807), and APP_LIMIT_CPU_MS and APP_LIMIT_SUBREQUESTS
    as decimal strings the content Worker takes as a dispatch's limits (CPU 1 to 300000 ms, the
    platform's maximum, and subrequests 0 to 999999999). The deploy carries those six and nothing else from that file
    beyond the name, entry point and compatibility date.
  - Cloudflare's API says, read with the token, each answer in exactly the shape expected:
      the token is active
      the token can't read API tokens, its own included (a token that can is more than a deploy needs)
      the token sees exactly one account, the configuration's
      the token sees no zone named podster.dev
      the content domain is one active zone, on that account
      the dispatch namespace and the KV namespace exist on that account, and the preview namespace,
      when the configuration names one
      the account's Worker scripts can be listed (it says whether podster-outbound exists yet)
      no route on the content domain's zone names podster-outbound, or any Worker but podster-content
      podster-content has no route on that zone but the two it deploys (a route that runs no
      Worker is left alone, and the two below are added if missing)
      no custom domain on the account runs podster-outbound (if they can't be read: NOT SHOWN)
      the zone's rate limiting rules can be read (a 401 or 403 names the permission to add:
      Zone > Zone WAF > Edit on that zone), at most one rule has this script's ref, and if it is
      missing, no other rule is there: the free plan allows one per zone
    Any error, or an answer of any other shape, refuses.

The deploy runs wrangler twice, outbound first. If the outbound Worker's deploy fails, or Cloudflare's
list of scripts doesn't then show podster-outbound, the content Worker isn't deployed (exit 3).

After a deploy it waits up to 30 s, by the clock, for the route: until a new route takes effect,
Cloudflare answers a host on it with a 52x or not at all, so it sends the first probe's request,
each try allowed 5 s, every 2 s while that is the answer. Any other answer ends the wait, and if the
route never answers the probes run anyway, with their own timeouts.
Then it probes the content domain signed out, with scripts/content-probes (which runs alone too):
on a random host, an unknown host gets the Worker's own not-found with its fixed headers, plain
HTTP gets a 301 to HTTPS, a POST gets 405, and a request with a Service-Worker header gets 403; and
the content domain itself serves nothing. A host two labels deep is not shown: the zone's
certificate covers one level.
Then it checks by Cloudflare's API, with the token: podster-outbound exists, has no workers.dev or
preview address, and no route on the content domain's zone names it (other zones the token can't
see, and can't add routes on); that podster-content's routes on that zone are exactly the two
deployed, the two no-Worker routes are there, and no route there runs another Worker; and, from
podster-content's deployed settings, that its APPS binding names podster-outbound as outbound; and
that no custom domain on the account runs podster-outbound; and that the zone's rate limiting rule
is there exactly as deployed. A route someone adds on the zone during
a deploy is reported by that check, never prevented.
If those settings or the custom domains can't be read, it says NOT SHOWN, never passed, and exits 4.
An app's fetch being refused is NOT SHOWN: it needs an app with code, and none exists yet.

Exit codes: 0 reported (no --deploy), or deployed and every probe passed; 1 refused, nothing changed;
2 wrong usage; 3 the deploy failed part-way, adding a no-Worker route or writing the rate limiting rule included (the output says what
wrangler or Cloudflare said, redacted, and which Worker was deployed); 4 deployed, but a probe or check failed or was NOT SHOWN: the Workers are
deployed and not
verified; 129, 130 or 143 stopped by
SIGHUP, SIGINT or SIGTERM, and the output says whether anything had been deployed.
EOF
}

token_file=""
config_file=""
deploy=false
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --deploy) deploy=true ;;
    --token-file | --config-file)
      if [ $# -lt 2 ] || [ -z "$2" ] || [[ "$2" == -* ]]; then echo "deploy-content: $1 needs a path" >&2; usage >&2; exit 2; fi
      if [[ "$2" != /* ]]; then echo "deploy-content: $1 needs an absolute path, such as ~/.config/podster/..." >&2; exit 2; fi
      if [ "$1" = --token-file ]; then token_file=$2; else config_file=$2; fi
      shift
      ;;
    *) echo "deploy-content: unexpected argument $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done
if [ -z "$token_file" ] || [ -z "$config_file" ]; then
  echo "deploy-content: --token-file and --config-file are both needed" >&2
  usage >&2
  exit 2
fi

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
work=$(mktemp -d)
chmod 700 "$work"
mkdir -m 700 "$work/curl-home"
# Every exit the script means sets dc_meant first. Any other exit is an error the script didn't handle, such as set -u's
# unbound variable, and it must never look like success: bash 3.2 runs the EXIT trap with $? at 0 after a set -u error.
dc_meant=0
on_exit() {
  local code=$?
  rm -rf "$work"
  if [ "$dc_meant" != 1 ]; then
    echo "deploy-content: STOPPED on an error it didn't expect, while ${phase:-checking} (status $code). See the line above." >&2
    [ "$code" -ne 0 ] || code=1
  fi
  exit "$code"
}
trap on_exit EXIT

# Where the run is, for what a stop by a signal says.
phase=checking
on_signal() { # on_signal NAME CODE
  trap - INT TERM HUP
  echo
  case "$phase" in
    checking) echo "STOPPED by $1 before anything was deployed. Nothing changed." ;;
    routing) echo "STOPPED by $1 while adding the routes that run no Worker, before either Worker was deployed. One may have been added, which only keeps Workers off a validation path: run this again." ;;
    ratelimiting) echo "STOPPED by $1 while writing the zone's rate limiting rule, before either Worker was deployed. The rule may or may not have changed: run this again, and its report says which." ;;
    deploying-outbound) echo "STOPPED by $1 while deploying the outbound Worker. podster-outbound may or may not be deployed, and the content Worker wasn't: check the account before running this again." ;;
    deploying) echo "STOPPED by $1 during wrangler deploy of the content Worker. podster-outbound is deployed; the content Worker may or may not be deployed: check the account before running this again." ;;
    probing) echo "STOPPED by $1 during the probes. The Workers are deployed and NOT verified." ;;
  esac
  dc_meant=1
  exit "$2"
}
trap 'on_signal SIGINT 130' INT
trap 'on_signal SIGTERM 143' TERM
trap 'on_signal SIGHUP 129' HUP

refuse() { echo "REFUSE  $*"; echo "deploy-content: refused, nothing was deployed"; dc_meant=1; exit 1; }
step() { echo; echo "== $*"; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# --- the caller's environment ---
if [ "$DC_CALLER_TOKEN" = 1 ]; then refuse "CLOUDFLARE_API_TOKEN is set in this shell. Unset it: the token file's is the only token this uses."; fi
if [ "$DC_CALLER_KEY" = 1 ]; then refuse "CLOUDFLARE_API_KEY is set in this shell. Unset it: the token file's is the only credential this uses."; fi
if [ "$DC_CALLER_WRANGLER_DEBUG" = 1 ]; then refuse "WRANGLER_LOG is debug. Unset it: a debug log could hold a request's headers."; fi

# --- the owner's two files ---
uid=$(id -u)
# private_file LABEL PATH: a regular file, not a link, mode 0600, the caller's, in a 0700 directory that is the
# caller's, is no link and is in no git checkout.
private_file() {
  local label=$1 path=$2 dir
  [ -e "$path" ] || [ -L "$path" ] || refuse "the $label doesn't exist"
  [ ! -L "$path" ] || refuse "the $label is a link. Give the file itself."
  [ -f "$path" ] || refuse "the $label isn't a regular file"
  [ -n "$(find "$path" -maxdepth 0 -user "$uid" -perm 0600 2> /dev/null)" ] || refuse "the $label must be yours and mode 0600, readable by you alone"
  dir=$(dirname "$path")
  [ ! -L "$dir" ] || refuse "the $label's directory is a link"
  [ -n "$(find "$dir" -maxdepth 0 -type d -user "$uid" -perm 0700 2> /dev/null)" ] || refuse "the $label's directory must be yours and mode 0700"
  if git -C "$dir" rev-parse --is-inside-work-tree > /dev/null 2>&1; then refuse "the $label is inside a git checkout. Keep it outside every repository."; fi
}
private_file "token file" "$token_file"
private_file "configuration file" "$config_file"

# The token: one line of token characters, checked by grep reading the file, never by expanding it.
# Exactly one line: awk counts an unterminated last line as a line, which `wc -l` doesn't.
[ "$(awk 'END { print NR }' "$token_file")" = 1 ] || refuse "the token file must hold one line, the token alone, and nothing after it"
# Every byte must be one of the token's: letters, digits, - and _, and one final newline at most. A NUL or a carriage
# return after the token on the same line is refused, which a line-by-line match might not see.
[ "$(LC_ALL=C tr -d 'A-Za-z0-9_\n-' < "$token_file" | wc -c | tr -d ' ')" = 0 ] \
  || refuse "the token file holds a character that is no token's: only letters, digits, - and _"
LC_ALL=C grep -q -E '^[A-Za-z0-9_-]{30,200}$' "$token_file" || refuse "the token file doesn't hold a token: one line of letters, digits, - and _"

# leaked FILE...: true when any of them holds the token. grep reads the token from its file.
leaked() {
  local file
  for file in "$@"; do
    [ -f "$file" ] || continue
    if grep -q -F -f "$token_file" "$file" 2> /dev/null; then return 0; fi
  done
  return 1
}
# redact FILE: replaces the token in it, in place. awk reads the token from its file.
redact() {
  awk 'NR == FNR { t = $0; next } { while (t != "" && (i = index($0, t)) > 0) $0 = substr($0, 1, i - 1) "[redacted token]" substr($0, i + length(t)); print }' \
    "$token_file" "$1" > "$1.redacted" && mv "$1.redacted" "$1"
}

config=$(cat "$config_file")
# The four keys every deploy has, and for previews (M8 step 8) three more, read only when present, and then all three:
# half a preview configuration is refused, never deployed as previews off or on.
jq -e 'type == "object" and ((keys == ["account_id", "content_domain", "dispatch_namespace", "kv_namespace_id"])
    or (keys == ["account_id", "content_domain", "dispatch_namespace", "kv_namespace_id", "preview_access_origin", "preview_namespace", "preview_public_keys"]))
    and all(.[]; type == "string")' <<< "$config" > /dev/null 2>&1 \
  || refuse "the configuration must be a JSON object with exactly account_id, content_domain, dispatch_namespace and kv_namespace_id, and for previews preview_namespace, preview_public_keys and preview_access_origin as well (all three or none), each a string"
account=$(jq -r .account_id <<< "$config")
domain=$(jq -r .content_domain <<< "$config")
kv=$(jq -r .kv_namespace_id <<< "$config")
namespace=$(jq -r .dispatch_namespace <<< "$config")
[[ "$account" =~ ^[0-9a-f]{32}$ ]] || refuse "account_id isn't an account's ID, 32 hexadecimal characters in lower case"
[[ "$kv" =~ ^[0-9a-f]{32}$ ]] || refuse "kv_namespace_id isn't a KV namespace's ID, 32 hexadecimal characters in lower case"
[[ "$namespace" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || refuse "dispatch_namespace isn't a namespace's name"
[[ "$domain" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] && [ "${#domain}" -le 253 ] || refuse "content_domain isn't a domain name in lower case"
case "$domain" in
  podster.dev | *.podster.dev) refuse "content_domain is podster.dev's. The content domain is never Podster's own." ;;
  content-domain.invalid) refuse "content_domain is the committed placeholder" ;;
esac
# Previews (M8 step 8): the preview namespace's binding PREVIEW_APPS and two plain variables, exactly what the content
# Worker reads (`publicKeysFromSetting` and `accessOriginFromSetting`, apps/content/src/preview.ts). None of them is a
# secret: the keys are public halves, which check a token and can't make one.
previews=false preview_namespace="" preview_keys="" preview_origin=""
if jq -e 'has("preview_namespace")' <<< "$config" > /dev/null; then
  previews=true
  preview_namespace=$(jq -r .preview_namespace <<< "$config")
  preview_keys=$(jq -r .preview_public_keys <<< "$config")
  preview_origin=$(jq -r .preview_access_origin <<< "$config")
  [[ "$preview_namespace" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] || refuse "preview_namespace isn't a namespace's name"
  [ "$preview_namespace" != "$namespace" ] || refuse "preview_namespace is the dispatch namespace. Previews have a namespace of their own (decision 258): a preview script must never be in production's."
  key='[A-Za-z0-9_-]{1,64}:[0-9a-fA-F]{64}'
  [[ "$preview_keys" =~ ^$key(,$key)?$ ]] || refuse "preview_public_keys isn't one or two public keys, each <kid>:<64 hex>, separated by a comma"
  case "$preview_keys" in
    *,*) [ "${preview_keys%%:*}" != "$(cut -d, -f2 <<< "$preview_keys" | cut -d: -f1)" ] || refuse "preview_public_keys names one key ID twice" ;;
  esac
  [[ "$preview_origin" =~ ^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] && [ "${#preview_origin}" -le 261 ] \
    || refuse "preview_access_origin isn't https:// and a host in lower case, with no path or port"
  case "${preview_origin#https://}" in
    "$domain" | *".$domain") refuse "preview_access_origin is on the content domain. A viewer is sent for a ticket to the application host, never to an app's." ;;
  esac
fi

# --- the account isn't the one that holds podster.dev ---
if [ "$(lower "$DC_CALLER_ACCOUNT")" = "$account" ]; then
  refuse "the configuration's account is CLOUDFLARE_ACCOUNT_ID, the account this shell deploys staging to. The content Worker goes on the other account."
fi
# Wrangler caches the account a login chose, as {"account": {"id", "name"}}, beside each app's packages or in the
# app's .wrangler/cache. That file holds no token. apps/content's own cache is skipped: it may rightly hold this account.
cached_account() { lower "$(jq -r '.account.id // empty' "$1" 2> /dev/null || true)"; }
while IFS= read -r cached; do
  if [ "$(cached_account "$cached")" = "$account" ]; then
    refuse "the configuration's account is the one a wrangler login used in ${cached#"$root"/}. The content Worker goes on an account no login here uses."
  fi
done < <(find "$root/apps" -mindepth 1 -maxdepth 5 -path "$root/apps/content" -prune -o \( -path '*/node_modules/.cache/wrangler/*' -o -path '*/.wrangler/cache/*' \) -name 'wrangler-account*.json' -type f -print 2> /dev/null)
if [ -n "$DC_CALLER_CACHE_DIR" ]; then
  for cached in "$DC_CALLER_CACHE_DIR"/wrangler-account*.json; do
    [ -f "$cached" ] || continue
    if [ "$(cached_account "$cached")" = "$account" ]; then refuse "the configuration's account is the one cached in WRANGLER_CACHE_DIR by a wrangler login"; fi
  done
fi

# --- the checkout ---
git fetch --quiet origin || refuse "could not fetch origin"
if git symbolic-ref -q HEAD > /dev/null; then
  refuse "the checkout is on branch $(git symbolic-ref --short HEAD). Detach at main's tip: git checkout --detach origin/main"
fi
here=$(git rev-parse HEAD)
tip=$(git rev-parse --verify --quiet origin/main) || refuse "origin/main doesn't exist"
if [ "$here" != "$tip" ]; then refuse "the checkout is at $here, and origin/main is at $tip"; fi
if [ -n "$(git status --porcelain)" ]; then refuse "the checkout has changed or untracked files"; fi
ci=$(gh run list --workflow ci.yml --branch main --event push --commit "$here" --limit 1 --json status,conclusion \
  --jq '.[] | [.status, (if (.conclusion // "") == "" then "none" else .conclusion end)] | @tsv') \
  || refuse "could not read ci.yml's run on main for $here"
if [ -z "$ci" ]; then refuse "ci.yml has no run on main for $here"; fi
IFS=$'\t' read -r ci_status ci_conclusion <<< "$ci"
if [ "$ci_status" != completed ]; then refuse "ci.yml's run on main for $here is still $ci_status"; fi
if [ "$ci_conclusion" != success ]; then refuse "ci.yml's run on main for $here ended as $ci_conclusion, not success"; fi
if [ -e apps/content/.wrangler/deploy/config.json ] || [ -L apps/content/.wrangler/deploy/config.json ]; then
  refuse "apps/content/.wrangler/deploy/config.json exists: it would point wrangler at another configuration. Remove it."
fi
# Wrangler 4.157.0 loads .env and .env.local from its working directory into its own environment, whatever git
# ignores. It runs from a folder of this script's own with --env-file at an empty file, so none is read; a file here
# is refused all the same, so nothing in the package can be mistaken for the deploy's configuration.
for envfile in apps/content/.env apps/content/.env.*; do
  if [ -e "$envfile" ] || [ -L "$envfile" ]; then refuse "${envfile} exists. Remove it: no .env file belongs in apps/content."; fi
done
# The outbound Worker's package, the same way: it deploys with its own wrangler, from the same kind of folder.
if [ -e apps/outbound/.wrangler/deploy/config.json ] || [ -L apps/outbound/.wrangler/deploy/config.json ]; then
  refuse "apps/outbound/.wrangler/deploy/config.json exists: it would point wrangler at another configuration. Remove it."
fi
for envfile in apps/outbound/.env apps/outbound/.env.*; do
  if [ -e "$envfile" ] || [ -L "$envfile" ]; then refuse "${envfile} exists. Remove it: no .env file belongs in apps/outbound."; fi
done

for app in content outbound; do
  step "npm ci in apps/$app"
  (cd "apps/$app" && npm ci --ignore-scripts) || refuse "npm ci failed in apps/$app"
  wrangler_version=$(cd "apps/$app" && node_modules/.bin/wrangler --version 2> /dev/null | grep -o -E '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1 || true)
  [ "$wrangler_version" = 4.157.0 ] || refuse "apps/$app's wrangler is '${wrangler_version:-missing}', not 4.157.0"
done

# --- Cloudflare's API, read with the token ---
# curl_clean ARG...: curl with -q first, so no .curlrc is read, and an environment of PATH and an empty home alone, so
# no proxy, no CURL_HOME and nothing else of the caller's reaches it.
curl_clean() { /usr/bin/env -i PATH="$PATH" HOME="$work/curl-home" curl -q "$@"; }
# cf PATH: GETs Cloudflare's API, and sets $status. The Authorization header goes to curl on stdin, built from the
# token file inside the pipe. The body is left in $work/body. Called directly, never in a subshell, so a refusal here
# ends the script.
cf() {
  : > "$work/body"
  { printf 'header = "Authorization: Bearer '; tr -d '\n' < "$token_file"; printf '"\n'; } \
    | curl_clean --config - --silent --show-error --proto =https --max-time 30 -X GET -o "$work/body" -w '%{http_code}' \
      "https://api.cloudflare.com/client/v4$1" > "$work/status" 2> "$work/curl.err" || echo 000 > "$work/status"
  status=$(cat "$work/status")
  [[ "$status" =~ ^[0-9]{3}$ ]] || status=000
  if leaked "$work/body" "$work/curl.err" "$work/status"; then
    redact "$work/body"
    if [ "$phase" = checking ]; then refuse "Cloudflare's answer to GET $1 held the token. It wasn't printed."; fi
    echo "STOPPED Cloudflare's answer to GET $1 held the token. It wasn't printed."
    if [ "$phase" = routing ]; then
      echo "deploy-content: stopped while adding the routes that run no Worker, before either Worker was deployed. Make a new token."
    elif [ "$phase" = deploying-outbound ]; then
      echo "deploy-content: stopped after deploying $OUTBOUND and before the content Worker: the content Worker was NOT deployed. $OUTBOUND is NOT verified. Make a new token."
    else
      echo "deploy-content: stopped after deploying, while $phase. What was deployed is NOT verified. Make a new token."
    fi
    dc_meant=1
    exit 3
  fi
}
# cf_send METHOD PATH JSON-FILE: sends the file to Cloudflare's API with METHOD (POST or PATCH), the same way as cf, and
# sets $status. The writes this script makes outside wrangler, all before either Worker deploys: a route that runs no
# Worker, which wrangler can't make, and the zone's rate limiting rule.
cf_send() {
  : > "$work/body"
  { printf 'header = "Authorization: Bearer '; tr -d '\n' < "$token_file"; printf '"\n'; } \
    | curl_clean --config - --silent --show-error --proto =https --max-time 30 -X "$1" -H 'Content-Type: application/json' \
      --data-binary "@$3" -o "$work/body" -w '%{http_code}' \
      "https://api.cloudflare.com/client/v4$2" > "$work/status" 2> "$work/curl.err" || echo 000 > "$work/status"
  status=$(cat "$work/status")
  [[ "$status" =~ ^[0-9]{3}$ ]] || status=000
  if leaked "$work/body" "$work/curl.err" "$work/status"; then
    redact "$work/body"
    echo "STOPPED Cloudflare's answer to $1 $2 held the token. It wasn't printed."
    if [ "$phase" = ratelimiting ]; then
      echo "deploy-content: stopped while writing the zone's rate limiting rule, before either Worker was deployed. Make a new token."
    else
      echo "deploy-content: stopped while adding the routes that run no Worker, before either Worker was deployed. Make a new token."
    fi
    dc_meant=1
    exit 3
  fi
}
cf_post() { cf_send POST "$1" "$2"; }
# shaped FILTER [ARG...]: the body is a success in exactly the shape FILTER describes. jq's arguments follow the filter.
# one_document FILTER [ARG...]: the body is exactly one JSON document, and FILTER holds of it. jq's -e alone judges
# only the last document of a stream, so `{"success":false}{...}` would pass; slurped, there must be one.
one_document() {
  local filter=$1
  shift
  jq -e -s "$@" "length == 1 and (.[0] | ($filter))" "$work/body" > /dev/null 2>&1
}
# shaped FILTER [ARG...]: one document, a success, in exactly the shape FILTER describes.
shaped() {
  local filter=$1
  shift
  one_document ".success == true and ($filter)" "$@"
}
ARRAY='(.result | type) == "array"'
TOKEN_SHAPE='(.result | type) == "object" and (.result.id | type) == "string" and (.result.status | type) == "string"'
ACCOUNTS_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.id | type) == "string")'
ZONES_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.id | type) == "string" and (.name | type) == "string" and (.status | type) == "string" and (.account | type) == "object" and (.account.id | type) == "string")'
SCRIPTS_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.id | type) == "string")'
# A route's script may be absent or null: a route that runs no Worker.
ROUTES_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.pattern | type) == "string" and ((.script // "") | type) == "string")'
# A Worker's custom domains on the account: each names the Worker it runs as its service.
DOMAINS_SHAPE="$ARRAY"' and all(.result[]; type == "object" and (.hostname | type) == "string" and (.service | type) == "string")'
OUTBOUND=podster-outbound

step "reading Cloudflare's API with the token"
cf /user/tokens/verify
token_scope=user
if [ "$status" != 200 ] || ! shaped "$TOKEN_SHAPE"; then
  cf "/accounts/$account/tokens/verify"
  token_scope=account
  [ "$status" = 200 ] || refuse "Cloudflare doesn't verify the token (HTTP $status)"
  shaped "$TOKEN_SHAPE" || refuse "Cloudflare's verification of the token isn't in the shape expected"
fi
[ "$(jq -r .result.status "$work/body")" = active ] || refuse "the token isn't active"
token_id=$(jq -r .result.id "$work/body")
[[ "$token_id" =~ ^[0-9a-f]{32}$ ]] || refuse "Cloudflare's verification didn't name the token"
echo "ok   the token is active ($token_scope token)"

if [ "$token_scope" = user ]; then cf "/user/tokens/$token_id"; else cf "/accounts/$account/tokens/$token_id"; fi
# Judged on the answer's shape as well as its status: a token Cloudflare let read itself, or a refusal in Cloudflare's
# own form. Anything else says neither, and refuses.
case "$status" in
  200)
    if shaped '(.result | type) == "object"'; then
      refuse "the token can read API tokens, its own included. That is more than a deploy needs: make one with only the permissions docs/content-deploy.md lists."
    fi
    refuse "asking whether the token can read API tokens answered HTTP 200 with an answer of another shape, which says neither"
    ;;
  401 | 403)
    one_document '.success == false and (.errors | type) == "array"' \
      || refuse "asking whether the token can read API tokens answered HTTP $status with an answer of another shape, which says neither"
    echo "ok   the token can't read API tokens (HTTP $status). Its other permissions can't be read by the token itself: docs/content-deploy.md lists what to grant"
    ;;
  *) refuse "asking whether the token can read API tokens answered HTTP $status, which says neither" ;;
esac

cf "/accounts?per_page=50"
[ "$status" = 200 ] || refuse "listing the accounts the token sees failed (HTTP $status)"
shaped "$ACCOUNTS_SHAPE" || refuse "the list of accounts the token sees isn't in the shape expected"
seen=$(jq -r '[.result[].id | ascii_downcase] | join(" ")' "$work/body")
seen_count=$(jq -r '.result | length' "$work/body")
[ "$seen" = "$account" ] || refuse "the token must see exactly one account, the configuration's. It sees $seen_count account(s), and they aren't exactly that one."
echo "ok   the token sees exactly one account, the configuration's"

cf "/zones?name=podster.dev&per_page=50"
[ "$status" = 200 ] || refuse "asking whether the token sees podster.dev failed (HTTP $status)"
shaped "$ARRAY" || refuse "the answer about podster.dev isn't a list of zones, so it says nothing"
[ "$(jq -r '.result | length' "$work/body")" = 0 ] || refuse "the token can see the zone podster.dev. A content Worker's token must see nothing of Podster's own."
echo "ok   the token sees no zone named podster.dev"

cf "/zones?name=$domain&per_page=50"
[ "$status" = 200 ] || refuse "reading the content domain's zone failed (HTTP $status)"
shaped "$ZONES_SHAPE" || refuse "the answer about the content domain isn't a list of zones in the shape expected"
[ "$(jq -r '.result | length' "$work/body")" = 1 ] || refuse "the token doesn't see the content domain as one zone"
[ "$(jq -r '.result[0].name | ascii_downcase' "$work/body")" = "$domain" ] || refuse "the zone Cloudflare answered with isn't the content domain"
[ "$(jq -r '.result[0].account.id | ascii_downcase' "$work/body")" = "$account" ] || refuse "the content domain's zone isn't on the configuration's account"
[ "$(jq -r '.result[0].status' "$work/body")" = active ] || refuse "the content domain's zone isn't active yet ($(jq -r '.result[0].status' "$work/body"))"
zone_id=$(jq -r '.result[0].id | ascii_downcase' "$work/body")
[[ "$zone_id" =~ ^[0-9a-f]{32}$ ]] || refuse "Cloudflare's answer about the content domain's zone didn't give its ID"
echo "ok   the content domain is an active zone on that account"

cf "/accounts/$account/workers/dispatch/namespaces/$namespace"
[ "$status" = 200 ] || refuse "the dispatch namespace wasn't found on that account (HTTP $status)"
shaped '(.result | type) == "object" and .result.namespace_name == $n' --arg n "$namespace" || refuse "the answer about the dispatch namespace isn't that namespace"
echo "ok   the dispatch namespace exists"
cf "/accounts/$account/storage/kv/namespaces/$kv"
[ "$status" = 200 ] || refuse "the KV namespace wasn't found on that account (HTTP $status)"
shaped '(.result | type) == "object" and (.result.id | ascii_downcase) == $k' --arg k "$kv" || refuse "the answer about the KV namespace isn't that namespace"
echo "ok   the KV namespace exists"
if [ "$previews" = true ]; then
  cf "/accounts/$account/workers/dispatch/namespaces/$preview_namespace"
  [ "$status" = 200 ] || refuse "the preview namespace wasn't found on that account (HTTP $status)"
  shaped '(.result | type) == "object" and .result.namespace_name == $n' --arg n "$preview_namespace" || refuse "the answer about the preview namespace isn't that namespace"
  echo "ok   the preview namespace exists"
else
  echo "ok   the configuration names no preview namespace: previews stay off"
fi

# The outbound Worker: whether it exists yet, and that no route on the content domain's zone runs it. A deploy with no
# route leaves a script's existing routes alone, so one made by hand would outlive every deploy: it is refused here.
cf "/accounts/$account/workers/scripts"
[ "$status" = 200 ] || refuse "listing the account's Worker scripts failed (HTTP $status)"
shaped "$SCRIPTS_SHAPE" || refuse "the list of the account's Worker scripts isn't in the shape expected"
if jq -e --arg o "$OUTBOUND" 'any(.result[]; .id == $o)' "$work/body" > /dev/null; then
  echo "ok   the account's scripts can be listed: $OUTBOUND exists, and the deploy replaces it"
else
  echo "ok   the account's scripts can be listed: $OUTBOUND doesn't exist yet, and the deploy makes it"
fi
cf "/zones/$zone_id/workers/routes"
[ "$status" = 200 ] || refuse "listing the routes on the content domain's zone failed (HTTP $status)"
shaped "$ROUTES_SHAPE" || refuse "the list of routes on the content domain's zone isn't in the shape expected"
if jq -e --arg o "$OUTBOUND" 'any(.result[]; (.script // "") == $o)' "$work/body" > /dev/null; then
  refuse "a route on the content domain's zone runs $OUTBOUND. The outbound Worker has no route: remove it."
fi
echo "ok   no route on the content domain's zone runs $OUTBOUND"
# The content Worker's two routes, both on the content domain's zone and nowhere else: `*.<domain>/*`, an app's default
# hosts, and `*/*`, every host that enters the zone, which is how a custom hostname of Cloudflare for SaaS reaches a
# Worker (M6 step 8c; ADR 0010; Cloudflare's "Workers as your fallback origin"). `*/*` takes the whole zone, so the
# content Worker decides every host there, and its own not-found is the answer for any host with no live serve entry.
# Any route on the zone that runs another Worker would take hosts from it, so it refuses here; a route of
# podster-content's with another pattern was made outside this script, which wouldn't track it, so it refuses too. A
# route that runs no Worker only hands its hosts back to the zone, which has no origin of its own, and is left alone.
CONTENT=podster-content
route_default="*.$domain/*"
route_all="*/*"
# And two routes that run no Worker, on the two folders a certificate authority reads to validate a name over HTTP:
# under `*/*` a custom hostname's validation would otherwise reach the content Worker, and through it an app. A route
# with no Worker "will act to negate any less specific patterns" (Cloudflare's Workers routes page), so Cloudflare's
# edge answers its own validations there. Wrangler only makes routes that run its Worker, so these are made with the
# zone's routes API (POST /zones/<zone>/workers/routes, `script` left out), which takes Workers Routes Edit on the zone. The content Worker refuses those paths too (`isValidationPath`), and a release
# can't hold files there (`podster_core::release_tree::VALIDATION_DIRECTORIES`).
route_acme="*/.well-known/acme-challenge/*"
route_pki="*/.well-known/pki-validation/*"
if jq -e --arg c "$CONTENT" --arg o "$OUTBOUND" 'any(.result[]; (.script // "") as $s | $s != "" and $s != $c and $s != $o)' "$work/body" > /dev/null; then
  refuse "a route on the content domain's zone runs a Worker other than $CONTENT. Every host on that zone is the content Worker's to answer: remove that route."
fi
echo "ok   no route on the content domain's zone runs another Worker"
if jq -e --arg c "$CONTENT" --arg a "$route_default" --arg b "$route_all" 'any(.result[]; (.script // "") == $c and .pattern != $a and .pattern != $b)' "$work/body" > /dev/null; then
  refuse "a route on the content domain's zone runs $CONTENT under a pattern other than $route_default and $route_all. It was made outside this script: remove it."
fi
echo "ok   $CONTENT has no route on the content domain's zone beyond the two this script deploys"
bypass_missing=()
for pattern in "$route_acme" "$route_pki"; do
  if jq -e --arg p "$pattern" 'any(.result[]; .pattern == $p and (.script // "") == "")' "$work/body" > /dev/null; then
    echo "ok   the zone already holds $pattern, running no Worker"
  else
    bypass_missing+=("$pattern")
    echo "ok   the zone has no route $pattern yet: a deploy adds it, running no Worker"
  fi
done
# Nor any custom domain on the account: a custom domain is a way in that no route list shows, and a deploy with none
# leaves an existing one alone. If the token can't read them, that is said, and a deploy's check of them exits 4.
report_not_shown=0
cf "/accounts/$account/workers/domains"
if [ "$status" = 200 ] && shaped "$DOMAINS_SHAPE"; then
  if jq -e --arg o "$OUTBOUND" 'any(.result[]; .service == $o)' "$work/body" > /dev/null; then
    refuse "a custom domain on the account runs $OUTBOUND. The outbound Worker has no custom domain: remove it."
  fi
  echo "ok   no custom domain on the account runs $OUTBOUND"
else
  report_not_shown=$((report_not_shown + 1))
  echo "NOT SHOWN whether a custom domain runs $OUTBOUND: the account's custom domains couldn't be read in the shape expected (HTTP $status). A deploy would end with exit 4, not verified, until the token can read them."
fi

# --- the zone's rate limiting rule ---
# One WAF rate limiting rule on the content domain's zone, the request-rate abuse control for every app and custom
# hostname, which all enter through that zone (approved by the owner 2026-11-26, as one free-plan rule). The free plan
# allows one rule per zone, counted by IP (characteristics cf.colo.id and ip.src, both required), a 10 s period and a
# 10 s mitigation timeout, and an expression on the path only, with no regex (`matches` is Business and up). The
# expression leaves out the two certificate validation folders, so issuing or renewing a certificate is never limited.
# It lives in the zone's http_ratelimit entry point ruleset (Rulesets API), and this script's rule is the one whose ref
# is RL_REF: it creates or updates that rule alone, and never changes or deletes another.
RL_REF=podster_content_rate_limit
RL_DESCRIPTION="Podster: requests per IP to every app and custom hostname, managed by scripts/deploy-content"
RL_EXPRESSION='(not starts_with(http.request.uri.path, "/.well-known/acme-challenge/") and not starts_with(http.request.uri.path, "/.well-known/pki-validation/"))'
RL_REQUESTS=300
RL_PERIOD=10
RL_TIMEOUT=10
RL_PERMISSION="Zone > Zone WAF > Edit, on the content domain's zone only"
rl_rule=$(jq -c -n --arg ref "$RL_REF" --arg d "$RL_DESCRIPTION" --arg e "$RL_EXPRESSION" \
  --argjson n "$RL_REQUESTS" --argjson p "$RL_PERIOD" --argjson t "$RL_TIMEOUT" '{
    ref: $ref, description: $d, expression: $e, action: "block", enabled: true,
    ratelimit: { characteristics: ["cf.colo.id", "ip.src"], period: $p, requests_per_period: $n, mitigation_timeout: $t }
  }')
# A rule is this script's rule as it deploys it: the same action, expression, description and figures, enabled, the same
# two characteristics in any order, and nothing that changes what is counted (no counting expression, no cache
# exclusion). Fields Cloudflare adds of its own (id, version, last_updated, requests_to_origin false) are ignored.
RL_MATCHES='(type == "object") and .action == $w.action and .expression == $w.expression and (.description // "") == $w.description
  and (if has("enabled") then .enabled else true end) == true and (.ratelimit | type) == "object" and (.ratelimit.characteristics | type) == "array"
  and (.ratelimit.characteristics | sort) == ($w.ratelimit.characteristics | sort) and .ratelimit.period == $w.ratelimit.period
  and .ratelimit.requests_per_period == $w.ratelimit.requests_per_period and .ratelimit.mitigation_timeout == $w.ratelimit.mitigation_timeout
  and ((.ratelimit.counting_expression // "") == "") and ((.ratelimit.requests_to_origin // false) == false)'
# The entry point ruleset: an object with an ID, of the http_ratelimit phase, whose rules (absent when it has none) are
# a list of objects, each with an ID.
RL_ENTRY_SHAPE='(.result | type) == "object" and (.result.id | type) == "string" and .result.phase == "http_ratelimit"
  and ((.result.rules // []) | type) == "array" and all((.result.rules // [])[]; type == "object" and (.id | type) == "string")'
# ours_in_result: exactly one rule with RL_REF in the answer's ruleset, and it matches.
RL_OURS_IN_RESULT='[(.result.rules // [])[] | select(.ref == $ref)] | length == 1 and (.[0] | '"$RL_MATCHES"')'
rl_entry="/zones/$zone_id/rulesets/phases/http_ratelimit/entrypoint"
rl_ruleset_id=""
rl_rule_id=""
rl_state=""
cf "$rl_entry"
case "$status" in
  200)
    shaped "$RL_ENTRY_SHAPE" || refuse "the zone's rate limiting rules (its http_ratelimit entry point) aren't in the shape expected"
    rl_ruleset_id=$(jq -r '.result.id | ascii_downcase' "$work/body")
    [[ "$rl_ruleset_id" =~ ^[0-9a-f]{32}$ ]] || refuse "the zone's rate limiting ruleset has no ruleset ID in the shape expected"
    rl_ours=$(jq -r --arg ref "$RL_REF" '[(.result.rules // [])[] | select(.ref == $ref)] | length' "$work/body")
    rl_others=$(jq -r --arg ref "$RL_REF" '[(.result.rules // [])[] | select(.ref != $ref)] | length' "$work/body")
    if [ "$rl_ours" -gt 1 ]; then refuse "the zone has $rl_ours rate limiting rules with the ref $RL_REF, which is this script's alone. Remove all but one in the dashboard."; fi
    if [ "$rl_ours" = 1 ]; then
      rl_rule_id=$(jq -r --arg ref "$RL_REF" '(.result.rules // [])[] | select(.ref == $ref) | .id | ascii_downcase' "$work/body")
      [[ "$rl_rule_id" =~ ^[0-9a-f]{32}$ ]] || refuse "the zone's rate limiting rule $RL_REF has no rule ID in the shape expected"
      if jq -e --arg ref "$RL_REF" --argjson w "$rl_rule" "$RL_OURS_IN_RESULT" "$work/body" > /dev/null; then rl_state=matching; else rl_state=different; fi
    else
      rl_state=missing
      if [ "$rl_others" -gt 0 ]; then
        refuse "the content domain's zone already has $rl_others rate limiting rule(s) that aren't this script's ($RL_REF), and the free plan allows one per zone, so adding it would pass that limit. This script never changes or removes another's rule: remove that rule in the dashboard (the zone's Security rules) if it is to go, then run this again."
      fi
    fi
    if [ "$rl_others" -gt 0 ]; then echo "ok   $rl_others other rate limiting rule(s) on the zone, left alone"; fi
    ;;
  404)
    # No entry point yet: no rate limiting rule on the zone at all. Cloudflare's own not-found, or it says nothing.
    one_document '.success == false and (.errors | type) == "array"' \
      || refuse "reading the zone's rate limiting rules answered HTTP 404 with an answer of another shape, which says nothing"
    rl_state=missing
    ;;
  401 | 403)
    refuse "the token can't read the content domain's zone's rate limiting rules (HTTP $status), so it can't make or check the rule either. Add this permission to the token: $RL_PERMISSION (Zone WAF Write in Cloudflare's list of permissions; Edit includes Read). Then run this again."
    ;;
  *) refuse "reading the content domain's zone's rate limiting rules failed (HTTP $status)" ;;
esac
case "$rl_state" in
  matching) echo "ok   the zone's rate limiting rule $RL_REF: matching, nothing to change" ;;
  different) echo "ok   the zone's rate limiting rule $RL_REF: different from this script's, a deploy updates that rule alone" ;;
  missing) echo "ok   the zone's rate limiting rule $RL_REF: missing, a deploy adds it" ;;
esac

# --- what would be deployed ---
# The committed file gives the Worker's name, entry point and compatibility date, the write counter (its binding and its
# migration) and the write cap's two settings (M6 stage 1, S6), and nothing else. Each of those is taken only in the
# exact shape S6 committed: anything else refuses, so a deploy from here never makes another class, binds another
# object or runs with a cap the content Worker would read as none.
committed=$(node --input-type=module -e '
import { readFileSync } from "node:fs";
import { parseJsonc } from "./e2e/jsonc.mjs";
const c = parseJsonc(readFileSync("apps/content/wrangler.jsonc", "utf8"));
process.stdout.write(JSON.stringify({ name: c.name, main: c.main, compatibility_date: c.compatibility_date,
  durable_objects: c.durable_objects ?? null, migrations: c.migrations ?? null,
  writes: c.vars?.WRITE_BUDGET_WRITES ?? null, window_ms: c.vars?.WRITE_BUDGET_WINDOW_MS ?? null,
  cpu_ms: c.vars?.APP_LIMIT_CPU_MS ?? null, subrequests: c.vars?.APP_LIMIT_SUBREQUESTS ?? null }));
') || refuse "couldn't read apps/content/wrangler.jsonc"
[ "$(jq -r .name <<< "$committed")" = podster-content ] || refuse "apps/content/wrangler.jsonc doesn't name the Worker podster-content"
jq -e '.durable_objects == {"bindings": [{"name": "WRITE_COUNTER", "class_name": "WriteCounter"}]}' <<< "$committed" > /dev/null \
  || refuse "apps/content/wrangler.jsonc's durable_objects isn't exactly the write counter, WRITE_COUNTER of this Worker's own class WriteCounter"
jq -e '.migrations == [{"tag": "v1", "new_sqlite_classes": ["WriteCounter"]}]' <<< "$committed" > /dev/null \
  || refuse "apps/content/wrangler.jsonc's migrations aren't exactly v1, making WriteCounter a SQLite-backed class"
# Exactly what the content Worker's `capFromSettings` (apps/content/src/budget.ts) takes as a cap, and nothing it would
# read as none: decimal strings with no sign and no leading zero; writes from 0 to 4294967295 (core's u32), the window
# from 1 to 9223372036854775807 (core's i64). Compared as strings, by length and then digit by digit, never as jq's
# floating-point numbers, which can't hold the bounds exactly.
jq -e '(.writes | type == "string" and test("^(0|[1-9][0-9]{0,9})$") and (length < 10 or . <= "4294967295"))
  and (.window_ms | type == "string" and test("^[1-9][0-9]{0,18}$") and (length < 19 or . <= "9223372036854775807"))' <<< "$committed" > /dev/null \
  || refuse "apps/content/wrangler.jsonc's WRITE_BUDGET_WRITES and WRITE_BUDGET_WINDOW_MS must be decimal strings the content Worker takes as a cap: writes 0 to 4294967295, the window 1 to 9223372036854775807"
# Exactly what the content Worker's `limitsFromSettings` (apps/content/src/limits.ts) takes as a dispatch's limits, and
# nothing it would read as none: decimal strings with no sign and no leading zero; the CPU time 1 to 300000 ms (the
# platform's maximum, compared as a string by length and then digit by digit), the subrequests 0 to 999999999. Without them every request to an app with code would be refused.
jq -e '(.cpu_ms | type == "string" and test("^[1-9][0-9]{0,5}$") and (length < 6 or . <= "300000"))
  and (.subrequests | type == "string" and test("^(0|[1-9][0-9]{0,8})$"))' <<< "$committed" > /dev/null \
  || refuse "apps/content/wrangler.jsonc's APP_LIMIT_CPU_MS and APP_LIMIT_SUBREQUESTS must be decimal strings the content Worker takes as a dispatch's limits: CPU 1 to 300000 ms, subrequests 0 to 999999999"
# The outbound Worker's committed file: exactly its six keys, its name, both public addresses off. Its placeholder
# account is never used: the deploy's configuration carries the owner's. Nothing else is taken from it.
outbound_committed=$(node --input-type=module -e '
import { readFileSync } from "node:fs";
import { parseJsonc } from "./e2e/jsonc.mjs";
process.stdout.write(JSON.stringify(parseJsonc(readFileSync("apps/outbound/wrangler.jsonc", "utf8"))));
') || refuse "couldn't read apps/outbound/wrangler.jsonc"
jq -e --arg o "$OUTBOUND" '(keys == ["account_id", "compatibility_date", "main", "name", "preview_urls", "workers_dev"])
  and .name == $o and .workers_dev == false and .preview_urls == false
  and .main == "src/index.ts" and (.compatibility_date | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))' <<< "$outbound_committed" > /dev/null \
  || refuse "apps/outbound/wrangler.jsonc must hold exactly its name $OUTBOUND, entry point src/index.ts, compatibility date, placeholder account and both public addresses off, and nothing else: no route and no binding"
writes=$(jq -r .writes <<< "$committed")
window_ms=$(jq -r .window_ms <<< "$committed")
cpu_ms=$(jq -r .cpu_ms <<< "$committed")
subrequests=$(jq -r .subrequests <<< "$committed")
jq -n --argjson c "$committed" --arg main "$root/apps/content/$(jq -r .main <<< "$committed")" --arg account "$account" \
  --arg domain "$domain" --arg route "$route_default" --arg all "$route_all" --arg kv "$kv" --arg namespace "$namespace" --arg outbound "$OUTBOUND" '{
    name: $c.name, main: $main, compatibility_date: $c.compatibility_date, account_id: $account,
    workers_dev: false, preview_urls: false,
    routes: [{ pattern: $route, zone_name: $domain }, { pattern: $all, zone_name: $domain }],
    vars: { CONTENT_DOMAIN: $domain, WRITE_BUDGET_WRITES: $c.writes, WRITE_BUDGET_WINDOW_MS: $c.window_ms,
            APP_LIMIT_CPU_MS: $c.cpu_ms, APP_LIMIT_SUBREQUESTS: $c.subrequests },
    kv_namespaces: [{ binding: "SERVE", id: $kv }],
    dispatch_namespaces: [{ binding: "APPS", namespace: $namespace, outbound: { service: $outbound } }],
    durable_objects: $c.durable_objects,
    migrations: $c.migrations
  }' > "$work/wrangler.json"
# Previews, only when configured: the preview namespace's binding, with the same outbound Worker, and its two variables.
if [ "$previews" = true ]; then
  jq --arg pn "$preview_namespace" --arg keys "$preview_keys" --arg origin "$preview_origin" --arg outbound "$OUTBOUND" '
    .dispatch_namespaces += [{ binding: "PREVIEW_APPS", namespace: $pn, outbound: { service: $outbound } }]
    | .vars += { PREVIEW_PUBLIC_KEYS: $keys, PREVIEW_ACCESS_ORIGIN: $origin }' "$work/wrangler.json" > "$work/wrangler.json.next"
  mv "$work/wrangler.json.next" "$work/wrangler.json"
fi
# The outbound Worker's: name, entry point and compatibility date from its file, the owner's account, both public
# addresses off, and nothing else. No route, no binding, no variable.
jq -n --argjson c "$outbound_committed" --arg main "$root/apps/outbound/$(jq -r .main <<< "$outbound_committed")" --arg account "$account" '{
    name: $c.name, main: $main, compatibility_date: $c.compatibility_date, account_id: $account,
    workers_dev: false, preview_urls: false
  }' > "$work/wrangler-outbound.json"

echo
echo "would deploy, first, $OUTBOUND at $here to the configuration's account, with no route, no workers.dev"
echo "address, no preview address and no binding: the dispatch namespace's outbound Worker, which refuses every request."
echo "then it would deploy podster-content at $here, origin/main's tip with ci.yml green, to the configuration's account,"
echo "on the routes $route_default and $route_all, both on the content domain's zone only, with the content domain $domain, its KV namespace and its dispatch namespace,"
echo "the dispatch binding APPS naming $OUTBOUND as the namespace's outbound Worker,"
echo "and its write counter (migration v1, the class WriteCounter) with a cap of $writes writes per $window_ms ms for each app."
echo "Each dispatch to an app with code is limited to $cpu_ms CPU ms and $subrequests subrequests."
if [ "$previews" = true ]; then
  echo "Previews on: the binding PREVIEW_APPS to the preview namespace $preview_namespace, naming $OUTBOUND as outbound, $(tr -cd , <<< "$preview_keys" | wc -c | awk '{print $1 + 1}') public key(s) by ID ($(tr ',' '\n' <<< "$preview_keys" | cut -d: -f1 | paste -sd ' ' -)), and the application host $preview_origin."
else
  echo "Previews off: no binding PREVIEW_APPS, no public key and no application host."
fi
echo "Before either Worker, it would make sure the zone holds $route_acme and $route_pki, each running no Worker."
echo "Before either Worker, too, it would make sure the zone's rate limiting rule $RL_REF is $RL_REQUESTS requests per $RL_PERIOD s per IP, blocked for $RL_TIMEOUT s, outside the two validation folders ($rl_state now)."
echo "No other route, no workers.dev address and no preview address."

if [ "$deploy" != true ]; then
  echo
  if [ "$report_not_shown" -ne 0 ]; then
    echo "deploy-content: every check that could be read passed, and $report_not_shown was NOT SHOWN (above). Nothing was deployed: this run had no --deploy."
  else
    echo "deploy-content: every check passed. Nothing was deployed: this run had no --deploy."
  fi
  dc_meant=1
  exit 0
fi

# --- a person confirms ---
if [ ! -t 0 ] || [ ! -t 1 ]; then
  refuse "--deploy needs a person at a terminal: stdin and stdout must both be terminals. Agents run this without --deploy."
fi
printf '\nTo deploy, type the content domain (%s): ' "$domain"
IFS= read -r typed || typed=""
[ "$typed" = "$domain" ] || refuse "what was typed isn't the content domain"

# --- the deploy ---
mkdir -m 700 "$work/home" "$work/cache" "$work/xdg"
: > "$work/empty.env"
# wrangler_deploy WHICH APP CONFIG: runs APP's own pinned wrangler on CONFIG, leaving its output in $work/deploy-WHICH.out
# and its log in $work/logs-WHICH, and sets deploy_status. env -i with an allow-list: nothing of the caller's
# environment, exported functions included, reaches wrangler. The small shell reads the token on its stdin, from the
# file, so it is in no command's arguments, and exports it to wrangler alone. It runs from $work/run-WHICH, an empty
# folder of the script's own, with --env-file at an empty file, so wrangler reads no .env.
wrangler_deploy() {
  local which=$1 app=$2 config=$3
  mkdir -m 700 "$work/logs-$which" "$work/run-$which"
  deploy_status=0
  /usr/bin/env -i PATH="$PATH" HOME="$work/home" XDG_CONFIG_HOME="$work/xdg" WRANGLER_CACHE_DIR="$work/cache" \
    WRANGLER_LOG_PATH="$work/logs-$which" WRANGLER_SEND_METRICS=false CI=true \
    /bin/bash --noprofile --norc -c 'set -eu; IFS= read -r CLOUDFLARE_API_TOKEN; export CLOUDFLARE_API_TOKEN; cd "$1"; exec "$2" deploy --config "$3" --env-file "$4" < /dev/null' \
    deploy-content "$work/run-$which" "$root/apps/$app/node_modules/.bin/wrangler" "$config" "$work/empty.env" \
    < "$token_file" > "$work/deploy-$which.out" 2>&1 || deploy_status=$?
}
# deployed_output WHICH WHAT-ELSE: prints wrangler's output, redacted, and stops with exit 3 if it or the log held the
# token or wrangler failed. WHAT-ELSE says what that means for the other Worker.
deployed_output() {
  local which=$1 else_said=$2 logs
  logs=$(find "$work/logs-$which" -type f 2> /dev/null || true)
  # shellcheck disable=SC2086
  if leaked "$work/deploy-$which.out" $logs; then
    redact "$work/deploy-$which.out"
    sed 's/^/        | /' "$work/deploy-$which.out"
    echo
    echo "STOPPED wrangler's output or its log held the token. It was redacted above and not printed."
    echo "deploy-content: the $which Worker may or may not be deployed. $else_said Read wrangler's output above, and make a new token."
    dc_meant=1
    exit 3
  fi
  sed 's/^/        | /' "$work/deploy-$which.out"
  if [ "$deploy_status" -ne 0 ]; then
    echo
    echo "STOPPED wrangler deploy of the $which Worker exited with status $deploy_status"
    echo "deploy-content: the deploy failed part-way. $else_said Read wrangler's output above for what changed."
    dc_meant=1
    exit 3
  fi
}

# First the routes that run no Worker, so no deploy of `*/*` ever runs without them. Each that the zone lacks is added
# by the zone's routes API; its answer must be that very route, with no Worker.
phase=routing
if [ "${#bypass_missing[@]}" -gt 0 ]; then
  step "adding the routes that run no Worker"
  for pattern in "${bypass_missing[@]}"; do
    jq -n --arg p "$pattern" '{pattern: $p}' > "$work/route.json"
    cf_post "/zones/$zone_id/workers/routes" "$work/route.json"
    if [ "$status" != 200 ] || ! shaped '(.result | type) == "object" and .result.pattern == $p and ((.result.script // "") == "")' --arg p "$pattern"; then
      echo
      echo "STOPPED adding the route $pattern answered HTTP $status, not that route with no Worker."
      echo "deploy-content: neither Worker was deployed. Check the zone's routes before running this again."
      dc_meant=1
      exit 3
    fi
    echo "ok      added $pattern, running no Worker"
  done
fi

# Then the zone's rate limiting rule, also before either Worker, so the zone is never served without it. Only this
# script's rule is written: added to the entry point (or the entry point made with it, when the zone has none), or
# updated by its own rule ID. Every answer is the ruleset, and must hold that rule exactly as sent.
phase=ratelimiting
if [ "$rl_state" != matching ]; then
  step "the zone's rate limiting rule"
  printf '%s\n' "$rl_rule" > "$work/ratelimit.json"
  if [ "$rl_state" = different ]; then
    rl_method=PATCH rl_path="/zones/$zone_id/rulesets/$rl_ruleset_id/rules/$rl_rule_id" rl_did=updated
  elif [ -n "$rl_ruleset_id" ]; then
    rl_method=POST rl_path="/zones/$zone_id/rulesets/$rl_ruleset_id/rules" rl_did=added
  else
    jq -n --argjson r "$rl_rule" '{name: "default", kind: "zone", phase: "http_ratelimit", rules: [$r]}' > "$work/ratelimit.json"
    rl_method=POST rl_path="/zones/$zone_id/rulesets" rl_did="added, with the zone's http_ratelimit entry point"
  fi
  cf_send "$rl_method" "$rl_path" "$work/ratelimit.json"
  if { [ "$status" != 200 ] && [ "$status" != 201 ]; } || ! shaped "$RL_ENTRY_SHAPE and ($RL_OURS_IN_RESULT)" --arg ref "$RL_REF" --argjson w "$rl_rule"; then
    echo
    echo "STOPPED writing the zone's rate limiting rule ($rl_method $rl_path) answered HTTP $status, not the ruleset holding that rule as sent."
    case "$status" in
      401 | 403) echo "deploy-content: the token may lack the permission to write it. Add this permission to the token: $RL_PERMISSION. Then run this again." ;;
    esac
    echo "deploy-content: neither Worker was deployed. Run this again: its report says whether the rule is missing, matching or different."
    dc_meant=1
    exit 3
  fi
  echo "ok      $rl_did the rate limiting rule $RL_REF: $RL_REQUESTS requests per $RL_PERIOD s per IP, blocked for $RL_TIMEOUT s"
fi

# Then the outbound Worker. The content Worker's binding names it, so the content Worker never deploys without it.
step "wrangler deploy: $OUTBOUND, the outbound Worker"
phase=deploying-outbound
wrangler_deploy outbound outbound "$work/wrangler-outbound.json"
deployed_output outbound "The content Worker wasn't deployed."
outbound_version=$(grep -o -E 'Current Version ID: [0-9a-f-]{36}' "$work/deploy-outbound.out" | head -n 1 | sed 's/.*: //' || true)
echo "version $OUTBOUND ${outbound_version:-not printed by wrangler}"

# It must be there, by Cloudflare's own list, before anything names it.
cf "/accounts/$account/workers/scripts"
if [ "$status" != 200 ] || ! shaped "$SCRIPTS_SHAPE" || ! jq -e --arg o "$OUTBOUND" 'any(.result[]; .id == $o)' "$work/body" > /dev/null; then
  echo
  echo "STOPPED Cloudflare's list of the account's scripts (HTTP $status) doesn't show $OUTBOUND after its deploy."
  echo "deploy-content: the content Worker wasn't deployed, since its binding would name an outbound Worker that isn't there. Check the account before running this again."
  dc_meant=1
  exit 3
fi
echo "ok      $OUTBOUND is on the account"

step "wrangler deploy: podster-content"
phase=deploying
wrangler_deploy content content "$work/wrangler.json"
deployed_output content "$OUTBOUND is deployed. The content Worker deployed before, if there is one, keeps serving as it was deployed: every deploy by this script names $OUTBOUND as its dispatch's outbound Worker, and one deployed without it had the code-apps switch off, so no app's code runs past it. Fix the cause and run this again."
version=$(grep -o -E 'Current Version ID: [0-9a-f-]{36}' "$work/deploy-content.out" | head -n 1 | sed 's/.*: //' || true)
echo "version podster-content ${version:-not printed by wrangler}"

# --- signed-out probes of the content domain ---
# scripts/content-probes holds them, so CI can run the same probes on their own. It waits for the route first, and
# prints a PASS or FAIL line for each; every FAIL counts here as one probe failed. If it stops some other way, that
# counts as one too: the probes didn't show the content domain is right.
phase=probing
step "probing $domain signed out"
probe_failures=0
pass() { echo "PASS    $*"; }
fail() { echo "FAIL    $*"; probe_failures=$((probe_failures + 1)); }
# not_shown WHAT: a check the deploy promises that couldn't be made. It is never a pass: the run ends with exit 4.
not_shown_count=0
not_shown() { echo "NOT SHOWN $*"; not_shown_count=$((not_shown_count + 1)); }
probes_code=0
"$root/scripts/content-probes" --wait-for-route "$domain" | tee "$work/probes.out" || probes_code=$?
# Always a number: no file, or an answer that isn't a count, is 0 FAILs here, and the exit code below still counts.
probe_failures=$(grep -c '^FAIL ' "$work/probes.out" 2> /dev/null || true)
[[ "$probe_failures" =~ ^[0-9]+$ ]] || probe_failures=0
if [ "$probes_code" -ne 0 ] && [ "$probe_failures" -eq 0 ]; then fail "scripts/content-probes stopped with exit $probes_code before judging every probe"; fi

# --- the outbound Worker, by Cloudflare's API with the token ---
step "checking $OUTBOUND and the dispatch binding by Cloudflare's API"
cf "/accounts/$account/workers/scripts"
if [ "$status" = 200 ] && shaped "$SCRIPTS_SHAPE" && jq -e --arg o "$OUTBOUND" 'any(.result[]; .id == $o)' "$work/body" > /dev/null; then
  pass "$OUTBOUND exists on the account"
else
  fail "$OUTBOUND isn't in the account's list of scripts (HTTP $status)"
fi
cf "/accounts/$account/workers/scripts/$OUTBOUND/subdomain"
if [ "$status" = 200 ] && shaped '(.result | type) == "object" and (.result.enabled | type) == "boolean"'; then
  if [ "$(jq -r .result.enabled "$work/body")" = false ]; then pass "$OUTBOUND has no workers.dev address"; else fail "$OUTBOUND is on workers.dev"; fi
  case "$(jq -r '.result.previews_enabled | if type == "boolean" then tostring else "unread" end' "$work/body")" in
    false) pass "$OUTBOUND has no preview address" ;;
    true) fail "$OUTBOUND has preview addresses on" ;;
    *) not_shown "whether $OUTBOUND has preview addresses: Cloudflare's answer didn't say" ;;
  esac
else
  fail "$OUTBOUND's workers.dev setting couldn't be read (HTTP $status): not verified"
fi
cf "/zones/$zone_id/workers/routes"
if [ "$status" = 200 ] && shaped "$ROUTES_SHAPE"; then
  if jq -e --arg o "$OUTBOUND" 'any(.result[]; (.script // "") == $o)' "$work/body" > /dev/null; then
    fail "a route on the content domain's zone runs $OUTBOUND"
  else
    pass "no route on the content domain's zone runs $OUTBOUND (the token sees no other zone, and can make routes on none)"
  fi
  # The content Worker's routes, as the zone holds them: exactly the two deployed, and no route of another Worker's.
  if jq -e --arg c "$CONTENT" --arg a "$route_default" --arg b "$route_all" \
      '[.result[] | select((.script // "") == $c) | .pattern] | sort == ([$a, $b] | sort)' "$work/body" > /dev/null; then
    pass "$CONTENT's routes on the content domain's zone are exactly $route_default and $route_all"
  else
    fail "$CONTENT's routes on the content domain's zone aren't exactly $route_default and $route_all"
  fi
  if jq -e --arg c "$CONTENT" --arg o "$OUTBOUND" 'any(.result[]; (.script // "") as $s | $s != "" and $s != $c and $s != $o)' "$work/body" > /dev/null; then
    fail "a route on the content domain's zone runs a Worker other than $CONTENT"
  else
    pass "no route on the content domain's zone runs a Worker other than $CONTENT"
  fi
  for pattern in "$route_acme" "$route_pki"; do
    if jq -e --arg p "$pattern" '[.result[] | select(.pattern == $p)] | length > 0 and all(.[]; (.script // "") == "")' "$work/body" > /dev/null; then
      pass "the zone holds $pattern, running no Worker"
    else
      fail "the zone doesn't hold $pattern running no Worker"
    fi
  done
else
  fail "the routes on the content domain's zone couldn't be read (HTTP $status): not verified"
fi
# The binding as Cloudflare holds it, from podster-content's deployed settings. An answer that can't be read, or isn't
# in the shape expected, is said so: never taken for a pass.
cf "/accounts/$account/workers/scripts/podster-content/settings"
if [ "$status" = 200 ] && shaped '(.result | type) == "object" and (.result.bindings | type) == "array"'; then
  apps_binding=$(jq -c '[.result.bindings[] | select(type == "object" and .name == "APPS")]' "$work/body")
  if jq -e --arg n "$namespace" --arg o "$OUTBOUND" 'length == 1 and (.[0] | .type == "dispatch_namespace" and .namespace == $n
      and (.outbound | type) == "object" and (.outbound.worker | type) == "object" and .outbound.worker.service == $o)' <<< "$apps_binding" > /dev/null; then
    pass "podster-content's deployed binding APPS names $OUTBOUND as the namespace's outbound Worker"
  else
    fail "podster-content's deployed settings have no binding APPS to the namespace naming $OUTBOUND as outbound"
  fi
  # The dispatch's limits, as the deployed Worker holds them: both plain-text variables, exactly the committed figures.
  # Without them every request to an app with code is refused, so a deploy that lost them is a failure.
  if jq -e --arg c "$cpu_ms" --arg s "$subrequests" '[.result.bindings[] | select(type == "object")] as $b
      | ([$b[] | select(.name == "APP_LIMIT_CPU_MS")] == [{"type": "plain_text", "name": "APP_LIMIT_CPU_MS", "text": $c}])
      and ([$b[] | select(.name == "APP_LIMIT_SUBREQUESTS")] == [{"type": "plain_text", "name": "APP_LIMIT_SUBREQUESTS", "text": $s}])' "$work/body" > /dev/null; then
    pass "podster-content's deployed limits for each dispatch to an app with code are $cpu_ms CPU ms and $subrequests subrequests"
  else
    fail "podster-content's deployed settings don't hold APP_LIMIT_CPU_MS $cpu_ms and APP_LIMIT_SUBREQUESTS $subrequests as plain text"
  fi
  # The preview binding, as configured: there with the preview namespace and the same outbound Worker, or not at all.
  preview_binding=$(jq -c '[.result.bindings[] | select(type == "object" and .name == "PREVIEW_APPS")]' "$work/body")
  if [ "$previews" = true ]; then
    if jq -e --arg n "$preview_namespace" --arg o "$OUTBOUND" 'length == 1 and (.[0] | .type == "dispatch_namespace" and .namespace == $n
        and (.outbound | type) == "object" and (.outbound.worker | type) == "object" and .outbound.worker.service == $o)' <<< "$preview_binding" > /dev/null; then
      pass "podster-content's deployed binding PREVIEW_APPS names the preview namespace and $OUTBOUND as its outbound Worker"
    else
      fail "podster-content's deployed settings have no binding PREVIEW_APPS to the preview namespace naming $OUTBOUND as outbound"
    fi
  elif [ "$preview_binding" = "[]" ]; then
    pass "podster-content has no deployed binding PREVIEW_APPS: previews are off"
  else
    fail "podster-content has a deployed binding PREVIEW_APPS, but the configuration names no preview namespace"
  fi
  # Previews' two variables, as the deployed Worker holds them: each plain text, exactly the configuration's, or, with
  # previews off, neither there at all. The keys are public halves and the origin a host, so both may be read back.
  if jq -e --argjson on "$previews" --arg k "$preview_keys" --arg o "$preview_origin" '[.result.bindings[] | select(type == "object")] as $b
      | ([$b[] | select(.name == "PREVIEW_PUBLIC_KEYS")] == (if $on then [{"type": "plain_text", "name": "PREVIEW_PUBLIC_KEYS", "text": $k}] else [] end))
      and ([$b[] | select(.name == "PREVIEW_ACCESS_ORIGIN")] == (if $on then [{"type": "plain_text", "name": "PREVIEW_ACCESS_ORIGIN", "text": $o}] else [] end))' "$work/body" > /dev/null; then
    if [ "$previews" = true ]; then pass "podster-content's deployed PREVIEW_PUBLIC_KEYS and PREVIEW_ACCESS_ORIGIN are the configuration's"; else pass "podster-content has no deployed PREVIEW_PUBLIC_KEYS or PREVIEW_ACCESS_ORIGIN: previews are off"; fi
  elif [ "$previews" = true ]; then
    fail "podster-content's deployed settings don't hold PREVIEW_PUBLIC_KEYS and PREVIEW_ACCESS_ORIGIN as the configuration's, as plain text"
  else
    fail "podster-content has a deployed PREVIEW_PUBLIC_KEYS or PREVIEW_ACCESS_ORIGIN, but the configuration names no preview namespace"
  fi
else
  not_shown "whether podster-content's deployed binding names $OUTBOUND as outbound: its settings couldn't be read in the shape expected (HTTP $status). Check it in the dashboard."
  not_shown "whether podster-content's deployed limits are $cpu_ms CPU ms and $subrequests subrequests: its settings couldn't be read"
  if [ "$previews" = true ]; then not_shown "whether podster-content's deployed binding PREVIEW_APPS names the preview namespace and its two preview variables are the configuration's: its settings couldn't be read"; fi
fi
cf "/accounts/$account/workers/domains"
if [ "$status" = 200 ] && shaped "$DOMAINS_SHAPE"; then
  if jq -e --arg o "$OUTBOUND" 'any(.result[]; .service == $o)' "$work/body" > /dev/null; then
    fail "a custom domain on the account runs $OUTBOUND"
  else
    pass "no custom domain on the account runs $OUTBOUND"
  fi
else
  not_shown "whether a custom domain runs $OUTBOUND: the account's custom domains couldn't be read in the shape expected (HTTP $status)"
fi
# The zone's rate limiting rule, as the zone holds it after the deploy: this script's rule, exactly as deployed.
cf "$rl_entry"
if [ "$status" = 200 ] && shaped "$RL_ENTRY_SHAPE"; then
  if jq -e --arg ref "$RL_REF" --argjson w "$rl_rule" "$RL_OURS_IN_RESULT" "$work/body" > /dev/null; then
    pass "the zone's rate limiting rule $RL_REF is in place: $RL_REQUESTS requests per $RL_PERIOD s per IP, blocked for $RL_TIMEOUT s, outside the validation folders"
  else
    fail "the zone's rate limiting rule $RL_REF isn't in place as deployed"
  fi
else
  fail "the zone's rate limiting rules couldn't be read (HTTP $status): not verified"
fi
echo "NOT SHOWN an app's fetch refused by $OUTBOUND: that needs an app with code, and none exists yet"
echo "NOT SHOWN a request flood blocked by the rate limiting rule: no probe sends $RL_REQUESTS requests in $RL_PERIOD s"
echo "NOT SHOWN a custom hostname reaching podster-content through $route_all: that needs an active custom hostname, which this script never makes"

echo
if [ "$probe_failures" -ne 0 ] || [ "$not_shown_count" -ne 0 ]; then
  echo "deploy-content: deployed $OUTBOUND (version ${outbound_version:-unknown}) and podster-content at $here (version ${version:-unknown}), but $probe_failures probe(s) failed and $not_shown_count check(s) were NOT SHOWN (above): the Workers are deployed and NOT verified."
  dc_meant=1
  exit 4
fi
echo "deploy-content: deployed $OUTBOUND (version ${outbound_version:-unknown}) and podster-content at $here (version ${version:-unknown}) to $domain, and every probe passed."
dc_meant=1
