#!/usr/bin/env bash
# The one way to merge a pull request: at a reviewed full sha, with every required check there, done and green, no
# open code scanning alert and a clean merge state. It refuses otherwise, and never fixes what it finds.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/merge-gate <pr-number> <full-40-char-head-sha> [--merge]

With no flag it only reports. It passes when ALL of these hold, and prints each one:

  - the pull request is open, not a draft, targets main, and comes from this repository, not a fork
  - its head is exactly the given sha (40 lowercase hex characters, never abbreviated)
    If any of those fails it stops there, before reading anything else.
  - every check has completed as SUCCESS or SKIPPED (NEUTRAL only for the check named "CodeQL")
  - every job of ci.yml is among the checks and succeeded. They may be SKIPPED only on a docs/
    branch whose every changed file, and the old path of every renamed one, is under docs/, or
    is a Markdown file other than CLAUDE.md and outside .claude/ and .github/
  - code scanning has an analysis of this exact head for every language its default setup lists,
    and the "Analyze (<language>)" check of each, and "CodeQL", are there and weren't skipped
  - ci.yml on main still has exactly the jobs this script expects
  - code scanning has no open alert for this pull request
  - mergeStateStatus is CLEAN (it waits while UNKNOWN, up to a minute; anything else fails)

It reads code scanning alerts for this pull request's own refs only, which in this repository
means its head. It never reads main's alerts: one open on main doesn't stop a merge, and isn't
reported here.

--merge              After the gate passes, runs `gh pr merge <n> --merge --match-head-commit <sha>`
                     (a merge commit), then waits for ci.yml on the merge commit on main and reports
                     its conclusion.
It never dismisses an alert, resolves a conflict, updates a branch or reruns anything. A failed job is a failure,
and is looked into.

Exit codes: 0 passed (and, with --merge, main's CI succeeded); 1 refused; 2 wrong usage;
3 merged, but main's CI did not succeed; 4 merged, but main's CI did not finish in time.
EOF
}

mode=report
positional=()
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    --merge)
      if [ "$mode" != report ]; then echo "merge-gate: give --merge once" >&2; exit 2; fi
      mode=merge
      ;;
    -*) echo "merge-gate: unknown option $arg" >&2; usage >&2; exit 2 ;;
    *) positional+=("$arg") ;;
  esac
done
if [ "${#positional[@]}" -ne 2 ]; then usage >&2; exit 2; fi
pr=${positional[0]}
sha=${positional[1]}
if ! [[ "$pr" =~ ^[1-9][0-9]*$ ]]; then echo "merge-gate: '$pr' is not a pull request number" >&2; exit 2; fi
if ! [[ "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "merge-gate: '$sha' is not a full sha. Give all 40 lowercase hex characters of the reviewed head." >&2
  exit 2
fi

# ci.yml's jobs. A pull request must have every one as a check. The gate also reads ci.yml on main and refuses if this
# list isn't its jobs, so a renamed or added job can't pass unnoticed, and the self-test pins it to the workflow file.
CI_JOBS="rust migrations contracts api web scanner gateway e2e"
# There is no flake allowance. There were two: an alarm test of apps/api/test/kernel.spec.ts, whose cause was the test
# runtime running a room's alarm beside the test's own run of it, and "database is locked" in the web job's
# accessibility run, which #254 fixed. The API specs now run alarms through apps/api/test/alarm.ts. Either failing
# again means its fix didn't hold, and is looked into, never rerun.

problems=0
ok() { echo "ok      $*"; }
bad() { echo "REFUSE  $*"; problems=$((problems + 1)); }
refuse() { echo "REFUSE  $*"; echo "merge-gate: refused"; exit 1; }
tab=$'\t'

# The pull request itself, and its head. Nothing else is read unless these all hold.
pull=$(gh pr view "$pr" --json state,isDraft,isCrossRepository,baseRefName,headRefName,headRefOid \
  --jq '[.state, (.isDraft | tostring), (.isCrossRepository | tostring), .baseRefName, .headRefName, .headRefOid] | @tsv') \
  || refuse "could not read pull request #$pr"
IFS=$tab read -r state draft fork base branch head <<< "$pull"
echo "pull request #$pr from $branch at $head"
if [ "$state" = OPEN ]; then ok "it is open"; else bad "it is $state, not open"; fi
if [ "$draft" = false ]; then ok "it is not a draft"; else bad "it is a draft"; fi
if [ "$fork" = false ]; then ok "it comes from this repository"; else bad "it comes from a fork, which this gate never merges"; fi
if [ "$base" = main ]; then ok "it targets main"; else bad "it targets $base, not main"; fi
if [ "$head" = "$sha" ]; then ok "its head is the given sha"; else bad "its head is $head, not the given $sha"; fi
if [ "$problems" -ne 0 ]; then
  echo "merge-gate: refused, $problems problem(s). Nothing else was read, and nothing was merged."
  exit 1
fi

# Code scanning's alerts, for this pull request's refs and no other. An answer that isn't a list, or no answer, counts
# as not clean. This repository's results are filed under the head ref; the merge ref is asked too, in case that changes.
alerts=0
for ref in "refs/pull/$pr/merge" "refs/pull/$pr/head"; do
  found=$(gh api "repos/{owner}/{repo}/code-scanning/alerts?ref=$ref&state=open" \
    --jq 'if type == "array" then length else error("not a list") end') || found=unknown
  case "$found" in
    0) ok "code scanning has no open alert for $ref" ;;
    "" | *[!0-9]*) bad "could not read code scanning alerts for $ref"; alerts=unknown ;;
    *)
      bad "code scanning has $found or more open alerts for $ref"
      if [ "$alerts" != unknown ]; then alerts=$((alerts + found)); fi
      ;;
  esac
done

# An empty alert list means nothing for a head nobody analysed, or that only some languages were analysed for. So
# every language code scanning is set up for must have an analysis of this exact sha. The languages come from the
# repository's default setup, which is where its CodeQL workflow is defined: there is no workflow file. A language
# listed beside its own pair ("javascript" beside "javascript-typescript") is analysed as the pair.
languages=$(gh api "repos/{owner}/{repo}/code-scanning/default-setup" --jq '
  if .state != "configured" then error("default setup is not configured") else . end
  | .languages as $all
  | [$all[] | select(. as $one | any($all[]; . != $one and (split("-") | index($one) != null)) | not)]
  | unique | .[]' 2>&1) || { setup_error=$languages; languages=; }
analysed=$(gh api "repos/{owner}/{repo}/code-scanning/analyses?ref=refs/pull/$pr/head&per_page=100" --jq "
  if type == \"array\" then [.[] | select(.commit_sha == \"$sha\") | .category] | unique | .[] else error(\"not a list\") end") \
  || analysed=unreadable
if [ -z "$languages" ] && printf '%s' "${setup_error:-}" | grep -q 'HTTP 403'; then
  bad "could not read which languages code scanning analyses: GitHub answered 403. The token needs permission to read the code scanning default setup, which for a fine-grained token is Administration: read"
elif [ -z "$languages" ]; then
  bad "could not read which languages code scanning analyses"
elif [ "$analysed" = unreadable ]; then
  bad "could not read code scanning's analyses"
else
  for language in $languages; do
    if printf '%s\n' "$analysed" | grep -q -x -F "/language:$language"; then
      ok "code scanning analysed this head for $language"
    else
      bad "code scanning has no analysis of this head for $language, so its empty alert list means nothing"
    fi
  done
fi

# ci.yml's jobs on the base, against the list above.
workflow_jobs=$(gh api "repos/{owner}/{repo}/contents/.github/workflows/ci.yml?ref=$base" -H "Accept: application/vnd.github.raw" \
  | awk '/^jobs:/ { jobs = 1; next } jobs && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { sub(/:.*/, ""); sub(/^  /, ""); printf "%s%s", sep, $0; sep = " " }') \
  || workflow_jobs=
if [ "$workflow_jobs" = "$CI_JOBS" ]; then
  ok "ci.yml on $base has the jobs this script requires"
else
  bad "ci.yml on $base has the jobs '${workflow_jobs:-unreadable}', and this script requires '$CI_JOBS'. Update CI_JOBS in scripts/merge-gate"
fi

# CI skips its jobs for a docs/ branch by the branch's name alone. The gate lets them be skipped only if the files
# agree. Otherwise the jobs must have run, whatever the name.
#
# What counts as documentation: anything under docs/, and a Markdown file anywhere else, except agent instructions
# and anything beside workflows. CLAUDE.md, .claude/ and .github/ always take the full path.
# The exceptions are matched in lower case: on a checkout that ignores case, claude.md and .GitHub/ are those files.
is_docs() {
  case "$1" in docs/*) return 0 ;; esac
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    claude.md | */claude.md | .claude/* | */.claude/* | .github/* | */.github/*) return 1 ;;
  esac
  case "$1" in
    *.md) return 0 ;;
    *) return 1 ;;
  esac
}
may_skip=false
if [[ "$branch" == docs/* ]]; then
  # The REST list, because it alone gives a renamed file's old path. Without it, code moved under docs/ would read as
  # a docs/ file, and leave its own folder with CI skipped.
  count=$(gh api "repos/{owner}/{repo}/pulls/$pr" --jq '.changed_files | tostring') || count=
  files=$(gh api "repos/{owner}/{repo}/pulls/$pr/files?per_page=100" --paginate \
    --jq '.[] | [.status, .filename, (.previous_filename // "")] | @tsv') || files=
  outside=""
  while IFS=$tab read -r status path previous; do
    [ -n "$status" ] || continue
    case "$status" in
      added | modified | removed | renamed) ;;
      *) outside="$outside, $path ($status)"; continue ;;
    esac
    if ! is_docs "$path"; then outside="$outside, $path"; fi
    if [ "$status" = renamed ] && ! is_docs "$previous"; then outside="$outside, ${previous:-an unnamed file} (renamed to $path)"; fi
  done <<< "$files"
  if ! [[ "$count" =~ ^[1-9][0-9]*$ ]] || [ -z "$files" ]; then
    bad "could not read the files this docs/ branch changes"
  elif [ "$count" != "$(printf '%s\n' "$files" | wc -l | tr -d ' ')" ]; then
    echo "        this docs/ branch changes $count files, and not all of them could be listed, so ci.yml's jobs must have run"
  elif [ -n "$outside" ]; then
    echo "        this docs/ branch changes files that aren't documentation (${outside#, }), so ci.yml's jobs must have run"
  else
    may_skip=true
    ok "this docs/ branch changes only documentation, so ci.yml's jobs may be skipped"
  fi
fi

# Checks, read together with the head they belong to.
rollup=$(gh pr view "$pr" --json headRefOid,statusCheckRollup --jq '
  .headRefOid,
  (.statusCheckRollup[] |
    if .__typename == "StatusContext"
    then [.context, (if .state == "PENDING" or .state == "EXPECTED" then "PENDING" else "COMPLETED" end), .state]
    else [.name, .status, (if (.conclusion // "") == "" then "NONE" else .conclusion end)]
    end | @tsv)') || rollup=
checked_head=$(printf '%s\n' "$rollup" | sed -n 1p)
checks=$(printf '%s\n' "$rollup" | sed 1d)
if [ -z "$rollup" ]; then
  bad "could not read the checks"
elif [ "$checked_head" != "$sha" ]; then
  bad "the head moved to $checked_head while reading the checks"
elif [ -z "$checks" ]; then
  bad "no check has reported"
else
  # Every check, so a name that reports twice is judged twice.
  while IFS=$tab read -r name status conclusion; do
    if [ "$status" != COMPLETED ]; then
      bad "check $name is $status"
    elif [ "$conclusion" = SUCCESS ] || [ "$conclusion" = SKIPPED ]; then
      ok "check $name: $conclusion"
    elif [ "$conclusion" = NEUTRAL ] && [ "$name" = CodeQL ] && [ "$alerts" = 0 ]; then
      ok "check CodeQL: NEUTRAL, with no open alert"
    else
      bad "check $name: $conclusion"
    fi
  done <<< "$checks"

  # Passing isn't enough. main has no required checks, so a pull request whose CI never ran has nothing failing.
  conclusions() { printf '%s\n' "$checks" | awk -F '\t' -v name="$1" '$1 == name { print $3 }'; }
  for job in $CI_JOBS; do
    got=$(conclusions "$job")
    if [ -z "$got" ]; then
      bad "ci.yml's $job is not among the checks"
    elif [ "$may_skip" != true ] && printf '%s\n' "$got" | grep -q -x SKIPPED; then
      bad "ci.yml's $job was SKIPPED, which only a docs/ branch that changes documentation alone may do"
    fi
  done
  scanning=(CodeQL)
  for language in $languages; do scanning+=("Analyze ($language)"); done
  for name in "${scanning[@]}"; do
    got=$(conclusions "$name")
    if [ -z "$got" ]; then
      bad "$name is not among the checks"
    elif printf '%s\n' "$got" | grep -q -x SKIPPED; then
      bad "$name was SKIPPED"
    fi
  done
fi

# GitHub works the merge state out after a push, so UNKNOWN is waited on, for a minute at most.
tries=0
while :; do
  merge_state=$(gh pr view "$pr" --json mergeStateStatus --jq .mergeStateStatus) || merge_state=UNREADABLE
  tries=$((tries + 1))
  if [ "$merge_state" != UNKNOWN ] || [ "$tries" -ge 10 ]; then break; fi
  echo "        merge state is UNKNOWN, asking again ($tries of 10)"
  sleep 6
done
if [ "$merge_state" = CLEAN ]; then ok "merge state is CLEAN"; else bad "merge state is $merge_state, not CLEAN"; fi

if [ "$problems" -ne 0 ]; then
  echo "merge-gate: refused, $problems problem(s). Nothing was merged."
  exit 1
fi
if [ "$mode" = report ]; then
  echo "merge-gate: passed at $sha. Nothing was merged; add --merge to merge."
  exit 0
fi

echo "merging #$pr with a merge commit, only if its head is still $sha"
gh pr merge "$pr" --merge --match-head-commit "$sha" || refuse "the merge was not accepted"

merged=
tries=0
while [ "$tries" -lt 10 ]; do
  merged=$(gh pr view "$pr" --json state,mergeCommit --jq 'select(.state == "MERGED") | .mergeCommit.oid // ""') || merged=
  if [[ "$merged" =~ ^[0-9a-f]{40}$ ]]; then break; fi
  merged=
  tries=$((tries + 1))
  sleep 6
done
if [ -z "$merged" ]; then echo "merge-gate: merged, but the merge commit could not be read. Check main's CI yourself."; exit 4; fi
echo "merged as $merged. Waiting for ci.yml on main."

# The web job alone may take 25 minutes. This asks every 30 seconds for 45.
tries=0
while [ "$tries" -lt 90 ]; do
  run=$(gh run list --workflow ci.yml --branch main --event push --commit "$merged" --limit 1 \
    --json databaseId,status,conclusion,url \
    --jq '.[] | [(.databaseId | tostring), .status, (if (.conclusion // "") == "" then "none" else .conclusion end), .url] | @tsv') || run=
  if [ -n "$run" ]; then
    IFS=$tab read -r id status conclusion url <<< "$run"
    if [ "$status" = completed ]; then
      echo "ci.yml on main for $merged: $conclusion ($url)"
      if [ "$conclusion" = success ]; then echo "merge-gate: merged, and main's CI succeeded"; exit 0; fi
      echo "merge-gate: merged, and main's CI did NOT succeed. Nothing was rerun."
      exit 3
    fi
  fi
  tries=$((tries + 1))
  sleep 30
done
echo "merge-gate: merged as $merged, but ci.yml on main did not finish in 45 minutes"
exit 4
