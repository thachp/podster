#!/usr/bin/env bash
# Checks every refusal of scripts/deploy-content, and its report, deploy, probes and stops, in a scratch repository with
# stand-ins for npm, wrangler, gh and curl. Git is real and local. Nothing reaches the network or Cloudflare. Every
# refusal is shown to make no changing call and no probe: no `wrangler deploy`, nothing but GETs to Cloudflare's API,
# and no request to the content domain. The token is a fake, and it is shown to be in no command's arguments and in no
# output. --deploy runs under a real terminal, a pseudo-terminal from python3's pty module, since the script refuses it
# otherwise; the same helper sends SIGINT or SIGTERM to the run's whole process group, as Ctrl-C does at a terminal.
# Needs `jq` and `python3`.
#
#   scripts/test/deploy-content-selftest
set -euo pipefail
. "$(dirname "$0")/lib.sh"

# Every run has a hard bound. A case that hangs is killed, with everything it started, and fails by name, so a hang
# never stalls the whole self-test (as one did for over two hours under a mutation). The bound only detects a failure:
# no case passes because of time, and no check measures how long anything took, so the rule against timing in tests
# still holds. DC_SELFTEST_BOUND changes it, in seconds; a normal case takes a few.
bound=${DC_SELFTEST_BOUND:-120}
cat > "$tmp/bounded.pl" <<'EOF'
# bounded.pl SECONDS TITLE COMMAND...: runs COMMAND; past SECONDS, kills it and its descendants and exits 124.
use strict; use warnings;
my ($secs, $title) = (shift, shift);
my $pid = fork() // die "fork: $!";
if ($pid == 0) { exec { $ARGV[0] } @ARGV or exit 127; }
sub tree { my @all = ($_[0]); for my $c (split ' ', `pgrep -P $_[0]`) { push @all, tree($c); } return @all; }
my $hung = 0;
$SIG{ALRM} = sub { $hung = 1; kill 'KILL', reverse tree($pid); };
alarm $secs;
waitpid($pid, 0);
my $status = $?;
alarm 0;
if ($hung) { print STDERR "HUNG: killed after ${secs}s: $title\n"; exit 124; }
exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
EOF
hung_cases=()
run() { # lib.sh's run, with the bound
  local expected=$1 code=0
  shift
  PATH="$bin:$PATH" perl "$tmp/bounded.pl" "$bound" "the run of: ${*:1:12}" "$@" > "$tmp/out" 2>&1 || code=$?
  LAST=$code
  if [ "$code" -eq 124 ] && grep -q '^HUNG: ' "$tmp/out"; then
    hung_cases+=("$(grep '^HUNG: ' "$tmp/out" | head -n 1)")
    echo "FAIL a run hung and was killed: $(grep '^HUNG: ' "$tmp/out" | head -n 1 | cut -c1-200)"
    failures=$((failures + 1))
  fi
  [ "$code" -eq "$expected" ]
}

ACCOUNT=0123456789abcdef0123456789abcdef
ACCOUNT_UPPER=0123456789ABCDEF0123456789ABCDEF
OTHER=fedcba9876543210fedcba9876543210
KV=00112233445566778899aabbccddeeff
TOKEN_ID=abcdefabcdefabcdefabcdefabcdef12
TOKEN=selftestFAKEtoken_0123456789abcdefghijklmnopqrstuv
DOMAIN=content-selftest.example
echo "$TOKEN" > "$fix/token-expected"

# --- stand-ins ---
stub gh <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "gh $*" >> "$fix/calls"
if [ -f "$fix/gh-hangs" ]; then
  touch "$fix/checking"
  while :; do sleep 0.1; done
fi
case "$*" in
  "run list --workflow ci.yml --branch main --event push --commit "*)
    [ "$(cat "$fix/main-ci")" = gh-fails ] && exit 1
    printf '%b\n' "$(cat "$fix/main-ci")" | sed '/^$/d'
    ;;
  *) echo "stand-in gh: unexpected: gh $*" >&2; exit 97 ;;
esac
EOF

stub npm <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "npm $* [in $(basename "$PWD")]" >> "$fix/calls"
[ -f "$fix/npm-fails" ] && exit 1
mkdir -p node_modules/.bin
cp "$fix/../wrangler-stub" node_modules/.bin/wrangler
chmod +x node_modules/.bin/wrangler
EOF

# wrangler, as apps/content/node_modules/.bin/wrangler. It records what a deploy was given: whether the token arrived,
# whether anything else of the caller's environment did, an exported function included, where it ran, and the
# configuration and .env file it was pointed at.
{
  echo '#!/usr/bin/env bash'
  printf 'fix=%q\nowner_home=%q\n' "$fix" "$tmp/home"
  cat <<'EOF'
expected=$(cat "$fix/token-expected")
for arg in "$@"; do [[ "$arg" == *"$expected"* ]] && echo "TOKEN-IN-ARGV wrangler" >> "$fix/calls"; done
if [ "$1" = --version ]; then cat "$fix/wrangler-version"; exit; fi
if [ "$1" = deploy ] && [ "$2" = --config ] && [ "$4" = --env-file ]; then
  auth=missing; [ "${CLOUDFLARE_API_TOKEN:-}" = "$expected" ] && auth=ok
  canary=absent; [ -n "${SELFTEST_CANARY:-}" ] && canary=present
  account=absent; [ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ] && account=present
  proxy=absent; [ -n "${HTTPS_PROXY:-}${https_proxy:-}" ] && proxy=present
  func=absent; declare -F selftest_function > /dev/null && func=present
  private=no; [ -d "$HOME" ] && [ "$HOME" != "$owner_home" ] && [ "$(dirname "$HOME")" = "$(dirname "$3")" ] && private=yes
  runs_in=elsewhere; [ "$PWD" = "$(dirname "$3")/run" ] && [ -z "$(ls -A .)" ] && runs_in=own-empty-folder
  envfile=other; [ -f "$5" ] && [ ! -s "$5" ] && envfile=empty
  echo "wrangler deploy auth=$auth canary=$canary account_env=$account proxy=$proxy function=$func home_private=$private cwd=$runs_in env_file=$envfile ci=${CI:-}" >> "$fix/calls"
  cp "$3" "$fix/deployed-config.json"
  dirname "$3" > "$fix/work-dir"
  echo "Uploaded podster-content"
  if [ -f "$fix/deploy-hangs" ]; then
    touch "$fix/deploying"
    while :; do sleep 0.1; done
  fi
  [ -f "$fix/wrangler-leaks" ] && echo "debug: Authorization: Bearer $CLOUDFLARE_API_TOKEN"
  [ -f "$fix/wrangler-log-leaks" ] && echo "token $CLOUDFLARE_API_TOKEN" > "$WRANGLER_LOG_PATH/wrangler.log"
  [ -f "$fix/deploy-fails" ] && { echo "✘ [ERROR] something went wrong" >&2; exit 1; }
  echo "Current Version ID: 11111111-2222-3333-4444-555555555555"
  exit 0
fi
echo "stand-in wrangler: unexpected: $*" >&2
exit 97
EOF
} > "$tmp/wrangler-stub"

# curl: Cloudflare's API from $fix/api-<key>.{status,body}, and the content domain's probes from $fix/probe-<key>.
# It finds the method however it is passed. It records whether -q came first, so no .curlrc was read, and whether
# anything of the caller's environment arrived.
stub curl <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
expected=$(cat "$fix/token-expected")
for arg in "$@"; do [[ "$arg" == *"$expected"* ]] && echo "TOKEN-IN-ARGV curl" >> "$fix/calls"; done
first=no; [ "${1:-}" = -q ] && first=yes
leaks=none
[ -n "${HTTPS_PROXY:-}${https_proxy:-}${HTTP_PROXY:-}${ALL_PROXY:-}${CURL_HOME:-}${SELFTEST_CANARY:-}" ] && leaks=caller-env
explicit="" implied=GET out=/dev/null headers=/dev/null url="" config=false extra=""
while [ $# -gt 0 ]; do
  case "$1" in
    -X | --request) explicit=$2; shift ;;
    -X?*) explicit=${1#-X} ;;
    --request=*) explicit=${1#--request=} ;;
    -I | --head) implied=HEAD ;;
    -d | --data | --data-raw | --data-binary | --data-urlencode | -F | --form | --json) implied=POST; shift ;;
    -d?* | --data=* | --data-raw=* | --json=*) implied=POST ;;
    -T | --upload-file) implied=PUT; shift ;;
    -o) out=$2; shift ;;
    -D) headers=$2; shift ;;
    -H) extra=$2; shift ;;
    --config) [ "$2" = - ] && config=true; shift ;;
    -w | --proto | --max-time) shift ;;
    http://* | https://*) url=$1 ;;
  esac
  shift
done
method=${explicit:-$implied}
auth=none
if [ "$config" = true ]; then
  line=$(cat)
  if [ "$line" = "header = \"Authorization: Bearer $expected\"" ]; then auth=ok; else auth=bad; fi
fi
case "$url" in
  https://api.cloudflare.com/client/v4/*)
    path=${url#https://api.cloudflare.com/client/v4}
    echo "curl $method $path auth=$auth q_first=$first env=$leaks" >> "$fix/calls"
    case "$path" in
      /user/tokens/verify) key=verify-user ;;
      /accounts/*/tokens/verify) key=verify-account ;;
      /user/tokens/*) key=self-user ;;
      /accounts/*/tokens/*) key=self-account ;;
      "/accounts?per_page=50") key=accounts ;;
      "/zones?name=podster.dev&per_page=50") key=zone-podster ;;
      "/zones?name="*) key=zone-content ;;
      /accounts/*/workers/dispatch/namespaces/*) key=namespace ;;
      /accounts/*/storage/kv/namespaces/*) key=kv ;;
      *) echo "stand-in curl: unexpected API path $path" >&2; exit 97 ;;
    esac
    status=$(cat "$fix/api-$key.status")
    if [ "$status" = unreachable ]; then echo "curl: (7) could not connect" >&2; printf 000; exit 7; fi
    if [ "$(cat "$fix/api-$key.body")" = LEAK ]; then printf '{"success":true,"echo":"%s"}' "$expected" > "$out"; else cat "$fix/api-$key.body" > "$out"; fi
    printf '%s' "$status"
    ;;
  http://* | https://*)
    scheme=${url%%://*}
    hostpath=${url#*://}
    host=${hostpath%%/*}
    if [ "$host" = content-selftest.example ]; then which=apex; key=probe-apex
    else
      which="<host>"
      if [ -n "$extra" ]; then key=probe-sw
      elif [ "$method" = POST ]; then key=probe-post
      elif [ "$scheme" = http ]; then key=probe-http
      else key=probe-unknown; fi
    fi
    echo "probe $method $scheme://$which/${hostpath#*/} header=${extra:-none} host_ok=$([[ "$host" =~ ^([0-9a-f]{26}\.)?content-selftest\.example$ ]] && echo yes || echo no) q_first=$first env=$leaks" >> "$fix/calls"
    if [ -f "$fix/probe-hangs" ]; then
      touch "$fix/probing"
      while :; do sleep 0.1; done
    fi
    status=$(cat "$fix/$key.status")
    if [ "$status" = unreachable ]; then printf 000; exit 6; fi
    sed "s|{HOST}|$host|g" "$fix/$key.headers" > "$headers"
    cat "$fix/$key.body" > "$out"
    printf '%s' "$status"
    ;;
  *) echo "stand-in curl: unexpected: $method $url" >&2; exit 97 ;;
esac
EOF

# --- what Cloudflare and the content domain answer when all is well ---
api() { # api KEY STATUS BODY
  echo "$2" > "$fix/api-$1.status"
  printf '%s' "$3" > "$fix/api-$1.body"
}
own_headers() { # own_headers STATUS [EXTRA-LINE]: the Worker's own answer's headers
  printf 'HTTP/2 %s\r\ncontent-type: text/plain; charset=utf-8\r\nreferrer-policy: no-referrer\r\nx-content-type-options: nosniff\r\nstrict-transport-security: max-age=31536000; includeSubDomains\r\ncache-control: no-store\r\naccess-control-allow-origin: *\r\ncontent-security-policy: sandbox allow-scripts; default-src https://{HOST}\r\n%s\r\n' "$1" "${2:+$2$'\r\n'}"
}
probe() { # probe KEY STATUS BODY [EXTRA-HEADER-LINE]
  echo "$2" > "$fix/$1.status"
  printf '%s\n' "$3" > "$fix/$1.body"
  own_headers "$2" "${4:-}" > "$fix/$1.headers"
}
healthy() {
  rm -f "$fix"/api-* "$fix"/probe-* "$fix/calls" "$fix/deployed-config.json" "$fix/work-dir" "$fix/npm-fails" "$fix/deploy-fails" \
    "$fix/wrangler-leaks" "$fix/wrangler-log-leaks" "$fix/deploy-hangs" "$fix/deploying" "$fix/gh-hangs" "$fix/checking" \
    "$fix/probe-hangs" "$fix/probing"
  : > "$fix/calls"
  echo 4.157.0 > "$fix/wrangler-version"
  printf 'completed\\tsuccess' > "$fix/main-ci"
  api verify-user 200 "{\"success\":true,\"result\":{\"id\":\"$TOKEN_ID\",\"status\":\"active\"}}"
  api verify-account 401 '{"success":false}'
  api self-user 403 '{"success":false,"errors":[{"code":9109}]}'
  api self-account 403 '{"success":false,"errors":[]}'
  api accounts 200 "{\"success\":true,\"result\":[{\"id\":\"$ACCOUNT\"}]}"
  api zone-podster 200 '{"success":true,"result":[]}'
  api zone-content 200 "{\"success\":true,\"result\":[{\"name\":\"$DOMAIN\",\"status\":\"active\",\"account\":{\"id\":\"$ACCOUNT\"}}]}"
  api namespace 200 '{"success":true,"result":{"namespace_name":"podster-apps"}}'
  api kv 200 "{\"success\":true,\"result\":{\"id\":\"$KV\"}}"
  probe probe-unknown 404 not_found
  probe probe-http 301 moved_to_https "location: https://{HOST}/probe?x=1"
  probe probe-post 405 method_not_allowed "allow: GET, HEAD"
  probe probe-sw 403 no_service_workers
  echo unreachable > "$fix/probe-apex.status"
}

# --- the repository, and the owner's two files ---
origin="$tmp/origin.git"
work="$tmp/work"
home="$tmp/home"
secrets="$home/.config/podster"
quiet() { "$@" > /dev/null 2>&1; }
fresh() {
  rm -rf "$origin" "$work" "$tmp/seed" "$home"
  healthy
  mkdir -p "$tmp/seed/scripts" "$tmp/seed/e2e" "$tmp/seed/apps/content/src" "$tmp/seed/apps/api"
  cp "$scripts/deploy-content" "$tmp/seed/scripts/"
  cp "$scripts/../e2e/jsonc.mjs" "$tmp/seed/e2e/"
  cp "$scripts/../apps/content/wrangler.jsonc" "$tmp/seed/apps/content/"
  echo '{}' > "$tmp/seed/apps/content/package.json"
  echo 'export default {};' > "$tmp/seed/apps/content/src/index.ts"
  printf 'node_modules/\n.wrangler/\n.env*\n' > "$tmp/seed/.gitignore"
  quiet git init -q -b main "$tmp/seed"
  git -C "$tmp/seed" add -A
  git -C "$tmp/seed" -c user.name=selftest -c user.email=selftest@example.invalid commit --quiet -m seed
  quiet git init -q --bare "$origin"
  quiet git -C "$tmp/seed" push "$origin" main
  quiet git clone -q "$origin" "$work"
  quiet git -C "$work" checkout --detach origin/main
  mkdir -p "$secrets"
  chmod 700 "$home" "$home/.config" "$secrets"
  echo "$TOKEN" > "$secrets/content-token"
  chmod 600 "$secrets/content-token"
  config "$ACCOUNT" "$DOMAIN" "$KV" podster-apps
  # A hostile curl configuration in the owner's home: curl must never read it.
  printf 'trace-ascii = %s\nproxy = http://127.0.0.1:9\n' "$tmp/curl-trace" > "$home/.curlrc"
}
config() { # config ACCOUNT DOMAIN KV NAMESPACE: writes the owner's configuration file
  printf '{"account_id":"%s","content_domain":"%s","kv_namespace_id":"%s","dispatch_namespace":"%s"}\n' "$@" > "$secrets/content-deploy.json"
  chmod 600 "$secrets/content-deploy.json"
}

# Every run: Cloudflare's variables unset, the owner's home with its hostile .curlrc, proxy variables, and a canary.
clean_env=(env -u CLOUDFLARE_API_TOKEN -u CLOUDFLARE_API_KEY -u CLOUDFLARE_ACCOUNT_ID -u WRANGLER_LOG -u WRANGLER_CACHE_DIR -u SHELLOPTS -u BASH_ENV
  "HOME=$home" SELFTEST_CANARY=1 HTTPS_PROXY=http://127.0.0.1:9 https_proxy=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 ALL_PROXY=http://127.0.0.1:9 "CURL_HOME=$home")
files=(--token-file "$secrets/content-token" --config-file "$secrets/content-deploy.json")
# dc EXPECTED-EXIT [VAR=VALUE...] [ARG...]: runs the script with the two files.
dc() {
  local code=$1
  shift
  local vars=()
  while [ $# -gt 0 ] && [[ "$1" == *=* ]] && [[ "$1" != -* ]]; do vars+=("$1"); shift; done
  run "$code" "${clean_env[@]}" ${vars[@]+"${vars[@]}"} "$work/scripts/deploy-content" "$@"
}
# at-terminal.py TYPED [--signal NAME --when FILE] COMMAND...: runs COMMAND under a pseudo-terminal, typing TYPED when
# asked for the domain. With --signal, it sends that signal to the command's whole process group, as a terminal does
# for Ctrl-C, once FILE exists.
cat > "$tmp/at-terminal.py" <<'EOF'
import os, pty, select, signal, sys
args = sys.argv[1:]
answer = args.pop(0)
send, when = None, None
if args and args[0] == "--signal":
    send, when = getattr(signal, args[1]), args[3]
    args = args[4:]
pid, fd = pty.fork()
if pid == 0:
    os.execvp(args[0], args)
buf, typed, sent = b"", False, False
while True:
    ready, _, _ = select.select([fd], [], [], 0.1)
    if send and not sent and os.path.exists(when):
        os.killpg(pid, send)
        sent = True
    if not ready:
        continue
    try:
        data = os.read(fd, 4096)
    except OSError:
        break
    if not data:
        break
    buf += data
    if not typed and b"type the content domain" in buf:
        os.write(fd, (answer + "\n").encode())
        typed = True
_, status = os.waitpid(pid, 0)
sys.stdout.write(buf.decode(errors="replace"))
sys.exit(os.waitstatus_to_exitcode(status))
EOF
at_terminal() { # at_terminal EXPECTED-EXIT TYPED [--signal NAME --when FILE] [VAR=VALUE...] -- [ARG...]
  local code=$1 typed=$2
  shift 2
  local signal=()
  if [ "${1:-}" = --signal ]; then signal=("$1" "$2" "$3" "$4"); shift 4; fi
  local vars=()
  while [ $# -gt 0 ] && [ "$1" != -- ]; do vars+=("$1"); shift; done
  shift
  run "$code" "${clean_env[@]}" ${vars[@]+"${vars[@]}"} python3 -I "$tmp/at-terminal.py" "$typed" ${signal[@]+"${signal[@]}"} "$work/scripts/deploy-content" "$@"
}

# unchanged: no changing call and no probe reached a stand-in, and the token is in no argument and no output.
unchanged() {
  never_called "^wrangler deploy" && never_called "^curl (POST|PUT|PATCH|DELETE|HEAD) " && never_called "^probe " && no_token
}
no_token() { ! grep -q -F "$TOKEN" "$fix/calls" "$tmp/out" && never_called "TOKEN-IN-ARGV"; }
refused() { [ "$LAST" -eq 1 ] && said "^REFUSE  $1" && said "deploy-content: refused, nothing was deployed" && unchanged; }

# --- the curl stand-in sees the method however it is passed ---
fresh
check "the curl stand-in reads the method from -X, -XPOST, --request, --request=, data, -I and -T" bash -c "
  : > '$fix/calls'
  for form in '-X POST' '-XPOST' '--request POST' '--request=POST' '--data x' '-dx' '--json {}'; do PATH='$bin':\$PATH curl -q \$form -o /dev/null 'https://$DOMAIN/' > /dev/null 2>&1 || true; done
  PATH='$bin':\$PATH curl -q -I -o /dev/null 'https://$DOMAIN/' > /dev/null 2>&1 || true
  PATH='$bin':\$PATH curl -q -T f -o /dev/null 'https://$DOMAIN/' > /dev/null 2>&1 || true
  [ \"\$(grep -c '^probe POST ' '$fix/calls')\" -eq 7 ] && grep -q '^probe HEAD ' '$fix/calls' && grep -q '^probe PUT ' '$fix/calls'"

# --- usage ---
fresh
check "no arguments: usage, exit 2" run 2 "$work/scripts/deploy-content"
check "a token file but no configuration: exit 2" run 2 "$work/scripts/deploy-content" --token-file "$secrets/content-token"
check "--token-file with no path: exit 2" run 2 "$work/scripts/deploy-content" --token-file --config-file x
check "a relative --token-file: exit 2" run 2 "$work/scripts/deploy-content" --token-file content-token --config-file "$secrets/content-deploy.json"
check "a relative --config-file: exit 2" run 2 "$work/scripts/deploy-content" --token-file "$secrets/content-token" --config-file ./content-deploy.json
check "an unknown argument: exit 2" run 2 "$work/scripts/deploy-content" "${files[@]}" --yes
check "--help says agents run it only without --deploy, only when the owner asks" bash -c "'$work/scripts/deploy-content' --help | grep -q 'AGENTS run it only without --deploy, and only when the owner asks'"
check "usage refusals make no call at all" bash -c "[ ! -s '$fix/calls' ]"

# --- tracing ---
fresh; run 1 "${clean_env[@]}" bash -x "$work/scripts/deploy-content" "${files[@]}" || true
check "under bash -x: refused, nothing read, the token nowhere" bash -c "[ $LAST -eq 1 ] && grep -q 'refused: it doesn.t run under bash -x' '$tmp/out' && [ ! -s '$fix/calls' ]"
check "  the token is in no output" no_token
fresh; run 1 "${clean_env[@]}" bash -v "$work/scripts/deploy-content" "${files[@]}" || true
check "under bash -v: refused" bash -c "[ $LAST -eq 1 ] && grep -q 'refused: it doesn.t run under bash -x or -v' '$tmp/out' && [ ! -s '$fix/calls' ]"
fresh; dc 1 SHELLOPTS=xtrace "${files[@]}" || true
check "with SHELLOPTS=xtrace: refused, nothing read, the token nowhere" bash -c "[ $LAST -eq 1 ] && grep -q -E 'refused: (it doesn.t run under bash -x|SHELLOPTS turns on xtrace)' '$tmp/out' && [ ! -s '$fix/calls' ]"
check "  the token is in no output" no_token
fresh; echo ':' > "$tmp/bash-env"; dc 1 "BASH_ENV=$tmp/bash-env" "${files[@]}" || true
check "with BASH_ENV set: refused" bash -c "[ $LAST -eq 1 ] && grep -q 'refused: BASH_ENV is set' '$tmp/out' && [ ! -s '$fix/calls' ]"

# --- which shell ---
fresh; run 2 "${clean_env[@]}" sh "$work/scripts/deploy-content" "${files[@]}" || true
check "run by sh: refused, exit 2, nothing run" bash -c "[ $LAST -eq 2 ] && grep -q -E 'refused: (run it with bash|bash was in POSIX mode)' '$tmp/out' && [ ! -s '$fix/calls' ]"
fresh; run 2 "${clean_env[@]}" bash --posix "$work/scripts/deploy-content" "${files[@]}" || true
check "run by bash in POSIX mode: refused, exit 2" bash -c "[ $LAST -eq 2 ] && grep -q 'refused: bash was in POSIX mode' '$tmp/out' && [ ! -s '$fix/calls' ]"
if command -v dash > /dev/null 2>&1; then
  fresh; run 2 "${clean_env[@]}" dash "$work/scripts/deploy-content" "${files[@]}" || true
  check "run by dash: refused, exit 2, nothing run" bash -c "[ $LAST -eq 2 ] && grep -q 'refused: run it with bash' '$tmp/out' && [ ! -s '$fix/calls' ]"
fi
check "this self-test runs under bash $BASH_VERSION" true

# --- shadowing functions, and BASH_ENV ---
# A function exported into the environment, as bash exports one, under the name of a command or builtin the script
# might use. Each one records any call, with its arguments, so a call or a token passed to one would show.
shadow_var() { # shadow_var NAME: the environment variable that exports a function of that name
  printf "BASH_FUNC_%s%%%%=() { printf 'SHADOW-%s %%s\\n' \"\$*\" >> '%s'; }" "$1" "$1" "$fix/calls"
}
SHADOWS=(declare env '[' test set exit exec unset command builtin echo curl jq git mktemp)
for name in "${SHADOWS[@]}"; do
  fresh
  dc 0 "$(shadow_var "$name")" "${files[@]}" || true
  check "an exported function named $name has no effect: the report runs, and the function is never called" bash -c "[ $LAST -eq 0 ] && ! grep -q '^SHADOW' '$fix/calls' && grep -q 'Nothing was deployed' '$tmp/out'"
  check "  the token is in no function's arguments and no output" no_token
done
fresh
all=()
for name in "${SHADOWS[@]}"; do all+=("$(shadow_var "$name")"); done
dc 0 "${all[@]}" "${files[@]}" || true
check "all ${#SHADOWS[@]} exported together have no effect" bash -c "[ $LAST -eq 0 ] && ! grep -q '^SHADOW' '$fix/calls'"
check "  the token is in no function's arguments and no output" no_token
fresh; at_terminal 0 "$DOMAIN" "${all[@]}" -- "${files[@]}" --deploy || true
check "  and a deploy with all of them exported calls none of them" bash -c "[ $LAST -eq 0 ] && ! grep -q '^SHADOW' '$fix/calls' && grep -q 'every probe passed' '$tmp/out'"
check "  the token is in no function's arguments and no output" no_token
{
  echo 'set -x'
  for name in curl env jq git '[' unset exec; do
    printf "%s() { printf 'SHADOW-%s %%s\\n' \"\$*\" >> '%s'; }\n" "$name" "$name" "$fix/calls"
