check "  wrangler ran once: the token, nothing of the caller's (CLOUDFLARE_ACCOUNT_ID, proxies, a canary), a private home, its own empty folder, an empty .env file" \
  called "^wrangler deploy auth=ok canary=absent account_env=absent proxy=absent function=absent home_private=yes cwd=own-empty-folder env_file=empty ci=true$"
check "  exactly one deploy" bash -c "[ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 1 ]"
check "  its configuration: the owner's account, the route on the content domain, both public addresses off, the two namespaces" \
  quiet jq -e --arg a "$ACCOUNT" --arg d "$DOMAIN" --arg kv "$KV" '.name == "podster-content" and .account_id == $a and .workers_dev == false and .preview_urls == false and .routes == [{"pattern": ("*." + $d + "/*"), "zone_name": $d}] and .vars == {"CONTENT_DOMAIN": $d} and .kv_namespaces == [{"binding": "SERVE", "id": $kv}] and .dispatch_namespaces == [{"binding": "APPS", "namespace": "podster-apps"}] and (.main | endswith("/apps/content/src/index.ts"))' "$fix/deployed-config.json"
check "  four probes on one random host and one on the content domain itself, all signed out, -q first, nothing of the caller's" \
  bash -c "[ \$(grep -c '^probe .* host_ok=yes q_first=yes env=none$' '$fix/calls') -eq 5 ] && [ \$(grep -c '^probe ' '$fix/calls') -eq 5 ] && grep -q '^probe GET https://apex/' '$fix/calls'"
check "  it says what it can't show: a host two labels deep" said "^NOT SHOWN a host two labels deep"
check "  the token is in no argument and no output" no_token
check "  the hostile .curlrc was never read" bash -c "[ ! -e '$tmp/curl-trace' ]"
check "  the script's own temporary folder, where wrangler's home and logs were, is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"

fresh; touch "$fix/deploy-fails"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "a failed wrangler deploy: exit 3, stopped part-way" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler deploy exited with status 1' '$tmp/out'"
fresh; touch "$fix/wrangler-leaks"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "wrangler output holding the token: exit 3, redacted, not printed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler.s output or its log held the token' '$tmp/out' && grep -q 'redacted token' '$tmp/out'"
check "  the token is in no output" no_token
fresh; touch "$fix/wrangler-log-leaks"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "wrangler's log holding the token: exit 3, not printed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler.s output or its log held the token' '$tmp/out'"
check "  the token is in no output" no_token

probe_fails() { # probe_fails TITLE KEY STATUS BODY [EXTRA]
  fresh
  probe "$2" "$3" "$4" "${5:-}"
  at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
  check "$1: exit 4, deployed and NOT verified" bash -c "[ $LAST -eq 4 ] && grep -q 'the Worker is deployed and NOT verified' '$tmp/out'"
}
probe_fails "an unknown host answered by something else" probe-unknown 200 "<html>parked</html>"
probe_fails "plain HTTP not redirected" probe-http 200 hello
probe_fails "plain HTTP redirected elsewhere" probe-http 301 moved_to_https "location: https://elsewhere.example/"
probe_fails "a POST accepted" probe-post 200 ok
probe_fails "a service worker's script served" probe-sw 200 "self.addEventListener('fetch', () => {})"
probe_fails "the content domain itself serving a page" probe-apex 200 "<html>hello</html>"
fresh; probe probe-apex 404 not_found; at_terminal 0 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the content domain itself answering 404 passes" said "PASS    the content domain itself serves nothing: HTTP 404"
fresh; own_headers 404 | grep -v -i nosniff > "$fix/probe-unknown.headers"; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the not-found without its nosniff header: exit 4, and the header named" bash -c "[ $LAST -eq 4 ] && grep -q 'missing or wrong: x-content-type-options' '$tmp/out'"

# --- stops, as Ctrl-C and a kill would make them ---
fresh; touch "$fix/gh-hangs"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/checking" -- "${files[@]}" --deploy || true
check "SIGINT while checking: exit 130, nothing deployed, and it says so" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT before anything was deployed. Nothing changed.' '$tmp/out'"
check "  nothing was deployed and nothing probed" unchanged
fresh; touch "$fix/deploy-hangs"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGINT during wrangler deploy: exit 130, and it says the Worker may or may not be deployed" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT during wrangler deploy. The Worker may or may not be deployed' '$tmp/out'"
check "  no probe ran" never_called "^probe "
check "  the token is in no output" no_token
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"
fresh; touch "$fix/deploy-hangs"; at_terminal 143 "$DOMAIN" --signal SIGTERM --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGTERM during wrangler deploy: exit 143, and it says so" bash -c "[ $LAST -eq 143 ] && grep -q 'STOPPED by SIGTERM during wrangler deploy' '$tmp/out'"
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"

fresh; touch "$fix/deploy-hangs"; at_terminal 129 "$DOMAIN" --signal SIGHUP --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGHUP during wrangler deploy: exit 129, and it says so" bash -c "[ $LAST -eq 129 ] && grep -q 'STOPPED by SIGHUP during wrangler deploy. The Worker may or may not be deployed' '$tmp/out'"
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"
fresh; touch "$fix/probe-hangs"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/probing" -- "${files[@]}" --deploy || true
check "SIGINT during the probes: exit 130, deployed and NOT verified" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT during the probes. The Worker is deployed and NOT verified.' '$tmp/out'"
check "  it had deployed once, and the token is in no output" bash -c "[ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 1 ]"
check "  the token is in no output" no_token

finish deploy-content
