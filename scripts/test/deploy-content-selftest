  quiet jq -e --arg a "$ACCOUNT" --arg d "$DOMAIN" --arg kv "$KV" '(keys == ["account_id", "compatibility_date", "dispatch_namespaces", "durable_objects", "kv_namespaces", "main", "migrations", "name", "preview_urls", "routes", "vars", "workers_dev"]) and .name == "podster-content" and .account_id == $a and .workers_dev == false and .preview_urls == false and .routes == [{"pattern": ("*." + $d + "/*"), "zone_name": $d}] and .vars == {"CONTENT_DOMAIN": $d, "WRITE_BUDGET_WRITES": "300", "WRITE_BUDGET_WINDOW_MS": "600000", "APP_LIMIT_CPU_MS": "50", "APP_LIMIT_SUBREQUESTS": "50"} and .kv_namespaces == [{"binding": "SERVE", "id": $kv}] and .dispatch_namespaces == [{"binding": "APPS", "namespace": "podster-apps", "outbound": {"service": "podster-outbound"}}] and .durable_objects == {"bindings": [{"name": "WRITE_COUNTER", "class_name": "WriteCounter"}]} and .migrations == [{"tag": "v1", "new_sqlite_classes": ["WriteCounter"]}] and (.main | endswith("/apps/content/src/index.ts"))' "$fix/deployed-podster-content.json"
check "  one request waiting for the route, then four probes on one random host and one on the content domain itself, all signed out, -q first, nothing of the caller's" \
  bash -c "[ \$(grep -c '^probe .* host_ok=yes q_first=yes env=none$' '$fix/calls') -eq 6 ] && [ \$(grep -c '^probe ' '$fix/calls') -eq 6 ] && [ \$(grep -c '^probe GET https://<host>/ ' '$fix/calls') -eq 2 ] && grep -q '^probe GET https://apex/' '$fix/calls'"
check "  the route answered at once: no wait" bash -c "grep -q '^ok      the route answers (HTTP 404, try 1)' '$tmp/out' && ! grep -q '^sleep ' '$fix/calls'"
check "  it says what it can't show: a host two labels deep" said "^NOT SHOWN a host two labels deep"
check "  the token is in no argument and no output" no_token
check "  the hostile .curlrc was never read" bash -c "[ ! -e '$tmp/curl-trace' ]"
check "  the script's own temporary folder, where wrangler's home and logs were, is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"

fresh; touch "$fix/deploy-fails-podster-content"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "a failed wrangler deploy of the content Worker: exit 3, stopped part-way, saying the outbound Worker is deployed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler deploy of the content Worker exited with status 1' '$tmp/out' && grep -q 'podster-outbound is deployed' '$tmp/out' && grep -q 'keeps serving as it was deployed: every deploy by this script names podster-outbound' '$tmp/out'"
check "  no probe ran" never_called "^probe "
fresh; touch "$fix/wrangler-leaks"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "wrangler output holding the token: exit 3, redacted, not printed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler.s output or its log held the token' '$tmp/out' && grep -q 'redacted token' '$tmp/out'"
check "  the token is in no output" no_token
fresh; touch "$fix/wrangler-log-leaks"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "wrangler's log holding the token: exit 3, not printed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler.s output or its log held the token' '$tmp/out'"
check "  the token is in no output" no_token

# --- the outbound Worker's deploy ---
fresh; touch "$fix/deploy-fails-podster-outbound"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "a failed deploy of the outbound Worker: exit 3, and the content Worker never deployed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED wrangler deploy of the outbound Worker exited with status 1' '$tmp/out' && grep -q 'The content Worker wasn.t deployed' '$tmp/out' && [ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 1 ] && grep -q '^wrangler deploy podster-outbound ' '$fix/calls'"
check "  no probe ran" never_called "^probe "
fresh; api scripts 200 '{"success":true,"result":[{"id":"podster-content"}]}'; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the outbound Worker not on the account after its deploy: exit 3, and the content Worker never deployed" bash -c "[ $LAST -eq 3 ] && grep -q 'STOPPED Cloudflare.s list of the account.s scripts (HTTP 200) doesn.t show podster-outbound after its deploy' '$tmp/out' && [ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 1 ] && ! grep -q '^wrangler deploy podster-content' '$fix/calls'"
check "  no probe ran, and the token is in no output" bash -c "! grep -q '^probe ' '$fix/calls' && ! grep -q -F '$TOKEN' '$tmp/out' '$fix/calls'"
fresh; touch "$fix/wrangler-leaks"; at_terminal 3 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the outbound Worker's wrangler output holding the token: exit 3, the content Worker never deployed" bash -c "[ $LAST -eq 3 ] && grep -q 'the outbound Worker may or may not be deployed. The content Worker wasn.t deployed.' '$tmp/out' && [ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 1 ]"
check "  the token is in no output" no_token
fresh; touch "$fix/deploy-hangs-podster-outbound"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGINT during the outbound Worker's deploy: exit 130, the content Worker not deployed, and it says so" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT while deploying the outbound Worker. podster-outbound may or may not be deployed, and the content Worker wasn.t' '$tmp/out' && ! grep -q '^wrangler deploy podster-content' '$fix/calls'"

# --- the checks of the outbound Worker after the deploy ---
outbound_check() { # outbound_check TITLE EXPECTED-EXIT PATTERN KEY STATUS BODY
  fresh
  api "$4" "$5" "$6"
  at_terminal "$2" "$DOMAIN" -- "${files[@]}" --deploy || true
  check "$1" bash -c "[ $LAST -eq $2 ] && grep -q -E \"\$1\" '$tmp/out'" _ "$3"
}
outbound_check "the outbound Worker on workers.dev after the deploy: exit 4" 4 "^FAIL    podster-outbound is on workers.dev" outbound-subdomain 200 '{"success":true,"result":{"enabled":true,"previews_enabled":false}}'
outbound_check "the outbound Worker with previews on: exit 4" 4 "^FAIL    podster-outbound has preview addresses on" outbound-subdomain 200 '{"success":true,"result":{"enabled":false,"previews_enabled":true}}'
outbound_check "its workers.dev setting unreadable: exit 4, not verified" 4 "^FAIL    podster-outbound's workers.dev setting couldn't be read \\(HTTP 403\\): not verified" outbound-subdomain 403 '{"success":false,"errors":[]}'
outbound_check "  a setting of another shape is unreadable too" 4 "^FAIL    podster-outbound's workers.dev setting couldn't be read" outbound-subdomain 200 '{"success":true,"result":{"enabled":"no"}}'
outbound_check "a workers.dev setting that doesn't say previews: NOT SHOWN, and exit 4" 4 "^NOT SHOWN whether podster-outbound has preview addresses" outbound-subdomain 200 '{"success":true,"result":{"enabled":false}}'
outbound_check "a binding that names no outbound Worker: exit 4" 4 "^FAIL    podster-content's deployed settings have no binding APPS to the namespace naming podster-outbound" content-settings 200 '{"success":true,"result":{"bindings":[{"type":"dispatch_namespace","name":"APPS","namespace":"podster-apps"}]}}'
outbound_check "a binding naming another outbound Worker: exit 4" 4 "^FAIL    podster-content's deployed settings have no binding APPS" content-settings 200 '{"success":true,"result":{"bindings":[{"type":"dispatch_namespace","name":"APPS","namespace":"podster-apps","outbound":{"worker":{"service":"elsewhere"}}}]}}'
outbound_check "deployed limits missing: exit 4" 4 "^FAIL    podster-content's deployed settings don't hold APP_LIMIT_CPU_MS 50 and APP_LIMIT_SUBREQUESTS 50" content-settings 200 '{"success":true,"result":{"bindings":[{"type":"dispatch_namespace","name":"APPS","namespace":"podster-apps","outbound":{"worker":{"service":"podster-outbound"}}}]}}'
outbound_check "deployed limits other than the committed: exit 4" 4 "^FAIL    podster-content's deployed settings don't hold APP_LIMIT_CPU_MS" content-settings 200 '{"success":true,"result":{"bindings":[{"type":"dispatch_namespace","name":"APPS","namespace":"podster-apps","outbound":{"worker":{"service":"podster-outbound"}}},{"type":"plain_text","name":"APP_LIMIT_CPU_MS","text":"5000"},{"type":"plain_text","name":"APP_LIMIT_SUBREQUESTS","text":"50"}]}}'
outbound_check "a binding to another namespace: exit 4" 4 "^FAIL    podster-content's deployed settings have no binding APPS" content-settings 200 '{"success":true,"result":{"bindings":[{"type":"dispatch_namespace","name":"APPS","namespace":"other","outbound":{"worker":{"service":"podster-outbound"}}}]}}'
outbound_check "settings that can't be read: NOT SHOWN, never a pass, and exit 4" 4 "^NOT SHOWN whether podster-content's deployed binding names podster-outbound as outbound: its settings couldn't be read in the shape expected \\(HTTP 403\\)" content-settings 403 '{"success":false,"errors":[]}'
check "  and no PASS for the binding, and never the success line" bash -c "! grep -q '^PASS    podster-content.s deployed binding' '$tmp/out' && ! grep -q 'every probe passed' '$tmp/out' && grep -q 'but 0 probe(s) failed and 2 check(s) were NOT SHOWN (above): the Workers are deployed and NOT verified' '$tmp/out'"
outbound_check "settings in another shape: NOT SHOWN, never a pass, and exit 4" 4 "^NOT SHOWN whether podster-content's deployed binding" content-settings 200 '{"success":true,"result":{"bindings":{}}}'

# --- custom domains ---
bad_api "a custom domain on the account that runs the outbound Worker is refused" "a custom domain on the account runs podster-outbound" domains 200 '{"success":true,"result":[{"id":"d","hostname":"x.content-selftest.example","service":"podster-outbound","zone_id":"z","zone_name":"content-selftest.example"}]}'
fresh; api domains 403 '{"success":false,"errors":[{"code":10000}]}'; dc 0 "${files[@]}" || true
check "custom domains the token can't read, in a report: NOT SHOWN, never 'every check passed', nothing deployed" bash -c "[ $LAST -eq 0 ] && grep -q '^NOT SHOWN whether a custom domain runs podster-outbound: the account.s custom domains couldn.t be read in the shape expected (HTTP 403)' '$tmp/out' && ! grep -q 'every check passed' '$tmp/out' && grep -q 'and 1 was NOT SHOWN (above). Nothing was deployed' '$tmp/out'"
check "  no deploy, no probe, the token nowhere" unchanged
outbound_check "custom domains the token can't read, after a deploy: NOT SHOWN, and exit 4" 4 "^NOT SHOWN whether a custom domain runs podster-outbound: the account's custom domains couldn't be read in the shape expected \\(HTTP 403\\)" domains 403 '{"success":false,"errors":[]}'
check "  never the success line" bash -c "! grep -q 'every probe passed' '$tmp/out' && grep -q 'the Workers are deployed and NOT verified' '$tmp/out'"
outbound_check "custom domains in another shape, after a deploy: NOT SHOWN, and exit 4" 4 "^NOT SHOWN whether a custom domain runs podster-outbound" domains 200 '{"success":true,"result":[{"id":"d"}]}'

probe_fails() { # probe_fails TITLE KEY STATUS BODY [EXTRA]
  fresh
  probe "$2" "$3" "$4" "${5:-}"
  at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
  check "$1: exit 4, deployed and NOT verified" bash -c "[ $LAST -eq 4 ] && grep -q 'the Workers are deployed and NOT verified' '$tmp/out'"
}
probe_fails "an unknown host answered by something else" probe-unknown 200 "<html>parked</html>"
check "  a wrong answer is never asked again: one request before the probes, no wait" bash -c "[ \$(grep -c '^probe GET https://<host>/ ' '$fix/calls') -eq 2 ] && ! grep -q '^sleep ' '$fix/calls' && grep -q 'FAIL    an unknown host: HTTP 200' '$tmp/out'"
probe_fails "an unknown host answered 404 with another body" probe-unknown 404 "<html>not here</html>"
check "  the 404 ends the wait, and the probe still fails on its body" bash -c "[ \$(grep -c '^probe GET https://<host>/ ' '$fix/calls') -eq 2 ] && ! grep -q '^sleep ' '$fix/calls' && grep -q 'FAIL    an unknown host: HTTP 404' '$tmp/out'"

# --- the wait for the route ---
# Lines read from a terminal end in a carriage return, so these patterns don't anchor at the end of a line.
fresh; printf '522\n522\n' > "$fix/probe-unknown.before"; at_terminal 0 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the route answering 522 twice, then the Worker's not-found: exit 0, every probe passed" bash -c "[ $LAST -eq 0 ] && grep -q 'and every probe passed' '$tmp/out'"
check "  it waited 2 s twice, saying so, and the third try ended the wait" bash -c "[ \$(grep -c '^sleep 2$' '$fix/calls') -eq 2 ] && [ \$(grep -c '^wait    the route isn.t answering yet (HTTP 522), trying again in 2 s' '$tmp/out') -eq 2 ] && grep -q '^ok      the route answers (HTTP 404, try 3)' '$tmp/out'"
check "  three requests waiting, then the five probes, all signed out, -q first" bash -c "[ \$(grep -c '^probe GET https://<host>/ header=none host_ok=yes q_first=yes env=none$' '$fix/calls') -eq 4 ] && [ \$(grep -c '^probe ' '$fix/calls') -eq 8 ]"
check "  the token is in no output" no_token
fresh; printf 'unreachable\n530\n' > "$fix/probe-unknown.before"; at_terminal 0 "$DOMAIN" -- "${files[@]}" --deploy || true
check "no answer, then 530, then the Worker's not-found: exit 0, after two waits" bash -c "[ $LAST -eq 0 ] && [ \$(grep -c '^sleep 2$' '$fix/calls') -eq 2 ] && grep -q 'HTTP 000), trying again' '$tmp/out' && grep -q 'HTTP 530), trying again' '$tmp/out'"
fresh; probe probe-unknown 522 "error code: 522"; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "a route that never answers: waits, stops at the clock's bound, then the probes anyway, and exit 4" bash -c "[ $LAST -eq 4 ] && grep -q '^sleep 2$' '$fix/calls' && grep -q '^wait    the route still isn.t answering after [0-9]* tries and [0-9]* s (HTTP 522): probing anyway' '$tmp/out' && grep -q 'FAIL    an unknown host: HTTP 522' '$tmp/out' && grep -q 'the Workers are deployed and NOT verified' '$tmp/out'"
check "  each try while waiting gave curl 5 s, and the probes their own 30 s" bash -c "n=\$(grep -c '^probe GET https://<host>/ ' '$fix/calls'); [ \$(grep -c '^max-time probe-unknown 5$' '$fix/calls') -eq \$((n - 1)) ] && [ \$(grep -c '^max-time probe-unknown 30$' '$fix/calls') -eq 1 ] && ! grep -q '^max-time probe-[a-z]* none$' '$fix/calls' && [ -z \"\$(grep '^max-time probe-' '$fix/calls' | grep -v -E '^max-time probe-[a-z]+ (5|30)$')\" ]"
# Every try slow: each uses its whole 5 s, so the clock, not a count of tries, ends the wait. At 5 s a try and 2 s a
# pause, a try may start only while it and its pause end within 30 s of the first: no more than 4. Then the first probe
# meets one more slow answer, given at most 5 s by the stand-in, and fails.
fresh; printf 'slow\nslow\nslow\nslow\nslow\nslow\nslow\nslow\n' > "$fix/probe-unknown.before"; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "every try slow: the wait ends by the clock, within 4 tries, then the probes anyway, and exit 4" bash -c "[ $LAST -eq 4 ] && t=\$(grep -o -E 'still isn.t answering after [0-9]+ tries' '$tmp/out' | grep -o -E '[0-9]+'); [ -n \"\$t\" ] && [ \"\$t\" -ge 1 ] && [ \"\$t\" -le 4 ] && [ \$(grep -c '^max-time probe-unknown 5$' '$fix/calls') -eq \"\$t\" ] && grep -q 'FAIL    an unknown host: HTTP 000' '$tmp/out'"
fresh; probe probe-unknown 503 "busy"; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "a 503, which isn't the route's 52x, is no reason to wait: exit 4 with no wait" bash -c "[ $LAST -eq 4 ] && ! grep -q '^sleep ' '$fix/calls' && [ \$(grep -c '^probe GET https://<host>/ ' '$fix/calls') -eq 2 ]"
probe_fails "plain HTTP not redirected" probe-http 200 hello
probe_fails "plain HTTP redirected elsewhere" probe-http 301 moved_to_https "location: https://elsewhere.example/"
probe_fails "a POST accepted" probe-post 200 ok
probe_fails "a service worker's script served" probe-sw 200 "self.addEventListener('fetch', () => {})"
probe_fails "the content domain itself serving a page" probe-apex 200 "<html>hello</html>"
fresh; probe probe-apex 404 not_found; at_terminal 0 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the content domain itself answering 404 passes" said "PASS    the content domain itself serves nothing: HTTP 404"
fresh; own_headers 404 | grep -v -i nosniff > "$fix/probe-unknown.headers"; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "the not-found without its nosniff header: exit 4, and the header named" bash -c "[ $LAST -eq 4 ] && grep -q 'missing or wrong: x-content-type-options' '$tmp/out'"
# content-probes that fails with no FAIL line, as when it stops part-way: never a pass.
printf '#!/usr/bin/env bash\necho "PASS    a stand-in probe"\nexit 1\n' > "$tmp/probes-standin"
PROBES_SEED="$tmp/probes-standin" fresh; at_terminal 4 "$DOMAIN" -- "${files[@]}" --deploy || true
check "content-probes exiting 1 with only PASS lines: exit 4, deployed and NOT verified" bash -c "[ $LAST -eq 4 ] && grep -q '^PASS    a stand-in probe' '$tmp/out' && grep -q '^FAIL    scripts/content-probes stopped with exit 1 before judging every probe' '$tmp/out' && grep -q 'but 1 probe(s) failed and 0 check(s) were NOT SHOWN (above): the Workers are deployed and NOT verified' '$tmp/out' && ! grep -q 'every probe passed' '$tmp/out'"

# --- stops, as Ctrl-C and a kill would make them ---
fresh; touch "$fix/gh-hangs"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/checking" -- "${files[@]}" --deploy || true
check "SIGINT while checking: exit 130, nothing deployed, and it says so" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT before anything was deployed. Nothing changed.' '$tmp/out'"
check "  nothing was deployed and nothing probed" unchanged
fresh; touch "$fix/deploy-hangs-podster-content"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGINT during wrangler deploy: exit 130, and it says the Worker may or may not be deployed" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT during wrangler deploy of the content Worker. podster-outbound is deployed; the content Worker may or may not be deployed' '$tmp/out'"
check "  no probe ran" never_called "^probe "
check "  the token is in no output" no_token
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"
fresh; touch "$fix/deploy-hangs-podster-content"; at_terminal 143 "$DOMAIN" --signal SIGTERM --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGTERM during wrangler deploy: exit 143, and it says so" bash -c "[ $LAST -eq 143 ] && grep -q 'STOPPED by SIGTERM during wrangler deploy of the content Worker' '$tmp/out'"
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"

fresh; touch "$fix/deploy-hangs-podster-content"; at_terminal 129 "$DOMAIN" --signal SIGHUP --when "$fix/deploying" -- "${files[@]}" --deploy || true
check "SIGHUP during wrangler deploy: exit 129, and it says so" bash -c "[ $LAST -eq 129 ] && grep -q 'STOPPED by SIGHUP during wrangler deploy of the content Worker. podster-outbound is deployed; the content Worker may or may not be deployed' '$tmp/out'"
check "  the script's own temporary folder is gone" bash -c "[ -s '$fix/work-dir' ] && [ ! -e \"\$(cat '$fix/work-dir')\" ]"
fresh; touch "$fix/probe-hangs"; at_terminal 130 "$DOMAIN" --signal SIGINT --when "$fix/probing" -- "${files[@]}" --deploy || true
check "SIGINT during the probes: exit 130, deployed and NOT verified" bash -c "[ $LAST -eq 130 ] && grep -q 'STOPPED by SIGINT during the probes. The Workers are deployed and NOT verified.' '$tmp/out'"
check "  it had deployed both Workers" bash -c "[ \$(grep -c '^wrangler deploy' '$fix/calls') -eq 2 ]"
check "  the token is in no output" no_token

finish deploy-content
