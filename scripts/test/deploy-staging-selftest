#!/usr/bin/env bash
# Checks every refusal of scripts/deploy-staging, in a scratch repository with stand-ins for npm, npx (wrangler),
# worker-build, rustc, gh and curl. Git is real and local. Nothing reaches the network or Cloudflare. One section gives the
# stand-in gh real JSON, captured into scripts/test/fixtures, and runs the script's own jq over it, so it needs `jq`.
#
#   scripts/test/deploy-staging-selftest
set -euo pipefail
. "$(dirname "$0")/lib.sh"
stub_curl
# A stand-in HOME, so the owner's ~/.podster/cloudflare-account-id.staging is never read.
export HOME="$tmp/home"
mkdir -p "$HOME/.podster"
account_file="$HOME/.podster/cloudflare-account-id.staging"

# $fix/main-ci holds what `gh run list ... --jq` would print. $fix/main-ci.json holds gh's JSON instead, and the
# --jq expression the script passed is run over it.
stub gh <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "gh $*" >> "$fix/calls"
case "$*" in
  "run list --workflow ci.yml --branch main --event push --commit "*" --limit 1 --json status,conclusion --jq "*)
    if [ -f "$fix/main-ci.json" ]; then
      for last in "$@"; do :; done
      jq -r "$last" "$fix/main-ci.json"
      exit
    fi
    [ "$(cat "$fix/main-ci")" = gh-fails ] && exit 1
    cat "$fix/main-ci"
    ;;
  *) echo "stand-in gh: unexpected: gh $*" >&2; exit 97 ;;
esac
EOF

# sleep, so a retry's wait is recorded and not slept.
stub sleep <<'EOF'
#!/usr/bin/env bash
echo "sleep $*" >> "$(dirname "$0")/../fix/calls"
EOF

stub worker-build <<'EOF'
#!/usr/bin/env bash
cat "$(dirname "$0")/../fix/worker-build-version"
EOF

# rustc, asked only where the Wasm target's libraries are: it names the folder in $fix/rustc-wasm-libs, there or not,
# as Homebrew's does. A first line "rustc-fails" fails instead.
stub rustc <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
[ "$*" = "--print target-libdir --target wasm32-unknown-unknown" ] || { echo "stand-in rustc: unexpected: rustc $*" >&2; exit 97; }
[ "$(cat "$fix/rustc-wasm-libs")" = rustc-fails ] && exit 1
cat "$fix/rustc-wasm-libs"
EOF

stub npm <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "npm $* [in $(basename "$PWD")] CI=${CI:-} CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-}" >> "$fix/calls"
if [ "$*" = "run build" ]; then
  [ -f "$fix/web-build-fails" ] && exit 1
  mkdir -p dist/server
  cat "$fix/web-config" > dist/server/wrangler.json
fi
EOF

# wrangler, as `npx wrangler ...`. A database's pending list is $fix/pending-<database> until a migration is applied
# to it, then $fix/pending-after-<database>.
# $fix/refuse-<list|apply|deploy>-<database or app> queues Cloudflare's refusals: each call takes the first line and
# fails with those codes, as wrangler prints them. A line "partial" also marks the migrations applied before refusing.
stub npx <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
app=$(basename "$PWD")
echo "npx $* [in $app] CI=${CI:-} account=${CLOUDFLARE_ACCOUNT_ID:-} CLOUDFLARE_ENV=${CLOUDFLARE_ENV:-}" >> "$fix/calls"
case "$2 $3" in
  "d1 migrations") queue="$fix/refuse-$4-$5" ;;
  "deploy "*) queue="$fix/refuse-deploy-$app" ;;
  *) queue="" ;;
esac
if [ -n "$queue" ] && [ -s "$queue" ]; then
  line=$(sed -n 1p "$queue")
  sed -i.bak 1d "$queue" && rm -f "$queue.bak"
  if [ "${line%% *}" = partial ]; then touch "$fix/applied-$5"; line=${line#partial }; fi
  echo "Uploading..."
  for code in $line; do
    case "$code" in
      7403) echo "✘ [ERROR] A request to the Cloudflare API (/accounts/x/d1/database/y/query) failed." >&2
            echo "  The given account is not valid or is not authorized to access this service [code: 7403]" >&2 ;;
      10021) echo "✘ [ERROR] A request to the Cloudflare API (/accounts/x/workers/scripts/y/versions) failed." >&2
             echo "  binding DB of type d1 failed to generate [code: 10021]" >&2 ;;
      *) echo "✘ [ERROR] Something else went wrong [code: $code]" >&2 ;;
    esac
  done
  exit 1
fi
case "$*" in
  "wrangler d1 migrations list "*" --remote --env staging")
    list="$fix/pending-$5"
    [ -f "$fix/applied-$5" ] && list="$fix/pending-after-$5"
    if [ "$(sed -n 1p "$list")" = wrangler-fails ]; then
      # The first line says to fail. The second is the exit status, and the rest goes to stderr.
      sed 1,2d "$list" >&2
      exit "$(sed -n 2p "$list")"
    fi
    cat "$list"
    ;;
  "wrangler d1 migrations apply "*" --remote --env staging")
    [ -f "$fix/apply-fails" ] && exit 1
    touch "$fix/applied-$5"
    echo "applied"
    ;;
  "wrangler deploy --env staging" | "wrangler deploy --config dist/server/wrangler.json")
    [ -f "$fix/deploy-fails-$app" ] && exit 1
    echo "Uploaded podster-$app-staging"
    cat "$fix/version-$app"
    ;;
  *) echo "stand-in wrangler: unexpected: $*" >&2; exit 97 ;;
esac
EOF

none="No migrations to apply!"
table() { # table NAME...: wrangler's list of pending migrations
  local name
  echo "Migrations to be applied:"
  echo "┌──────────────────────────┐"
  echo "│ Name                     │"
  for name in "$@"; do echo "├──────────────────────────┤"; echo "│ $name │"; done
  echo "└──────────────────────────┘"
}

account=0123456789abcdef0123456789abcdef
api_config() { # api_config VARS: an API configuration whose staging variables are these, with comments as the real file has
  printf '{\n  // the top level sets neither\n  "vars": {},\n  "env": {\n    // staging\n    "staging": { "vars": { "APP_URL": "https://app-staging.podster.dev"%s } }\n  }\n}\n' "${1:+, $1}"
}
# with_api_config VARS: main's tip now has that configuration, and the checkout is detached at it.
with_api_config() {
  api_config "$1" > "$tmp/seed/apps/api/wrangler.jsonc"
  git -C "$tmp/seed" add -A
  git -C "$tmp/seed" -c user.name=selftest -c user.email=selftest@example.invalid commit --quiet --allow-empty -m "api config"
  quiet git -C "$tmp/seed" push "$origin" main
  quiet git -C "$work" fetch origin && quiet git -C "$work" checkout --detach origin/main
}
origin="$tmp/origin.git"
work="$tmp/work"
quiet() { "$@" > /dev/null 2>&1; }
commit() { git -C "$1" -c user.name=selftest -c user.email=selftest@example.invalid commit --quiet -m "$2"; }

# A fresh origin and a checkout detached at its main, with a staging that has nothing pending and answers well.
fresh() {
  rm -rf "$origin" "$work" "$tmp/seed"
  rm -f "$fix"/*
  healthy_staging
  mkdir -p "$tmp/seed/scripts" "$tmp/seed/apps/api/migrations" "$tmp/seed/apps/gateway/migrations" "$tmp/seed/apps/web"
  cp "$scripts/deploy-staging" "$scripts/staging-probes" "$scripts/requesters-rule.mjs" "$tmp/seed/scripts/"
  # The API's configuration as staging has it: the switch on, and the list of who may ask beside it.
  api_config '"MANAGED_REPOSITORIES": "true", "REPOSITORY_REQUESTERS": "operators,test-people"' > "$tmp/seed/apps/api/wrangler.jsonc"
  echo "-- seven" > "$tmp/seed/apps/api/migrations/0007_repo_room_index.sql"
  echo "-- eight" > "$tmp/seed/apps/api/migrations/0008_next.sql"
  echo "-- five" > "$tmp/seed/apps/gateway/migrations/0005_org_departure.sql"
  echo "{}" > "$tmp/seed/apps/web/package.json"
  printf 'node_modules\ndist\n' > "$tmp/seed/.gitignore"
  quiet git -C "$tmp/seed" init -b main
  git -C "$tmp/seed" add -A
  commit "$tmp/seed" seed
  quiet git clone --bare "$tmp/seed" "$origin"
  quiet git clone "$origin" "$work"
  quiet git -C "$work" checkout --detach origin/main

  echo 0.8.7 > "$fix/worker-build-version"
  mkdir -p "$tmp/wasm-libs"
  echo "$tmp/wasm-libs" > "$fix/rustc-wasm-libs"
  echo "$none" > "$fix/pending-podster-api-staging"
  echo "$none" > "$fix/pending-podster-gateway-staging"
  echo "$none" > "$fix/pending-after-podster-api-staging"
  echo "$none" > "$fix/pending-after-podster-gateway-staging"
  echo "Current Version ID: 5cb57391-a010-4425-afb4-091fa2644f67" > "$fix/version-api"
  echo "Current Version ID: cd068ed1-3873-43c6-b066-be36c66c7eff" > "$fix/version-gateway"
  echo "Current Version ID: 11111111-2222-4333-8444-555555555555" > "$fix/version-web"
  printf 'completed\tsuccess\n' > "$fix/main-ci"
  # What the staging build wrote on 2026-11-10, less what the script doesn't read.
  web_config '.'
}
web_config() { # web_config JQ: the staging build's file, changed
  jq "$1" > "$fix/web-config" <<'JSON'
{
  "name": "podster-web-staging",
  "topLevelName": "podster-web",
  "workers_dev": false,
  "routes": [{ "pattern": "app-staging.podster.dev", "custom_domain": true }],
  "services": [
    { "binding": "GATEWAY", "service": "podster-gateway-staging" },
    { "binding": "PUBLIC_READS", "service": "podster-gateway-staging", "entrypoint": "PublicReads" }
  ],
  "vars": { "APP_URL": "https://app-staging.podster.dev", "GATEWAY_URL": "https://gateway-staging.podster.dev", "SIGN_IN_PROVIDERS": "github,email" }
}
JSON
}
deploy() { # deploy EXPECTED-EXIT [ARG...]
  local expected=$1
  shift
  CLOUDFLARE_ACCOUNT_ID=$account run "$expected" "$work/scripts/deploy-staging" "$@"
}
changed_staging='migrations apply|wrangler deploy'
refused() { # refused TITLE WHAT-IT-SAYS [ARG...]: the caller set the scene
  local title=$1 says=$2
  shift 2
  check "$title is refused, exit 1" deploy 1 "$@"
  check "  and says why" said "REFUSE .*$says"
  check "  and nothing was applied or deployed" never_called "$changed_staging"
  fresh
}
order() { grep -n -E -- "$1" "$fix/calls" | head -1 | cut -d: -f1; }
before() { [ "$(order "$1")" -lt "$(order "$2")" ]; }

# --- the plain deploy ---
fresh
check "main's tip, clean, with nothing pending, deploys: exit 0" deploy 0
check "  npm ci runs in the API and the gateway" test "$(grep -c -E '^npm ci \[in (api|gateway)\]' "$fix/calls")" -eq 2
check "  both databases are listed" test "$(grep -c 'migrations list' "$fix/calls")" -eq 2
check "  nothing is applied" never_called 'migrations apply'
check "  the API deploys before the gateway" before 'wrangler deploy --env staging \[in api\]' 'wrangler deploy --env staging \[in gateway\]'
check "  every wrangler call has CI=true and the account ID" test "$(grep -c '^npx ' "$fix/calls")" -eq "$(grep -c "^npx .* CI=true account=$account " "$fix/calls")"
check "  every wrangler call names staging" test "$(grep -c '^npx ' "$fix/calls")" -eq "$(grep -c '^npx .* --env staging \[' "$fix/calls")"
check "  the web app isn't built or deployed" never_called 'run build|\[in web\]'
check "  each Worker's version ID is recorded" said '^version podster-api-staging 5cb57391-a010-4425-afb4-091fa2644f67$'
check "  the gateway's too" said '^version podster-gateway-staging cd068ed1-3873-43c6-b066-be36c66c7eff$'
check "  the probes run after the deploys, one line each" test "$(grep -c '^PASS ' "$tmp/out")" -eq 4
check "  no secret or variable is set" never_called 'secret|--var|versions'
check "  main's CI was asked about, for the commit being deployed" called "^gh run list --workflow ci.yml --branch main --event push --commit $(git -C "$work" rev-parse HEAD) "
check "  before anything else ran" test "$(order '^gh run list')" -eq 1
fresh

# --- the checkout ---
check "with no account ID it is refused, exit 1" run 1 env -u CLOUDFLARE_ACCOUNT_ID "$work/scripts/deploy-staging"
check "  and nothing ran" test ! -s "$fix/calls"
check "  and the refusal names the account file" said "REFUSE  CLOUDFLARE_ACCOUNT_ID isn't set, and $account_file doesn't exist"
check "with an account ID that isn't one it is refused, exit 1" run 1 env CLOUDFLARE_ACCOUNT_ID=podster "$work/scripts/deploy-staging"
check "  and nothing ran" test ! -s "$fix/calls"

# --- the account file, read when CLOUDFLARE_ACCOUNT_ID isn't set ---
never_said() { ! said "$1"; }
other=ffffffffffffffffffffffffffffffff
printf '%s\n' "$other" > "$account_file" && chmod 600 "$account_file"
check "CLOUDFLARE_ACCOUNT_ID wins over the account file: exit 0" deploy 0
check "  every wrangler call has the variable's account" test "$(grep -c '^npx ' "$fix/calls")" -eq "$(grep -c "^npx .* account=$account " "$fix/calls")"
fresh
printf '%s\n' "$account" > "$account_file" && chmod 600 "$account_file"
check "with the variable unset, the account file is used: exit 0" run 0 env -u CLOUDFLARE_ACCOUNT_ID "$work/scripts/deploy-staging"
check "  every wrangler call has the file's account" test "$(grep -c '^npx ' "$fix/calls")" -eq "$(grep -c "^npx .* account=$account " "$fix/calls")"
check "  and the ID is never printed" never_said "$account"
fresh
printf '%s' "$account" > "$account_file" && chmod 600 "$account_file"
check "an account file with no newline is used: exit 0" run 0 env -u CLOUDFLARE_ACCOUNT_ID "$work/scripts/deploy-staging"
fresh
account_refused() { # account_refused TITLE WHAT-IT-SAYS: the caller wrote the account file
  check "$1 is refused, exit 1" run 1 env -u CLOUDFLARE_ACCOUNT_ID "$work/scripts/deploy-staging"
  check "  and says why" said "REFUSE  $account_file must $2"
  check "  before anything is installed or contacted" test ! -s "$fix/calls"
  check "  and its content isn't printed" never_said "$account|0123456789ABCDEF"
  fresh
}
chmod 644 "$account_file"
account_refused "an account file others can read" "be yours and mode 0600"
chmod 400 "$account_file"
account_refused "an account file of mode 0400" "be yours and mode 0600"
chmod 600 "$account_file"
for bad in "${account}\n\n" "${account} \n" "0123456789ABCDEF0123456789ABCDEF\n" "${account%?}\n" "${account}0\n" "\n${account}" ""; do
  printf "$bad" > "$account_file"
  account_refused "an account file holding '$bad'" "hold the account ID alone"
done
rm -f "$account_file" && ln -s "$tmp/target" "$account_file" && printf '%s\n' "$account" > "$tmp/target" && chmod 600 "$tmp/target"
account_refused "an account file that is a link" "be a regular file, not a link"
rm -f "$account_file" "$tmp/target"

check "with CLOUDFLARE_ENV naming another environment it is refused, exit 1" run 1 env CLOUDFLARE_ACCOUNT_ID=$account CLOUDFLARE_ENV=live "$work/scripts/deploy-staging"
check "  and nothing ran" test ! -s "$fix/calls"

echo 0.8.6 > "$fix/worker-build-version"
refused "another worker-build" 'worker-build is'
# Homebrew's rustc on 2026-11-13: it names the target's folder and exits 0, and the folder isn't there.
echo "$tmp/no-such-toolchain/lib/rustlib/wasm32-unknown-unknown/lib" > "$fix/rustc-wasm-libs"
check "a rustc without the Wasm target is refused, exit 1" deploy 1
check "  and says which rustc, and what to do" said "REFUSE  the rustc on PATH, '$bin/rustc', has no wasm32-unknown-unknown target.*rustup's rustc first on PATH.*rustup target add wasm32-unknown-unknown"
check "  before anything is installed or contacted" test ! -s "$fix/calls"
fresh
echo rustc-fails > "$fix/rustc-wasm-libs"
refused "a rustc that can't say where the target is" 'has no wasm32-unknown-unknown target'

quiet git -C "$work" checkout main
refused "a checkout on a branch, even at main's tip" 'is on branch main'

echo "-- nine" > "$tmp/seed/apps/api/migrations/0009_later.sql"
git -C "$tmp/seed" add -A && commit "$tmp/seed" later && quiet git -C "$tmp/seed" push "$origin" main
refused "a checkout behind origin/main, found by fetching" 'origin/main is at'

echo "-- local" > "$work/apps/api/migrations/0009_local.sql"
git -C "$work" add -A && commit "$work" local
refused "a checkout ahead of origin/main" 'origin/main is at'

echo scratch > "$work/pr-body.md"
refused "an untracked file" 'changed or untracked'

# --- managed repositories never go to staging switched on with nobody named to ask ---
with_api_config '"MANAGED_REPOSITORIES": "true"'
refused "the switch on with no list of requesters" 'switch MANAGED_REPOSITORIES on and set no REPOSITORY_REQUESTERS'
for bad in '""' '"operators,"' '"everyone"' '"operators,admins"' '["operators","test-people"]' '7' 'null' 'true'; do
  with_api_config "\"MANAGED_REPOSITORIES\": \"true\", \"REPOSITORY_REQUESTERS\": $bad"
  refused "the switch on with the list set to $bad" "REPOSITORY_REQUESTERS isn't a well-formed list"
done
printf '{ "env": { "staging": { "vars": { "MANAGED_REPOSITORIES": "true", } } }\n' > "$tmp/seed/apps/api/wrangler.jsonc"
git -C "$tmp/seed" add -A && commit "$tmp/seed" "broken config" && quiet git -C "$tmp/seed" push "$origin" main
quiet git -C "$work" fetch origin && quiet git -C "$work" checkout --detach origin/main
refused "a configuration that can't be read" "configuration can't be read"
git -C "$tmp/seed" rm --quiet apps/api/wrangler.jsonc && commit "$tmp/seed" "no config" && quiet git -C "$tmp/seed" push "$origin" main
quiet git -C "$work" fetch origin && quiet git -C "$work" checkout --detach origin/main
refused "no configuration file at all" "can't be read"
with_api_config '"MANAGED_REPOSITORIES": "true", "REPOSITORY_REQUESTERS": "operators,test-people"'
check "the switch on with a well-formed list deploys: exit 0" deploy 0
fresh
with_api_config '"MANAGED_REPOSITORIES": "true", "REPOSITORY_REQUESTERS": "per_owner1"'
check "the switch on with one person listed deploys: exit 0" deploy 0
fresh
with_api_config ''
check "the switch absent, and no list, deploys: exit 0" deploy 0
fresh
with_api_config '"MANAGED_REPOSITORIES": "false"'
check "the switch off, and no list, deploys: exit 0" deploy 0
fresh
with_api_config '"REPOSITORY_REQUESTERS": "nonsense"'
check "the switch absent, whatever the list says, deploys: exit 0" deploy 0
fresh
# The rule and the Rust that reads the list agree on every value in the fixture, which crates/policy's tests read too.
check "the rule reads every value in the grammar fixture as the fixture says" node --input-type=module -e '
  import { readFileSync } from "node:fs";
  const { validRequesters } = await import(process.argv[2]);
  const { valid, invalid } = JSON.parse(readFileSync(process.argv[1], "utf8"));
  const wrong = [...valid.filter((value) => !validRequesters(value)), ...invalid.filter((value) => validRequesters(value))];
  if (valid.length < 5 || invalid.length < 5 || wrong.length) { console.error(JSON.stringify(wrong)); process.exit(1); }
' "$scripts/test/fixtures/requesters-grammar.json" "$scripts/requesters-rule.mjs"
check "  and a value that isn't a string is never a list" node --input-type=module -e '
  const { validRequesters } = await import(process.argv[2]);
  if ([undefined, null, 7, true, ["operators"], { operators: true }].some((value) => validRequesters(value))) process.exit(1);
' values "$scripts/requesters-rule.mjs"

echo "-- edited" >> "$work/apps/api/migrations/0007_repo_room_index.sql"
refused "a changed file" 'changed or untracked'

git -C "$work" remote set-url origin "$tmp/nowhere.git"
refused "an origin that can't be fetched" 'could not fetch origin'

# --- main's CI for the commit ---
: > "$fix/main-ci"
refused "a tip with no ci.yml run on main" 'ci.yml has no run on main'

printf 'in_progress\tnone\n' > "$fix/main-ci"
refused "a tip whose ci.yml run is still going" 'is still in_progress'

printf 'queued\tnone\n' > "$fix/main-ci"
refused "a tip whose ci.yml run is queued" 'is still queued'

for conclusion in failure cancelled timed_out skipped; do
  printf 'completed\t%s\n' "$conclusion" > "$fix/main-ci"
  refused "a tip whose ci.yml run ended as $conclusion" "ended as $conclusion, not success"
done

echo gh-fails > "$fix/main-ci"
refused "a ci.yml run gh can't read" "could not read ci.yml's run on main"


# The same, from gh's real JSON for main's run on #252's merge commit, through the script's own jq.
check "the self-test has jq" test -x "$(command -v jq)"
cp "$scripts/test/fixtures/main-run.json" "$fix/main-ci.json"
check "the captured run, a success, lets it deploy: exit 0" deploy 0
fresh

jq '.[0].conclusion = "failure"' "$scripts/test/fixtures/main-run.json" > "$fix/main-ci.json"
refused "the captured run, had it failed" 'ended as failure, not success'

jq '.[0].status = "in_progress" | .[0].conclusion = null' "$scripts/test/fixtures/main-run.json" > "$fix/main-ci.json"
refused "the captured run, while it was going" 'is still in_progress'

echo '[]' > "$fix/main-ci.json"
refused "an empty list of runs" 'ci.yml has no run on main'

# --- migrations ---
table 0007_repo_room_index.sql > "$fix/pending-podster-api-staging"
refused "a pending migration that isn't named" 'migrations are pending: 0007_repo_room_index.sql'

table 0007_repo_room_index.sql > "$fix/pending-podster-api-staging"
refused "a pending migration, with another one named" 'must match exactly' --apply-migrations 0008_next.sql

table 0007_repo_room_index.sql > "$fix/pending-podster-api-staging"
refused "a pending migration, with it and one more named" 'must match exactly' --apply-migrations 0007_repo_room_index.sql 0008_next.sql

table 0007_repo_room_index.sql 0008_next.sql > "$fix/pending-podster-api-staging"
refused "two pending migrations, with one named" 'must match exactly' --apply-migrations 0007_repo_room_index.sql

table 0007_repo_room_index.sql > "$fix/pending-podster-api-staging"
table 0005_org_departure.sql > "$fix/pending-podster-gateway-staging"
refused "a pending migration on each database, with only the API's named" 'must match exactly' --apply-migrations 0007_repo_room_index.sql

refused "a named migration when none is pending" 'no migration is pending' --apply-migrations 0007_repo_room_index.sql

# A list that can't be read: refused like a pending migration, and told apart from one.
account_in_error=0123456789abcdef0123456789abcdef
token_in_error=cfut_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGh
unreadable() { # unreadable DATABASE STATUS: wrangler fails for that database, as it does when the network drops
  printf 'wrangler-fails\n%s\n✘ [ERROR] A request to the Cloudflare API (/accounts/%s/d1/database) failed.\n\n  fetch failed [code: 10000], with Authorization: Bearer %s\n' "$2" "$account_in_error" "$token_in_error" > "$fix/pending-$1"
}
unreadable podster-gateway-staging 1
refused "a list wrangler can't give" "could not read podster-gateway-staging's pending migrations, for the reason above"

unreadable podster-api-staging 7
check "a list wrangler can't give is refused with a non-zero status: exit 1" deploy 1
check "  it names the command that failed, and where" said '`npx wrangler d1 migrations list podster-api-staging --remote --env staging`, run in apps/api, exited with status 7\. Its stderr:'
check "  and passes on what wrangler said" said '^ +\| ✘ \[ERROR\] A request to the Cloudflare API \(/accounts/0123456789abcdef0123456789abcdef/d1/database\) failed\.$'
check "  with the account ID kept and anything long enough to be a credential masked" said '^ +\| +fetch failed \[code: 10000\], with Authorization: Bearer \[masked\]$'
check "  and the credential is nowhere in the output" test "$(grep -c "$token_in_error" "$tmp/out")" -eq 0
