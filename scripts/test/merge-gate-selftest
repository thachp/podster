check "  and it waited through UNKNOWN twice" test "$(grep -c '^sleep 6$' "$fix/calls")" -eq 2
check "  and CodeQL's NEUTRAL was accepted with no open alert" said 'ok +check CodeQL: NEUTRAL'
check "  and it read ci.yml on main" said 'ok +ci.yml on main has the jobs'
check "  and it found an analysis for each of the four languages" test "$(grep -c '^ok      code scanning analysed this head for ' "$tmp/out")" -eq 4
check "  and it didn't ask which files changed" never_called 'pulls/'
check "  and it never asked about main's alerts" never_called 'alerts\?ref=refs/heads|alerts\?state|alerts --'

refused() { # refused TITLE WHAT-IT-SAYS: the caller changed the fixtures; both the report and --merge must refuse
  local title=$1 says=$2
  check "$title: the report refuses, exit 1" run 1 "$gate" 77 "$sha"
  check "  and says why" said "REFUSE .*$says"
  rm -f "$fix"/*.n
  check "$title: --merge refuses, exit 1" run 1 "$gate" 77 "$sha" --merge
  check "  and merges and reruns nothing" never_called "$changes"
  healthy
}
# The same, for what stops it at once: one question to gh, no wait, and no word about the checks.
at_once() { # at_once TITLE WHAT-IT-SAYS
  local flag
  for flag in "" --merge --rerun-known-flake; do
    : > "$fix/calls"
    check "$1${flag:+, with $flag}: refused at once, exit 1" run 1 "$gate" 77 "$sha" $flag
    check "  and says why, once" test "$(grep -c -E "^REFUSE  $2" "$tmp/out")" -eq 1
    check "  after asking gh one thing, and waiting for nothing" test "$(wc -l < "$fix/calls" | tr -d ' ')" -eq 1
    check "  with nothing about checks, alerts or the merge state" test "$(grep -c -E 'head moved|check |alert|merge state' "$tmp/out")" -eq 0
  done
  healthy
}

