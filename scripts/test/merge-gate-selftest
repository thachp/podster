check "  and each of its 13 checks read as passing" test "$(grep -c '^ok      check .*: SUCCESS$' "$tmp/out")" -eq 13
check "  and its analyses counted at this head" said 'ok +code scanning analysed this head \(4 analyses\)'

real; still_open
check "the same pull request, open and CLEAN, passes: exit 0" run 0 "$gate" 252 "$real_head"

real; still_open
check "  and merges, then reads main's run from the JSON: exit 0" run 0 "$gate" 252 "$real_head" --merge
check "  for the captured merge commit" said "ci.yml on main for $real_merge: success"

real; still_open
edit analyses-head '[.[] | .commit_sha = "ffffffffffffffffffffffffffffffffffffffff"]'
check "analyses of an earlier head don't count: exit 1" run 1 "$gate" 252 "$real_head"
check "  and says so" said 'REFUSE .*no analysis of this head'

real; still_open
edit alerts-head '[{"number": 7, "state": "open"}]'
check "a JSON alert on the head ref is refused: exit 1" run 1 "$gate" 252 "$real_head"

real; still_open
edit alerts-merge '{"message": "Not Found"}'
check "an alert answer that isn't a list is refused: exit 1" run 1 "$gate" 252 "$real_head"

real; still_open
edit checks 'del(.statusCheckRollup[] | select(.workflowName == "CI"))'
check "the JSON with ci.yml's checks taken out is refused: exit 1" run 1 "$gate" 252 "$real_head"
check "  for all eight jobs" said 'refused, 8 problem'

real; still_open
edit checks '(.statusCheckRollup[] | select(.name == "web")) |= (.status = "IN_PROGRESS" | .conclusion = "")'
check "the JSON with web still running is refused: exit 1" run 1 "$gate" 252 "$real_head"
check "  and says so" said 'REFUSE +check web is IN_PROGRESS'

fail_web_step() { # the captured run, with one step of its web job failed
  edit pr-runs '.[0].conclusion = "failure"'
  edit jobs "(.jobs[] | select(.name == \"web\")) |= (.conclusion = \"failure\" | (.steps[] | select(.name == \"$1\")).conclusion = \"failure\")"
}
real; still_open; fail_web_step "Run node run-a11y.mjs --skip-web-build"
check "the captured run, with web's accessibility step failed, is rerun: exit 0" run 0 "$gate" 252 "$real_head" --rerun-known-flake
check "  by its real run id" called "^gh run rerun $(jq -r '.[0].databaseId' "$captured/pr-runs.json") --failed\$"

real; still_open; fail_web_step "Run npm test"
check "the captured run, with another web step failed, is not: exit 1" run 1 "$gate" 252 "$real_head" --rerun-known-flake
check "  and says which step" said 'not the accessibility run alone: Run npm test'

real; still_open
check "the captured run as it was, a success, is not rerun: exit 1" run 1 "$gate" 252 "$real_head" --rerun-known-flake
check "  and says why" said 'conclusion is success'

real; still_open; fail_web_step "Run node run-a11y.mjs --skip-web-build"
edit pr-runs '. + [.[0] | .databaseId = 1 | .attempt = 2]'
check "the captured run, with an earlier run of the same sha, is not: exit 1" run 1 "$gate" 252 "$real_head" --rerun-known-flake
check "  and nothing was rerun" never_called 'gh run rerun'

# --- what the script pins, and what it can't do at all ---
listed=$(sed -n 's/^CI_JOBS="\(.*\)"$/\1/p' "$gate")
in_workflow=$(awk '/^jobs:/ { jobs = 1; next } jobs && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { sub(/:.*/, ""); sub(/^  /, ""); printf "%s%s", sep, $0; sep = " " }' "$workflow")
check "the script's required jobs are exactly ci.yml's jobs" test -n "$listed" -a "$listed" = "$in_workflow"
check "  all eight of them" test "$(echo $listed | wc -w | tr -d ' ')" -eq 8
check "the web step it names is a step of ci.yml" grep -q -F -- "- run: $(sed -n 's/^WEB_FLAKE_STEP="Run \(.*\)"$/\1/p' "$gate")" "$workflow"
flake=$(sed -n 's/^API_FLAKE_TEST="test\/kernel.spec.ts > inbox > \(.*\)"$/\1/p' "$gate")
kernel="$scripts/../apps/api/test/kernel.spec.ts"
check "the alarm test it names is one test of kernel.spec.ts" test -n "$flake" -a "$(grep -c -F "  it(\"$flake\"," "$kernel")" -eq 1
check "  inside its inbox suite" test "$(awk '/^describe\(/ { suite = $0 } /the alarm follows whichever recipient is due first/ { print suite }' "$kernel")" = 'describe("inbox", () => {'
check "the script has no squash, rebase, admin or auto merge, branch update or alert change" \
  test "$(grep -c -E -- '--(squash|rebase|admin|auto)\b|update-branch|-X +(PATCH|POST|PUT|DELETE)|--method|-f state=' "$gate")" -eq 0
check "it merges in one place and reruns in one place" \
  test "$(grep -c -E '^ *gh (pr merge|run rerun) ' "$gate")" -eq 2

finish merge-gate
