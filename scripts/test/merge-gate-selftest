# --- gh's real JSON, through the script's own jq ---
# Captured read-only from #252 after it merged, so as captured it is MERGED with an UNKNOWN merge state.
real_head=$(jq -r .headRefOid "$captured/pull.json")
real_merge=$(jq -r .mergeCommit.oid "$captured/merged.json")
real() { # the captured answers, as they were
  healthy
  rm -f "$fix/pull" "$fix/checks" "$fix/merge-state" "$fix/merged" "$fix/main-run" "$fix/pr-runs" "$fix/jobs" "$fix/steps"
  rm -f "$fix/alerts-merge" "$fix/alerts-head" "$fix/analyses-merge" "$fix/analyses-head"
  local name
  for name in pull checks merge-state merged main-run pr-runs jobs; do cp "$captured/$name.json" "$fix/$name.json"; done
  cp "$captured/alerts.json" "$fix/alerts-merge.json"
  cp "$captured/alerts.json" "$fix/alerts-head.json"
  echo '[]' > "$fix/analyses-merge.json"
  cp "$captured/analyses.json" "$fix/analyses-head.json"
}
edit() { jq "$2" "$fix/$1.json" > "$fix/$1.new" && mv "$fix/$1.new" "$fix/$1.json"; } # edit KEY JQ
still_open() { edit pull '.state = "OPEN"'; edit merge-state '.mergeStateStatus = "CLEAN"'; }

