check "  and nothing was rerun" never_called 'gh run rerun'

# --- what the script pins, and what it can't do at all ---
listed=$(sed -n 's/^CI_JOBS="\(.*\)"$/\1/p' "$gate")
in_workflow=$(awk '/^jobs:/ { jobs = 1; next } jobs && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ { sub(/:.*/, ""); sub(/^  /, ""); printf "%s%s", sep, $0; sep = " " }' "$workflow")
check "the script's required jobs are exactly ci.yml's jobs" test -n "$listed" -a "$listed" = "$in_workflow"
check "  all eight of them" test "$(echo $listed | wc -w | tr -d ' ')" -eq 8
flake=$(sed -n 's/^API_FLAKE_TEST="test\/kernel.spec.ts > inbox > \(.*\)"$/\1/p' "$gate")
kernel="$scripts/../apps/api/test/kernel.spec.ts"
check "the alarm test it names is one test of kernel.spec.ts" test -n "$flake" -a "$(grep -c -F "  it(\"$flake\"," "$kernel")" -eq 1
check "  inside its inbox suite" test "$(awk '/^describe\(/ { suite = $0 } /the alarm follows whichever recipient is due first/ { print suite }' "$kernel")" = 'describe("inbox", () => {'
check "  and the script says to delete it once its cause is fixed" grep -q 'DELETE THIS, and the api case below, once the cause' "$gate"
check "the script has one flake allowance, and none for web" test "$(grep -c -E '^[A-Z_]*FLAKE[A-Z_]*=' "$gate")$(grep -c 'WEB_FLAKE' "$gate")" = 10
check "it never accepts an analysis of the merge ref" test "$(grep -c 'analyses?ref=refs/pull/$pr/merge' "$gate")" -eq 0
check "it names no language itself" test "$(grep -c -E 'Analyze \((actions|python|rust|javascript)' "$gate")" -eq 0
check "the script has no squash, rebase, admin or auto merge, branch update or alert change" \
  test "$(grep -c -E -- '--(squash|rebase|admin|auto)\b|update-branch|-X +(PATCH|POST|PUT|DELETE)|--method|-f state=' "$gate")" -eq 0
check "it merges in one place and reruns in one place" \
  test "$(grep -c -E '^ *gh (pr merge|run rerun) ' "$gate")" -eq 2

finish merge-gate
