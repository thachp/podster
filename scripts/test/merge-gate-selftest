check "  and says so" said 'REFUSE +it comes from a fork'
check "  and nothing is merged" never_called 'gh pr merge'

still_open; edit analyses '[.[] | .commit_sha = "ffffffffffffffffffffffffffffffffffffffff"]'
check "analyses of an earlier head don't count: exit 1" run 1 "$gate" 252 "$real_head"
check "  for any of the four languages" test "$(grep -c 'REFUSE  code scanning has no analysis of this head for ' "$tmp/out")" -eq 4

still_open; edit analyses '[.[] | select(.category != "/language:rust")]'
check "three of the four categories at this head is refused: exit 1" run 1 "$gate" 252 "$real_head"
check "  for the missing one alone" said 'refused, 1 problem'
