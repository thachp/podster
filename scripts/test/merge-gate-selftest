#!/usr/bin/env bash
# Checks every refusal of scripts/merge-gate, with a stand-in gh and no network. Most cases give the stand-in what
# `gh ... --jq` would print. The last section gives it gh's real JSON, captured read-only into scripts/test/fixtures
# (from merged pull request #252, docs pull request #243 and the repository's code scanning setup), and runs the
# script's own jq expressions over it, so it needs `jq`.
#
#   scripts/test/merge-gate-selftest
set -euo pipefail
. "$(dirname "$0")/lib.sh"
gate="$scripts/merge-gate"
captured="$scripts/test/fixtures"
workflow="$scripts/../.github/workflows/ci.yml"
sha=0123456789abcdef0123456789abcdef01234567
other=ffffffffffffffffffffffffffffffffffffffff
merged=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
t=$'\t'

stub sleep <<'EOF'
#!/usr/bin/env bash
echo "sleep $*" >> "$(dirname "$0")/../fix/calls"
EOF

# A fixture named KEY holds what gh would print after --jq. One named KEY.json holds gh's JSON, and the --jq
# expression the script passed is run over it.
stub gh <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "gh $*" >> "$fix/calls"
expression=
previous=
for arg in "$@"; do
  [ "$previous" = --jq ] && expression=$arg
  previous=$arg
done
json() { jq -r "$expression" "$fix/$1.json"; }
answer() { # the whole fixture
  if [ -f "$fix/$1.json" ]; then json "$1"; return; fi
  [ -f "$fix/$1" ] || { echo "stand-in gh: no fixture $1" >&2; exit 97; }
  [ "$(cat "$fix/$1")" = gh-fails ] && { echo "gh: HTTP 500" >&2; exit 1; }
  [ "$(cat "$fix/$1")" = gh-403 ] && { echo "gh: Resource not accessible by personal access token (HTTP 403)" >&2; exit 1; }
  cat "$fix/$1"
}
next() { # the fixture's next line each time, repeating its last
  if [ -f "$fix/$1.json" ]; then json "$1"; return; fi
  local n=0 total
  [ -f "$fix/$1.n" ] && n=$(cat "$fix/$1.n")
  n=$((n + 1))
  echo "$n" > "$fix/$1.n"
  total=$(wc -l < "$fix/$1" | tr -d ' ')
  [ "$n" -gt "$total" ] && n=$total
  sed -n "${n}p" "$fix/$1"
}
case "$*" in
  "pr view "*" --json state,isDraft,isCrossRepository,baseRefName,headRefName,headRefOid "*) answer pull ;;
  "pr view "*" --json headRefOid,statusCheckRollup "*) answer checks ;;
  "api repos/{owner}/{repo}/pulls/"*"/files?per_page=100 --paginate --jq "*) answer files ;;
  "api repos/{owner}/{repo}/pulls/"*" --jq .changed_files | tostring") answer changed ;;
  "pr view "*" --json mergeStateStatus "*) next merge-state ;;
  "pr view "*" --json state,mergeCommit "*) answer merged ;;
  "api repos/{owner}/{repo}/code-scanning/alerts?ref=refs/pull/"*"/merge&state=open "*) answer alerts-merge ;;
  "api repos/{owner}/{repo}/code-scanning/alerts?ref=refs/pull/"*"/head&state=open "*) answer alerts-head ;;
  "api repos/{owner}/{repo}/code-scanning/default-setup "*) answer languages ;;
  "api repos/{owner}/{repo}/code-scanning/analyses?ref=refs/pull/"*"/head&per_page=100 "*) answer analyses ;;
  "api repos/{owner}/{repo}/contents/.github/workflows/ci.yml?ref=main -H Accept: application/vnd.github.raw") answer workflow ;;
  "pr merge "*) answer merge-result ;;
  "run list --workflow ci.yml --branch main --event push --commit "*) next main-run ;;
  "run list --workflow ci.yml --commit "*" --event pull_request --limit 100 "*) answer pr-runs ;;
  "run view "*" --json jobs "*) answer jobs ;;
  "run view "*" --log-failed") answer log ;;
  "run rerun "*) answer rerun-result ;;
  *) echo "stand-in gh: unexpected: gh $*" >&2; exit 97 ;;
esac
EOF

jobs="rust migrations contracts api web scanner gateway e2e"
languages="actions javascript-typescript python rust"
set_check() { # set_check NAME STATUS CONCLUSION: changes every check of that name
  awk -F '\t' -v OFS='\t' -v name="$1" -v status="$2" -v conclusion="$3" '$1 == name { $2 = status; $3 = conclusion } { print }' "$fix/checks" > "$fix/checks.new"
  mv "$fix/checks.new" "$fix/checks"
}
drop_check() { awk -F '\t' -v name="$1" '$1 != name' "$fix/checks" > "$fix/checks.new"; mv "$fix/checks.new" "$fix/checks"; }
pull() { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" > "$fix/pull"; } # STATE DRAFT FORK BASE BRANCH HEAD
on_branch() { pull OPEN false false main "$1" "$sha"; }
skip_jobs() { local job; for job in $jobs; do set_check "$job" COMPLETED SKIPPED; done; }
changes() { # changes "STATUS PATH [OLD-PATH]"...: what the pull request changes
  local change
  echo "$#" > "$fix/changed"
  : > "$fix/files"
  for change in "$@"; do
    set -- $change
    printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >> "$fix/files"
  done
}
docs_branch() { # docs_branch FILE...: a docs/ branch, CI skipped, modifying those files
  on_branch docs/thing
  skip_jobs
  local path list=()
  for path in "$@"; do list+=("modified $path"); done
  changes "${list[@]}"
}
docs_changes() { on_branch docs/thing; skip_jobs; changes "$@"; } # the same, with each change spelled out
alarm="test/kernel.spec.ts > inbox > the alarm follows whichever recipient is due first, not the one waiting longest"
api_log() { # api_log FILES-FAILED TESTS-FAILED FAIL-LINE...
  local files=$1 tests=$2 line
  shift 2
  : > "$fix/log"
  for line in ${1+"$@"}; do printf 'api\tRun npm test\t2026-11-09T19:10:30.6977475Z  FAIL  %s\n' "$line" >> "$fix/log"; done
  printf 'api\tRun npm test\t2026-11-09T19:10:30.6989484Z  Test Files  %s failed | 18 passed (19)\n' "$files" >> "$fix/log"
  printf 'api\tRun npm test\t2026-11-09T19:10:30.6991018Z       Tests  %s failed | 813 passed (814)\n' "$tests" >> "$fix/log"
}

# A pull request the gate passes, whose merge then goes green on main, and a head run with the api flake.
healthy() {
  rm -f "$fix"/*
  : > "$fix/calls"
  on_branch feat/thing
  echo "$sha" > "$fix/checks"
  local name language
  for name in $jobs; do printf '%s\tCOMPLETED\tSUCCESS\n' "$name" >> "$fix/checks"; done
  : > "$fix/analyses"
  for language in $languages; do
    printf 'Analyze (%s)\tCOMPLETED\tSUCCESS\n' "$language" >> "$fix/checks"
    echo "/language:$language" >> "$fix/analyses"
  done
  printf 'CodeQL\tCOMPLETED\tNEUTRAL\n' >> "$fix/checks"
  printf '%s\n' $languages > "$fix/languages"
  echo 0 > "$fix/alerts-merge"
  echo 0 > "$fix/alerts-head"
  cp "$workflow" "$fix/workflow"
  printf 'UNKNOWN\nUNKNOWN\nCLEAN\n' > "$fix/merge-state"
  : > "$fix/merge-result"
  echo "$merged" > "$fix/merged"
  printf '\n900\tin_progress\tnone\thttps://github.invalid/runs/900\n900\tcompleted\tsuccess\thttps://github.invalid/runs/900\n' > "$fix/main-run"
  printf '555\tcompleted\tfailure\t1\n' > "$fix/pr-runs"
  echo api > "$fix/jobs"
  api_log 1 1 "$alarm"
  : > "$fix/rerun-result"
}
