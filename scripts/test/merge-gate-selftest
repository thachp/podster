refused "a pull request with no checks" 'no check has reported'

echo gh-fails > "$fix/checks"
refused "checks that can't be read" 'could not read the checks'

sed "1s/.*/$other/" "$fix/checks" > "$fix/checks.new" && mv "$fix/checks.new" "$fix/checks"
