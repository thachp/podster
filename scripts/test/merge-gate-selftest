check "  and says so" said 'REFUSE +could not read which languages'

still_open; edit alerts-head '[{"number": 7, "state": "open"}]'
check "a JSON alert on the head ref is refused: exit 1" run 1 "$gate" 252 "$real_head"

still_open; edit alerts-merge '{"message": "Not Found"}'
check "an alert answer that isn't a list is refused: exit 1" run 1 "$gate" 252 "$real_head"

still_open; edit checks 'del(.statusCheckRollup[] | select(.workflowName == "CI"))'
