  jq '.statusCheckRollup += [(.statusCheckRollup[] | select(.name == "scanner")) | (.name = "content"), (.name = "outbound"), (.name = "runner")]' "$fix/checks.json" > "$fix/checks.new" && mv "$fix/checks.new" "$fix/checks.json"
