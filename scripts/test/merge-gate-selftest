# --- gh's real JSON, through the script's own jq ---
# #252 was captured after it merged, so as captured it is MERGED with an UNKNOWN merge state.
real_head=$(jq -r .headRefOid "$captured/pull.json")
real_merge=$(jq -r .mergeCommit.oid "$captured/merged.json")
real() { # the captured answers, as they were
  healthy
  rm -f "$fix/pull" "$fix/checks" "$fix/merge-state" "$fix/merged" "$fix/main-run" "$fix/pr-runs" "$fix/jobs"
  rm -f "$fix/alerts-merge" "$fix/alerts-head" "$fix/analyses" "$fix/languages"
  local name
  for name in pull checks merge-state merged main-run pr-runs jobs analyses; do cp "$captured/$name.json" "$fix/$name.json"; done
  cp "$captured/alerts.json" "$fix/alerts-merge.json"
  cp "$captured/alerts.json" "$fix/alerts-head.json"
  cp "$captured/default-setup.json" "$fix/languages.json"
  cp "$captured/docs-files.json" "$fix/files.json"
  cp "$captured/docs-pull.json" "$fix/changed.json"
}
edit() { jq "$2" "$fix/$1.json" > "$fix/$1.new" && mv "$fix/$1.new" "$fix/$1.json"; } # edit KEY JQ
still_open() { real; edit pull '.state = "OPEN"'; edit merge-state '.mergeStateStatus = "CLEAN"'; }

check "the self-test has jq" test -x "$(command -v jq)"
real
check "#252 as captured, merged, is refused at once: exit 1" run 1 "$gate" 252 "$real_head"
check "  for being merged, and nothing else" said 'refused, 1 problem'
check "  with its branch and head read from the JSON" said "^pull request #252 from fix/m5-grants-followups at $real_head\$"
check "  after one question to gh" test "$(wc -l < "$fix/calls" | tr -d ' ')" -eq 1

still_open
check "the same pull request, open and CLEAN, passes: exit 0" run 0 "$gate" 252 "$real_head"
check "  with each of its 13 checks read as passing" test "$(grep -c '^ok      check .*: SUCCESS$' "$tmp/out")" -eq 13
check "  and four languages read from the setup's six names" test "$(grep -c '^ok      code scanning analysed this head for ' "$tmp/out")" -eq 4
check "  javascript-typescript among them, as one" said '^ok      code scanning analysed this head for javascript-typescript$'

still_open
check "  and it merges, then reads main's run from the JSON: exit 0" run 0 "$gate" 252 "$real_head" --merge
check "  for the captured merge commit" said "ci.yml on main for $real_merge: success"

still_open; edit pull '.isCrossRepository = true'
