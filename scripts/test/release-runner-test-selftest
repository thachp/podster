files="apps/runner/package.json apps/runner/package-lock.json apps/runner/npm-shrinkwrap.json"
g() { "$real_git" "$@"; }
gw() { g -C "$work" "$@"; }

# Sets every version field in the scratch work tree's three files with jq, as a fixture would want.
set_version() { # set_version VERSION [FILE]
  local file
  for file in ${2:-$files}; do
    jq --arg v "$1" '.version = $v | if .lockfileVersion then .packages[""].version = $v else . end' "$work/$file" > "$tmp/edit"
    cat "$tmp/edit" > "$work/$file"
  done
}
# main on origin at VERSION; the checkout under test detached at its tip, clean.
fresh() { # fresh VERSION
  rm -rf "$repo" "$origin" "$work"
  rm -f "$fix"/*
  : > "$fix/calls"
  g init --quiet --bare --initial-branch=main "$origin"
  g init --quiet --initial-branch=main "$work"
  mkdir -p "$work/apps/runner" "$work/scripts"
  local file
  for file in $files; do cp "$scripts/../$file" "$work/$file"; done
  cp "$scripts/release-runner-test" "$work/scripts/"
  set_version "$1"
  gw add -A && gw commit --quiet -m base && gw branch -M main
  gw remote add origin "$origin" && gw push --quiet origin main
  g clone --quiet "$origin" "$repo"
  g -C "$repo" checkout --quiet --detach origin/main
  # What all is well looks like: npm has up to 0.0.1-test.11, CI passed, nothing under way.
  printf '["0.0.0-stage","0.0.1-test.1","0.0.1-test.2","0.0.1-test.10","0.0.1-test.11"]\n' > "$fix/npm-versions"
  echo 0 > "$fix/prs"
  echo "https://github.invalid/pull/900" > "$fix/pr-create"
  printf 'completed\tsuccess\n' > "$fix/ci"
  : > "$fix/busy"
  echo "$env_id" > "$fix/env"
}
script() { echo "$repo/scripts/release-runner-test"; }
# main moves on origin: the given VERSION merged.
merge_version() { # merge_version VERSION
