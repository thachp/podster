#!/usr/bin/env bash
# Checks scripts/release-runner-test's refusals and both stages, with stand-ins for gh, npm and sleep, and no network.
# git is real: each case runs against a scratch repository whose origin is a bare repository beside it, holding this
# checkout's three Runner files, so the version edit is checked on their real layout. A git stand-in in front of it
# fails `git fetch` with a ref-lock error as many times as asked. Needs jq.
#
#   scripts/test/release-runner-test-selftest
set -euo pipefail
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage: scripts/test/release-runner-test-selftest

Checks scripts/release-runner-test's refusals and both stages, with stand-ins for gh, npm and sleep,
a scratch git repository and no network. Needs jq.
EOF
  exit 0
fi
. "$(dirname "$0")/lib.sh"
real_git=$(command -v git)
# No one's own git settings (signing, hooks, a default branch) reach the scratch repositories, and the script's commit
# has an identity on CI.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=selftest GIT_AUTHOR_EMAIL=selftest@example.invalid
export GIT_COMMITTER_NAME=selftest GIT_COMMITTER_EMAIL=selftest@example.invalid
