#!/usr/bin/env bash
echo "sleep $*" >> "$(dirname "$0")/../fix/calls"
EOF

# git, but a fetch fails on a ref lock while $fix/fetch-locks counts down, or with another error if $fix/fetch-error exists.
stub git <<EOF
#!/usr/bin/env bash
fix="\$(dirname "\$0")/../fix"
if [ "\${1:-}" = fetch ]; then
  echo "git \$*" >> "\$fix/calls"
  if [ -f "\$fix/fetch-error" ]; then echo "fatal: unable to access 'https://github.invalid/': Could not resolve host" >&2; exit 128; fi
  left=\$(cat "\$fix/fetch-locks" 2>/dev/null || echo 0)
  if [ "\$left" -gt 0 ]; then
    echo \$((left - 1)) > "\$fix/fetch-locks"
    echo "error: cannot lock ref 'refs/remotes/origin/main': is at 1111111111111111111111111111111111111111 but expected 2222222222222222222222222222222222222222" >&2
    exit 1
  fi
fi
case "\${1:-} \${2:-}" in "push "*) echo "git \$*" >> "\$fix/calls" ;; esac
exec "$real_git" "\$@"
EOF

# Each answer is a fixture file. KEY.1, KEY.2, ... are served in turn, the last repeating.
stub gh <<'EOF'
#!/usr/bin/env bash
fix="$(dirname "$0")/../fix"
echo "gh $*" >> "$fix/calls"
answer() {
  [ -f "$fix/$1" ] || { echo "stand-in gh: no fixture $1" >&2; exit 97; }
  [ "$(cat "$fix/$1")" = gh-fails ] && { echo "gh: HTTP 500" >&2; exit 1; }
  cat "$fix/$1"
}
turns() {
  local n=0
  [ -f "$fix/$1.n" ] && n=$(cat "$fix/$1.n")
  n=$((n + 1))
  echo "$n" > "$fix/$1.n"
  while [ "$n" -gt 1 ] && [ ! -f "$fix/$1.$n" ]; do n=$((n - 1)); done
  answer "$1.$n"
}
case "$*" in
  "pr list --head "*" --state all --json number --jq length") answer prs ;;
  "pr create --base main --head "*) answer pr-create ;;
  "run list --workflow ci.yml --branch main --event push --commit "*) answer ci ;;
  "run list --workflow runner-prerelease.yml --limit 20 --json databaseId,status "*)
    [ -f "$fix/move-main" ] && sh "$fix/move-main" > /dev/null 2>&1
    answer busy
    ;;
  "api repos/{owner}/{repo}/environments/npm-test-prerelease --jq .id | tostring") answer env ;;
  "run list --workflow runner-prerelease.yml --branch main --event workflow_dispatch --limit 20 "*) turns runs ;;
  "workflow run runner-prerelease.yml "*) answer dispatch ;;
  "api repos/{owner}/{repo}/actions/runs/"*"/pending_deployments --jq "*) turns pending ;;
  "api -X POST repos/{owner}/{repo}/actions/runs/"*"/pending_deployments "*) answer approve ;;
  "run view "*" --json status,conclusion --jq "*) answer early-state ;;
  "run view "*" --json status,conclusion,headSha --jq "*) turns state ;;
  "run view "*" --json jobs --jq "*) answer job ;;
  "run view "*" --log --job "*) answer log ;;
  *) echo "stand-in gh: unexpected: gh $*" >&2; exit 97 ;;
esac
EOF

