#!/usr/bin/env bash
# Checks that each staging probe can fail, with a stand-in curl and no network.
#
#   scripts/test/staging-probes-selftest
set -euo pipefail
. "$(dirname "$0")/lib.sh"
probes="$scripts/staging-probes"
stub_curl

healthy_staging
check "a healthy staging passes, exit 0" run 0 "$probes"
check "it prints one PASS line per probe" test "$(grep -c '^PASS ' "$tmp/out")" -eq 4
check "it makes exactly five requests" test "$(wc -l < "$fix/calls" | tr -d ' ')" -eq 5
check "every request goes to a staging host" test "$(grep -c -E ' https://(gateway|app)-staging\.podster\.dev/[^ ]*$' "$fix/calls")" -eq 5
check "no request carries a cookie or a credential" never_called 'cookie|authorization|--user|--location|--netrc| -[ubcLn] '
check "the public page is asked for as HTML" called 'Accept: text/html .*https://app-staging.podster.dev/p/pub_0000000000000000000000$'
a2a_call='-H Content-Type: application/json -H A2A-Version: 1\.0 --data-raw \{"jsonrpc":"2\.0","id":1,"method":"GetTask","params":\{"id":"tsk_0{32}"\}\}'
check "/a2a gets a well-formed A2A call" called "$a2a_call https://gateway-staging.podster.dev/a2a\$"
check "  and /a2a/ gets the same one" called "$a2a_call https://gateway-staging.podster.dev/a2a/\$"

refuses() { # refuses TITLE PROBE: the fixtures were changed by the caller
  check "$1, exit 1" run 1 "$probes"
  check "  and the $2 probe says FAIL" said "^FAIL $2: "
  healthy_staging
}

echo 200 > "$fix/me.status"
refuses "/api/v1/me answering 200 is refused" me

echo 404 > "$fix/a2a-slash.status"
refuses "/a2a and /a2a/ with different statuses are refused" a2a

echo '{"error":"not_found"}' > "$fix/a2a-slash.body"
refuses "/a2a and /a2a/ with the same challenge and different bodies are refused" a2a

echo '{"error":"unauthorized"}' > "$fix/a2a.body"; echo '{"error":"unauthorized"}' > "$fix/a2a-slash.body"
check "the same challenge with the same body, not empty, passes too" run 0 "$probes"
check "  and says what was compared" said '^PASS a2a: .*both answer 401 with the same WWW-Authenticate challenge, for this gateway.s A2A resource, and the same body$'
healthy_staging

no_challenge a2a; no_challenge a2a-slash
refuses "two bare 401s with no challenge and empty bodies are refused, though identical" a2a
no_challenge a2a; no_challenge a2a-slash
check "  and it says there is no challenge to compare" run 1 "$probes"
check "  in those words" said '^FAIL a2a: .*no WWW-Authenticate challenge'
healthy_staging

no_challenge a2a-slash
refuses "a challenge missing on /a2a/ is refused" a2a

no_challenge a2a
refuses "a challenge missing on /a2a is refused" a2a

a2a_challenge a2a-slash www-authenticate ""
refuses "an empty challenge on one path is refused" a2a

a2a_challenge a2a-slash www-authenticate 'Bearer realm="OAuth", resource_metadata="https://gateway-staging.podster.dev/.well-known/oauth-protected-resource/a2a", scope="mcp"'
refuses "challenges that differ in scope are refused" a2a
a2a_challenge a2a-slash www-authenticate "$A2A_CHALLENGE "
refuses "challenges that differ by a trailing space, which is not a line ending, are refused" a2a
healthy_staging
a2a_challenge a2a-slash www-authenticate "$A2A_CHALLENGE, error=\"invalid_token\""
refuses "challenges that differ by a suffix are refused" a2a

for elsewhere in \
  'Bearer realm="OAuth", resource_metadata="https://gateway.podster.dev/.well-known/oauth-protected-resource/a2a", scope="a2a"' \
  'Bearer realm="OAuth", resource_metadata="https://evil.example/.well-known/oauth-protected-resource/a2a", scope="a2a"' \
  'Bearer realm="OAuth", resource_metadata="https://gateway-staging.podster.dev.evil.example/.well-known/oauth-protected-resource/a2a", scope="a2a"' \
  'Bearer realm="OAuth", resource_metadata="https://gateway-staging.podster.dev/.well-known/oauth-protected-resource/mcp", scope="a2a"' \
  'Bearer realm="OAuth", resource_metadata="https://gateway-staging.podster.dev/.well-known/oauth-protected-resource/a2a/other", scope="a2a"' \
  'Bearer realm="OAuth", scope="a2a"' \
  'Basic realm="staging"'; do
  a2a_challenge a2a www-authenticate "$elsewhere"; a2a_challenge a2a-slash www-authenticate "$elsewhere"
  refuses "the same challenge on both paths, pointing elsewhere ($(printf '%s' "$elsewhere" | sed 's/.*resource_metadata="\([^"]*\)".*/\1/' | cut -c1-70)), is refused" a2a
done
a2a_challenge a2a www-authenticate 'Bearer realm="OAuth", resource_metadata="https://evil.example/.well-known/oauth-protected-resource/a2a"'
a2a_challenge a2a-slash www-authenticate 'Bearer realm="OAuth", resource_metadata="https://evil.example/.well-known/oauth-protected-resource/a2a"'
check "  and it says which resource it wanted" run 1 "$probes"
check "  by its full address" said "^FAIL a2a: .*doesn't have resource_metadata=\"https://gateway-staging.podster.dev/.well-known/oauth-protected-resource/a2a\"\$"
healthy_staging

echo unreachable > "$fix/a2a.status"; echo unreachable > "$fix/a2a-slash.status"
refuses "/a2a and /a2a/ both unreachable are refused, though identical" a2a

for status in 415 404 500 502 200 403; do
  echo "$status" > "$fix/a2a.status"; echo "$status" > "$fix/a2a-slash.status"
  refuses "/a2a and /a2a/ both answering $status, with the same challenge and body, are refused" a2a
done

echo 404 > "$fix/a2a-slash.status"
refuses "/a2a at 401 with /a2a/ not found is refused, though it carries the challenge" a2a

check "the probe no longer asks for a body" test "$(grep -c 'empty body' "$probes")" -eq 0
check "the challenge it wants is the gateway tests' own" grep -q -F 'expect(res.headers.get("www-authenticate")).toContain("/.well-known/oauth-protected-resource/a2a");' "$scripts/../apps/gateway/test/a2a.spec.ts"

for status in 500 202 401 400 403; do
  echo "$status" > "$fix/webhook.status"
  refuses "an unsigned webhook answered with $status is refused" webhook
done
check "the webhook's status is one named constant, with what to change beside it" \
  test "$(grep -c -E '^WEBHOOK_STATUS_WHILE_SECRET_UNSET=404$|CHANGE THIS TO 401 once the owner sets' "$probes")" -eq 2
gateway_tests="$scripts/../apps/gateway/test"
check "  and the gateway's tests pin that answer while no secret is set" grep -q -F 'expect([status, code]).toEqual([404, "not_found"]);' "$gateway_tests/github-webhook.spec.ts"
check "the A2A status is the gateway tests' answer with no credential" grep -q -F 'expect(res.status).toBe(401);' "$gateway_tests/a2a.spec.ts"

echo 200 > "$fix/public.status"
refuses "an unknown public page answering 200 is refused" public

printf 'HTTP/2 404\r\ncache-control: no-store\r\n\r\n' > "$fix/public.headers"
refuses "a public 404 without no-transform is refused" public

printf 'HTTP/2 404\r\ncontent-type: text/html\r\n\r\n' > "$fix/public.headers"
refuses "a public 404 with no Cache-Control is refused" public

echo '<!doctype html><SCRIPT src="/x.js"></SCRIPT>' > "$fix/public.body"
refuses "a public 404 with a script is refused" public

echo unreachable > "$fix/me.status"
refuses "a host nothing answers on is refused" me

check "an argument is refused, exit 2" run 2 "$probes" https://example.com
check "  and nothing was requested" test ! -s "$fix/calls"
check "--help exits 0" run 0 "$probes" --help
check "  and nothing was requested" test ! -s "$fix/calls"
check "the script names no host but the two staging ones" test "$(grep -o -E 'https?://[A-Za-z0-9.-]+' "$probes" | sort -u | tr '\n' ' ')" = "https://app-staging.podster.dev https://gateway-staging.podster.dev "

finish staging-probes
